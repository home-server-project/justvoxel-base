# JustVoxel Base package declaration.
# These packages form the common VM-ready JustVoxel appliance core.

# JustVoxel-specific requirements already provided by Home Server Base Stable.
# Keep these as product requirements, but do not request them from DNF again.
JUSTVOXEL_INHERITED_REQUIREMENTS="\
pam \
authselect \
libpwquality \
podman \
skopeo \
container-selinux \
ca-certificates \
python3 \
tar \
gzip \
less \
iproute \
util-linux \
xfsprogs"

# JustVoxel-specific requirements not provided by Home Server Base Stable.
# These remain owned and installed by JustVoxel Base.
JUSTVOXEL_COMMON_PACKAGES="\
just \
fzf \
gum \
btop \
iputils \
btrfs-progs \
ntfs-3g \
parted \
nfs-utils \
cifs-utils"
