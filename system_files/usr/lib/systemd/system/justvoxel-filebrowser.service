[Unit]
Description=JustVoxel File Browser
Wants=network-online.target
After=network-online.target local-fs.target

[Service]
Type=simple
RuntimeDirectory=justvoxel-filebrowser
RuntimeDirectoryMode=0755
ExecStart=/usr/libexec/justvoxel/management-agent filebrowser-run
ExecStop=-/usr/bin/podman stop --time 10 justvoxel-filebrowser
TimeoutStartSec=180
TimeoutStopSec=30
Restart=no

[Install]
WantedBy=multi-user.target
