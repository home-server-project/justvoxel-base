[Unit]
Description=JustVoxel WebUI
Documentation=https://github.com/home-server-project/justvoxel-webui
Requires=justvoxel-management.service
After=network-online.target justvoxel-management.service
Wants=network-online.target justvoxel-glances.service

[Service]
Type=simple
User=justvoxel-web
Group=justvoxel-web
UMask=0077
ExecStart=/usr/libexec/justvoxel/justvoxel-webui --listen 0.0.0.0:8099 --agent-socket /run/justvoxel/management.sock
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
