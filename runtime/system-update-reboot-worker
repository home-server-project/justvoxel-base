#!/usr/bin/bash
set -Eeuo pipefail

readonly shutdown_helper=/usr/libexec/justvoxel/mjust/instance-host-shutdown-prepare

readonly state_file="/run/justvoxel/system-update-reboot.json"
backup_minecraft="${JV_UPDATE_REBOOT_BACKUP:-no}"
warning_seconds="${JV_UPDATE_REBOOT_WARNING_SECONDS:-60}"
instances=''

write_state() {
    local state="$1" message="$2" deadline="${3:-0}" online="${4:-0}" reason="${5:-}"
    install -d -m0755 /run/justvoxel
    jq -cn         --arg state "${state}"         --arg message "${message}"         --arg reason "${reason}"         --argjson deadline "${deadline}"         --argjson online "${online}"         --argjson warning "${warning_seconds}"         --argjson backup "$([[ ${backup_minecraft} == yes ]] && echo true || echo false)"         '{ok:true,state:$state,accepted:true,confirmation_required:false,message:$message,reason:$reason,deadline_unix:$deadline,online:$online,warning_seconds:$warning,backup_minecraft:$backup}' > "${state_file}.tmp"
    mv -f "${state_file}.tmp" "${state_file}"
}

restore_instances() {
    "${shutdown_helper}" restore "${instances}" >&2 || true
}

recover_failure() {
    local rc=$?
    trap - EXIT
    restore_instances
    if (( rc != 0 )); then
        write_state failed 'System update reboot failed before reboot could be requested.' 0 0 action_failed || true
    fi
}

if [[ ${warning_seconds} != 60 && ${warning_seconds} != 10 ]]; then
    write_state failed 'Invalid reboot warning configuration.' 0 0 invalid_warning
    exit 2
fi

if ! instances="$("${shutdown_helper}" check)"; then
    write_state failed 'Could not confirm Minecraft instance/player status.' 0 0 player_status_unavailable
    exit 3
fi
# Pin the reviewed deployment and exclude automatic/manual staging until reboot.
install -d -m0755 /run/justvoxel
exec 8>/run/justvoxel/system-update.lock
if ! flock -n 8 || ! /usr/libexec/justvoxel/management-agent system-update-activate "${JV_UPDATE_REBOOT_DIGEST:-}"; then
    write_state failed 'The staged update could not be prepared. Reboot was cancelled. Refresh and try again.' 0 0 activation_failed
    exit 3
fi

online="$(jq '.online' <<<"${instances}")"
if (( online > 0 )); then
    deadline=$(( $(date +%s) + warning_seconds ))
    write_state countdown 'Minecraft players are online. Rebooting after the player warning.' "${deadline}" "${online}"
else
    write_state stopping 'No players are online. Stopping Minecraft now.' 0 0
fi
instances="$(jq -c '{instances:[.instances[] | {id,running}]}' <<<"${instances}")"

# Armed before the first stop; also covers unexpected failures and signals.
trap recover_failure EXIT
trap 'exit 4' HUP INT TERM
if ! "${shutdown_helper}" stop "${instances}" confirmed "${warning_seconds}"; then
    restore_instances
    trap - EXIT
    write_state failed 'Minecraft could not be stopped safely. Reboot was cancelled.' 0 "${online}" minecraft_stop_failed
    exit 4
fi

if [[ ${backup_minecraft} == yes ]]; then
    write_state backup 'Creating Minecraft backup before reboot.' 0 0
    mapfile -t instance_ids < <(jq -r '.instances[].id' <<<"${instances}")
    for id in "${instance_ids[@]}"; do
        if ! /usr/libexec/justvoxel/management-agent instance-version-backup "${id}"; then
            restore_instances
            trap - EXIT
            write_state backup_failed 'Minecraft backup failed. Reboot was cancelled. You can retry or reboot without backup.' 0 0 backup_failed
            exit 5
        fi
    done
fi

write_state rebooting 'Rebooting JustVoxel.' 0 0
if ! systemctl reboot; then
    restore_instances
    trap - EXIT
    write_state failed 'The host reboot request failed.' 0 0 reboot_failed
    exit 6
fi
trap - EXIT HUP INT TERM
