#!/usr/bin/bash
set -u

output_mode='shell'
if [[ ${1:-} == '--issue' ]]; then
    output_mode='issue'
elif (( $# > 0 )); then
    printf 'Usage: %s [--issue]\n' "$0" >&2
    exit 2
fi

pretty_name='JustVoxel'
if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    pretty_name="${PRETTY_NAME:-JustVoxel}"
fi

variant_id="$(cat /usr/lib/justvoxel/variant 2>/dev/null || true)"
case "${variant_id}" in
    justvoxel-vm|vm) variant='VM' ;;
    justvoxel-hwe|hwe) variant='HWE' ;;
    justvoxel-baremetal|baremetal) variant='Bare Metal' ;;
    *) variant='Unknown' ;;
esac

host="$(cat /proc/sys/kernel/hostname 2>/dev/null || true)"
host="${host%%.*}"
[[ -n ${host} ]] || host='unknown'

ipv4="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}')"
if [[ -z ${ipv4} ]]; then
    ipv4="$(ip -o -4 addr show scope global up 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')"
fi
[[ -n ${ipv4} ]] || ipv4='Not assigned'

network_state='No Ethernet interface detected'
mapfile -t ethernet_devices < <(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "ethernet" {print $1}')
if (( ${#ethernet_devices[@]} > 0 )); then
    ethernet_carrier=no
    ethernet_connecting=no
    ethernet_connected=no

    for device in "${ethernet_devices[@]}"; do
        carrier="$(nmcli -g GENERAL.CARRIER device show "${device}" 2>/dev/null || true)"
        state="$(nmcli -g GENERAL.STATE device show "${device}" 2>/dev/null || true)"
        state="${state%% *}"

        [[ ${carrier} == on ]] && ethernet_carrier=yes
        [[ ${state} == 100 ]] && ethernet_connected=yes
        if [[ ${state} =~ ^[0-9]+$ ]] && (( state >= 40 && state < 100 )); then
            ethernet_connecting=yes
        fi
    done

    if [[ ${ipv4} != 'Not assigned' || ${ethernet_connected} == yes ]]; then
        network_state='Ethernet connected'
    elif [[ ${ethernet_carrier} == yes || ${ethernet_connecting} == yes ]]; then
        network_state='Ethernet connected, obtaining address...'
    else
        network_state='Ethernet cable disconnected'
    fi
fi

if [[ -f /etc/containers/systemd/minecraft.container ]]; then
    minecraft_state='Configured'
    needs_setup=no
else
    minecraft_state='Not configured'
    needs_setup=yes
fi

web_state='Disabled'
web_browser=''
web_direct=''
web_enabled_marker=/var/lib/justvoxel/webui/enabled
web_initialized_marker=/var/lib/justvoxel/webui/initialized

if systemctl is-active --quiet justvoxel-webui.service 2>/dev/null && \
    curl -fsS --max-time 1 http://127.0.0.1:8099/healthz >/dev/null 2>&1; then
    web_state='Ready'
    if [[ ${host} != unknown ]]; then web_browser="http://${host}.local:8099"; else web_browser='Waiting for hostname'; fi
    if [[ ${ipv4} == 'Not assigned' ]]; then web_direct='Waiting for network address'; else web_direct="http://${ipv4}:8099"; fi
elif systemctl is-failed --quiet justvoxel-web-bootstrap.service 2>/dev/null; then
    web_state='Unavailable'
elif [[ -e ${web_enabled_marker} ]]; then
    web_state='Unavailable'
elif [[ ! -e ${web_initialized_marker} ]]; then
    web_state='Starting...'
fi

if [[ ${output_mode} == issue ]]; then
    # agetty translates \e into ESC, preserving the interactive 256-color palette.
    cyan='\e[38;5;45m'
    white='\e[97m'
    green='\e[38;5;82m'
    yellow='\e[38;5;220m'
    blue='\e[38;5;75m'
    dim='\e[38;5;245m'
    bold='\e[1m'
    reset='\e[0m'
elif [[ -t 1 && ${TERM:-dumb} != dumb ]]; then
    cyan=$'\033[38;5;45m'
    white=$'\033[97m'
    green=$'\033[38;5;82m'
    yellow=$'\033[38;5;220m'
    blue=$'\033[38;5;75m'
    dim=$'\033[38;5;245m'
    bold=$'\033[1m'
    reset=$'\033[0m'
else
    cyan='' white='' green='' yellow='' blue='' dim='' bold='' reset=''
fi

line() {
    printf '  %s%-18s%s %s%s%s\n' "${cyan}" "$1" "${reset}" "${2:-${white}}" "$3" "${reset}"
}

printf '%s%s====================================================%s\n' "${cyan}" "${bold}" "${reset}"
printf '%s%s                    JUSTVOXEL%s\n' "${cyan}" "${bold}" "${reset}"
printf '%s%s              Minecraft Server Appliance%s\n' "${cyan}" "${bold}" "${reset}"
printf '%s%s====================================================%s\n\n' "${cyan}" "${bold}" "${reset}"

line 'System:' "${white}" "${pretty_name}"
line 'Variant:' "${white}" "${variant}"
line 'Host:' "${white}" "${host}"
line 'Network:' "${white}" "${network_state}"
line 'IPv4:' "${white}" "${ipv4}"
line 'Minecraft:' "$([[ ${minecraft_state} == Configured ]] && printf '%s' "${green}" || printf '%s' "${yellow}")" "${minecraft_state}"
printf '\n'
line 'Web interface:' "$([[ ${web_state} == Ready ]] && printf '%s' "${green}" || printf '%s' "${yellow}")" "${web_state}"
case "${web_state}" in
    Ready)
        line 'Open in browser:' "${blue}" "${web_browser}"
        line 'Direct address:' "${blue}" "${web_direct}"
        ;;
    Disabled)
        line 'Enable with:' "${green}" 'mjust web enable'
        ;;
    Unavailable)
        line 'Check status:' "${green}" 'mjust web status'
        ;;
esac

if [[ ${output_mode} == issue ]]; then
    printf '\n'
    exit 0
fi

printf '\n%s%sCommon commands%s\n' "${bold}" "${cyan}" "${reset}"
if [[ ${needs_setup} == yes ]]; then
    line 'Normal setup:' "${green}" 'mjust setup'
    line 'Advanced setup:' "${green}" 'mjust setup-advanced'
fi
line 'Admin menu:' "${green}" 'mjust'
line 'Server status:' "${green}" 'mjust status'
line 'List commands:' "${green}" 'mjust --list'
line 'Validate system:' "${green}" 'mjust validate'

printf '\n%s%sLinks%s\n' "${bold}" "${cyan}" "${reset}"
line 'Documentation:' "${blue}" 'https://github.com/home-server-project/justvoxel'
line 'Report an issue:' "${blue}" 'https://github.com/home-server-project/justvoxel/issues'
line 'Hide this message:' "${dim}" 'mjust welcome-off'
