set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

default:
    @/usr/libexec/justvoxel/mjust/menu

setup:
    @sudo /usr/libexec/justvoxel/mjust/setup

configure:
    @sudo /usr/libexec/justvoxel/mjust/configure

configure-max-players:
    @sudo /usr/libexec/justvoxel/mjust/configure-max-players

status:
    @sudo /usr/libexec/justvoxel/mjust/status

start:
    @sudo /usr/libexec/justvoxel/mjust/service start

stop:
    @sudo /usr/libexec/justvoxel/mjust/service stop

restart:
    @sudo /usr/libexec/justvoxel/mjust/service restart

players:
    @sudo /usr/libexec/justvoxel/mjust/players

whitelist-list:
    @sudo /usr/libexec/justvoxel/mjust/whitelist list

whitelist-add-java name:
    @sudo /usr/libexec/justvoxel/mjust/whitelist add-java "{{name}}"

whitelist-remove-java name:
    @sudo /usr/libexec/justvoxel/mjust/whitelist remove-java "{{name}}"

whitelist-add-bedrock gamertag:
    @sudo /usr/libexec/justvoxel/mjust/whitelist add-bedrock "{{gamertag}}"

whitelist-remove-bedrock gamertag:
    @sudo /usr/libexec/justvoxel/mjust/whitelist remove-bedrock "{{gamertag}}"

backup:
    @sudo /usr/libexec/justvoxel/mjust/backup

restore:
    @sudo /usr/libexec/justvoxel/mjust/restore world

restore-full:
    @sudo /usr/libexec/justvoxel/mjust/restore full

export destination="":
    @if [ -n "{{destination}}" ]; then sudo /usr/libexec/justvoxel/mjust/migration-export "{{destination}}"; else sudo /usr/libexec/justvoxel/mjust/migration-export; fi

import source="":
    @if [ -n "{{source}}" ]; then sudo /usr/libexec/justvoxel/mjust/migration-import "{{source}}"; else sudo /usr/libexec/justvoxel/mjust/migration-import; fi

migration-recover transaction="":
    @if [ -n "{{transaction}}" ]; then sudo /usr/libexec/justvoxel/mjust/migration-recover "{{transaction}}"; else sudo /usr/libexec/justvoxel/mjust/migration-recover; fi

update-minecraft:
    @sudo /usr/libexec/justvoxel/mjust/update-minecraft

logs:
    @sudo /usr/libexec/justvoxel/mjust/logs

validate:
    @sudo /usr/libexec/justvoxel/mjust/validate

os-status:
    @sudo /usr/libexec/justvoxel/mjust/os-status

os-update:
    @sudo /usr/libexec/justvoxel/mjust/os-update

resources:
    @/usr/libexec/justvoxel/mjust/resources

reboot:
    @sudo /usr/libexec/justvoxel/mjust/system-power reboot

poweroff:
    @sudo /usr/libexec/justvoxel/mjust/system-power poweroff

firmware:
    @sudo /usr/libexec/justvoxel/mjust/firmware

web action="status":
    @sudo /usr/libexec/justvoxel/mjust/web "{{action}}"

password-reset:
    @sudo /usr/libexec/justvoxel/mjust/web password-reset

welcome:
    @/usr/libexec/justvoxel/mjust/welcome show

welcome-off:
    @/usr/libexec/justvoxel/mjust/welcome off

welcome-on:
    @/usr/libexec/justvoxel/mjust/welcome on

storage:
    @sudo /usr/libexec/justvoxel/mjust/storage-provision menu

storage-plan:
    @sudo /usr/libexec/justvoxel/mjust/storage-plan

storage-disk:
    @sudo /usr/libexec/justvoxel/mjust/storage-provision disk

storage-partition:
    @sudo /usr/libexec/justvoxel/mjust/storage-provision partition

storage-free-space:
    @sudo /usr/libexec/justvoxel/mjust/storage-provision free

storage-network:
    @sudo /usr/libexec/justvoxel/mjust/storage-provision network

storage-system:
    @sudo /usr/libexec/justvoxel/mjust/storage-provision system

storage-migrate:
    @sudo /usr/libexec/justvoxel/mjust/data-migration

start-over:
    @sudo /usr/libexec/justvoxel/mjust/start-over
