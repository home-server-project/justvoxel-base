#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/ui.sh

readonly api_client=/usr/libexec/justvoxel/mjust/api-client

if (( $# > 0 )); then
    echo 'Usage: logs' >&2
    exit 2
fi

if (( EUID != 0 )); then
    echo 'ERROR: this operation must run as root.' >&2
    exit 1
fi

set +e
response="$("${api_client}" GET '/v1/logs/minecraft?limit=100&format=cat')"
rc=$?
set -e

if (( rc != 0 )); then
    if jq -e 'type == "object" and (.error | type == "string")' <<<"${response}" >/dev/null 2>&1; then
        printf 'ERROR: %s\n' "$(jq -r '.error' <<<"${response}")" >&2
    else
        echo 'ERROR: Minecraft logs are unavailable from the JustVoxel Management API.' >&2
    fi
    exit 1
fi

if ! jq -e 'type == "object" and (.lines | type == "array")' <<<"${response}" >/dev/null 2>&1; then
    echo 'ERROR: JustVoxel Management API returned invalid Minecraft logs.' >&2
    exit 1
fi

title='Minecraft logs'
if jui_has_tty; then
    printf '%s\n' "${title}"
    printf '%*s\n' "${#title}" '' | tr ' ' '-'
    echo 'Showing the latest 100 log lines.'
    echo 'Press q or Esc to return to JustVoxel.'
    echo
fi

jq -r '.lines[]' <<<"${response}"

if ! jui_has_tty; then
    exit 0
fi

while true; do
    key=''
    IFS= read -rsn1 key </dev/tty || break
    case "${key}" in
        q|Q|$'\e') break ;;
    esac
done
