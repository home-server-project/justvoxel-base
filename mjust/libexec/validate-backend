#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
require_root
require_config

failures=0
warnings=0
pass() { echo "OK: $*"; }
warn() { echo "WARN: $*" >&2; warnings=$((warnings + 1)); }
fail() { echo "FAIL: $*" >&2; failures=$((failures + 1)); }

check_file() {
    local path="$1" mode="$2" actual
    if [[ -f ${path} ]]; then
        actual="$(stat -c '%a %U %G' "${path}")"
        if [[ ${actual} == "${mode} root root" ]]; then
            pass "${path} permissions ${actual}"
        else
            fail "${path} permissions are ${actual}; expected ${mode} root root"
        fi
    else
        fail "missing ${path}"
    fi
}

check_file "${JV_CONFIG}" 600
check_file "${JV_MC_ENV}" 600
check_file "${JV_BACKUP_ENV}" 600
check_file "${JV_QUADLET}" 644
check_file "${JV_BACKUP_SERVICE}" 644
check_file "${JV_BACKUP_TIMER}" 644

failed_units="$(systemctl --failed --no-legend --plain 2>/dev/null || true)"
if [[ -z ${failed_units} ]]; then
    pass 'Failed system services: none'
else
    fail 'one or more systemd units are failed'
    echo "${failed_units}" >&2
fi

# JustVoxel ships zram-generator's default min(RAM/2, 4096 MiB) policy, but
# administrators may intentionally disable or tune zram. Treat drift from the
# appliance default as advisory rather than an appliance-health failure.
mem_kib="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
expected_zram_bytes=$((mem_kib * 1024 / 2))
zram_cap_bytes=$((4096 * 1024 * 1024))
if (( expected_zram_bytes > zram_cap_bytes )); then
    expected_zram_bytes=${zram_cap_bytes}
fi
zram_tolerance_bytes=$((expected_zram_bytes / 100))
(( zram_tolerance_bytes < 1024 * 1024 )) && zram_tolerance_bytes=$((1024 * 1024))

if [[ -r /sys/block/zram0/disksize ]]; then
    actual_zram_bytes="$(cat /sys/block/zram0/disksize)"
    delta=$((actual_zram_bytes - expected_zram_bytes))
    (( delta < 0 )) && delta=$((-delta))
    if (( delta <= zram_tolerance_bytes )); then
        pass "zram0 size follows the default min(RAM/2, 4096 MiB) policy closely: $((actual_zram_bytes / 1024 / 1024)) MiB"
    else
        warn "zram0 size is ${actual_zram_bytes} bytes; JustVoxel default is approximately ${expected_zram_bytes} bytes"
    fi
else
    warn '/dev/zram0 is not available; the JustVoxel default zram policy is disabled or unavailable'
fi

active_swaps="$(swapon --show=NAME --noheadings 2>/dev/null | awk '{$1=$1; print}' || true)"
if grep -Fxq '/dev/zram0' <<< "${active_swaps}"; then
    pass 'zram0 is active as swap'
else
    warn 'zram0 is not active as swap; this is allowed when the administrator intentionally changes swap policy'
fi

extra_swaps="$(grep -Fvx '/dev/zram0' <<< "${active_swaps}" | sed '/^$/d' || true)"
if [[ -z ${extra_swaps} ]]; then
    pass 'No disk or swap-file device is active by default'
else
    echo 'INFO: additional swap is active; this is not part of the JustVoxel default policy:'
    echo "${extra_swaps}"
fi

if [[ -L ${JV_QUADLET} || -L ${JV_MC_ENV} || -L ${JV_BACKUP_ENV} ]]; then
    fail 'active runtime files must be local administrator-owned copies, not symlinks into the immutable image'
else
    pass 'active runtime files are local copies under /etc'
fi

expected_image="$(minecraft_image_ref)"
if grep -Fqx "Image=${expected_image}" "${JV_QUADLET}" 2>/dev/null; then
    pass "Minecraft container image policy is rendered as ${expected_image}"
else
    fail "Quadlet does not contain configured image ${expected_image}"
fi

case "${MINECRAFT_VERSION_MODE}" in
    pinned)
        if [[ ${MINECRAFT_VERSION} == LATEST ]] || grep -Fq 'VERSION=LATEST' "${JV_MC_ENV}" 2>/dev/null; then
            fail 'Minecraft version policy says pinned but runtime uses LATEST'
        else
            pass "Minecraft game version is pinned to ${MINECRAFT_VERSION}"
        fi
        ;;
    latest)
        if [[ ${MINECRAFT_VERSION} == LATEST ]] && grep -Fqx 'VERSION=LATEST' "${JV_MC_ENV}" 2>/dev/null; then
            pass 'Minecraft game version intentionally follows the LATEST release channel'
        else
            fail 'Minecraft version policy says latest but runtime is not VERSION=LATEST'
        fi
        ;;
    *)
        fail "unknown Minecraft version policy: ${MINECRAFT_VERSION_MODE}"
        ;;
esac

if grep -Eq '(^|[=:])25575([/:]|$)|podman\.sock' "${JV_QUADLET}" 2>/dev/null; then
    fail 'Quadlet exposes RCON or Podman socket access'
else
    pass 'Quadlet does not publish RCON or mount the Podman socket'
fi

if [[ -n ${DATA_MOUNT_POINT:-} ]]; then
    if /usr/libexec/justvoxel/mjust/validate-data-mount; then
        pass "Minecraft data mount identity is valid: ${DATA_MOUNT_POINT}"
    else
        fail "Minecraft data mount validation failed: ${DATA_MOUNT_POINT}"
    fi
fi

if [[ -d ${DATA_PATH} ]]; then
    pass "Minecraft data directory exists: ${DATA_PATH}"
    data_context="$(ls -Zd "${DATA_PATH}" 2>/dev/null || true)"
    if grep -q 'container_file_t' <<< "${data_context}"; then
        pass 'Minecraft data has container_file_t SELinux labeling'
    else
        fail "Minecraft data is not labeled container_file_t: ${data_context:-unknown}"
    fi
else
    fail "Minecraft data directory is missing: ${DATA_PATH}"
fi

if [[ -n ${BACKUP_MOUNT_POINT} ]]; then
    if mountpoint -q -- "${BACKUP_MOUNT_POINT}"; then
        pass "backup mount is present: ${BACKUP_MOUNT_POINT}"
    else
        fail "backup mount is missing: ${BACKUP_MOUNT_POINT}"
    fi
    if [[ -n ${BACKUP_EXPECTED_UUID} ]]; then
        actual_uuid="$(findmnt -n -o UUID --target "${BACKUP_MOUNT_POINT}" 2>/dev/null || true)"
        [[ ${actual_uuid} == "${BACKUP_EXPECTED_UUID}" ]] && pass 'backup filesystem UUID matches' || fail 'backup filesystem UUID does not match configuration'
    fi
    if [[ -n ${BACKUP_EXPECTED_SOURCE} ]]; then
        actual_source="$(findmnt -n -o SOURCE --target "${BACKUP_MOUNT_POINT}" 2>/dev/null || true)"
        [[ ${actual_source} == "${BACKUP_EXPECTED_SOURCE}" ]] && pass 'backup mount source matches' || fail 'backup mount source does not match configuration'
    fi
fi

if [[ -d ${BACKUP_PATH} && -w ${BACKUP_PATH} ]]; then
    pass "backup path is present and writable: ${BACKUP_PATH}"
else
    fail "backup path is missing or not writable: ${BACKUP_PATH}"
fi

if firewall-cmd --permanent --query-port="${JAVA_PORT}/tcp" >/dev/null 2>&1; then
    pass "firewall allows Java ${JAVA_PORT}/tcp"
else
    fail "firewall does not allow Java ${JAVA_PORT}/tcp"
fi
if [[ ${BEDROCK_ENABLED} == yes ]]; then
    if firewall-cmd --permanent --query-port="${BEDROCK_PORT}/udp" >/dev/null 2>&1; then
        pass "firewall allows Bedrock ${BEDROCK_PORT}/udp"
    else
        fail "firewall does not allow Bedrock ${BEDROCK_PORT}/udp"
    fi
fi

if systemctl cat minecraft.service >/dev/null 2>&1; then
    pass 'minecraft.service is generated from the local Quadlet'
else
    fail 'minecraft.service was not generated'
fi

if [[ ${BACKUP_TIMER_ENABLED} == yes ]]; then
    if [[ $(systemctl is-enabled minecraft-backup.timer 2>/dev/null || true) == enabled ]]; then
        pass 'Minecraft backup timer is enabled'
    else
        fail 'Minecraft backup timer should be enabled but is not'
    fi
else
    pass 'Minecraft backup timer is intentionally disabled'
fi

if systemctl is-active --quiet minecraft.service; then
    pass 'minecraft.service is active'
    if players="$(podman exec minecraft rcon-cli 'list' 2>/dev/null)"; then
        pass "RCON responded: ${players}"
    else
        fail 'RCON did not respond'
    fi
    if version="$(podman exec minecraft rcon-cli 'version' 2>/dev/null)"; then
        pass "Minecraft reports: ${version}"
    else
        fail 'Minecraft version query failed'
    fi
    if [[ ${BEDROCK_ENABLED} == yes ]]; then
        if geyser="$(podman exec minecraft rcon-cli 'geyser version' 2>/dev/null)"; then
            pass "Geyser reports: ${geyser}"
        else
            fail 'Geyser version query failed'
        fi
        geyser_config="${DATA_PATH}/plugins/Geyser-Spigot/config.yml"
        if grep -Eq '^[[:space:]]*auth-type:[[:space:]]*floodgate[[:space:]]*$' "${geyser_config}" 2>/dev/null; then
            pass 'Geyser auth-type is floodgate'
        else
            fail 'Geyser auth-type is not confirmed as floodgate'
        fi
    fi
else
    fail 'minecraft.service is not active'
fi

echo
/usr/libexec/justvoxel/mjust/storage-summary || fail 'storage summary could not be generated'

if (( failures > 0 )); then
    echo
    echo "JustVoxel validation failed with ${failures} problem(s)." >&2
    exit 1
fi

echo
if (( warnings > 0 )); then
    echo "JustVoxel validation passed with ${warnings} warning(s)."
else
    echo 'JustVoxel validation passed.'
fi
