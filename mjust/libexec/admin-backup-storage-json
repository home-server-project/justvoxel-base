#!/usr/bin/bash
set -uo pipefail

source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/storage-common-base.sh
source /usr/libexec/justvoxel/mjust/storage-lifecycle.sh
set +e
set -uo pipefail
require_root

readonly A31_FSTAB=/etc/fstab
readonly A31_SMB_CREDENTIALS=/etc/justvoxel/smb-backup.credentials

source /usr/libexec/justvoxel/mjust/admin-backup-storage-common.sh
source /usr/libexec/justvoxel/mjust/admin-backup-storage-apply.sh

action="${1:-status}"

case "${action}" in
    status) current_status_json ;;
    plan) plan_json ;;
    apply) apply_json ;;
    *) json_error 'Usage: admin-backup-storage-json {status|plan|apply}' ;;
esac
