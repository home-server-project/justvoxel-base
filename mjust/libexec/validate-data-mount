#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
require_config

[[ -n ${DATA_MOUNT_POINT:-} ]] || exit 0

if ! mountpoint -q -- "${DATA_MOUNT_POINT}"; then
    echo "ERROR: configured Minecraft data mount is not mounted: ${DATA_MOUNT_POINT}" >&2
    exit 1
fi

case "${DATA_PATH}/" in
    "${DATA_MOUNT_POINT}/"*) ;;
    *) echo 'ERROR: Minecraft data path is outside configured data mount.' >&2; exit 1 ;;
esac

if [[ -n ${DATA_EXPECTED_UUID:-} ]]; then
    actual_uuid="$(jv_exact_mount_identity UUID "${DATA_MOUNT_POINT}" 2>/dev/null || true)"
    [[ ${actual_uuid} == "${DATA_EXPECTED_UUID}" ]] || {
        echo 'ERROR: Minecraft data filesystem UUID does not match configuration.' >&2
        exit 1
    }
fi

if [[ -n ${DATA_EXPECTED_SOURCE:-} ]]; then
    actual_source="$(jv_exact_mount_identity SOURCE "${DATA_MOUNT_POINT}" 2>/dev/null || true)"
    [[ ${actual_source} == "${DATA_EXPECTED_SOURCE}" ]] || {
        echo 'ERROR: Minecraft data mount source does not match configuration.' >&2
        exit 1
    }
fi
