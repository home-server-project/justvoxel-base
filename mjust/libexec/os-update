#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/system-update-api.sh
require_root

echo 'Updating JustVoxel OS...'
response="$(jv_system_update_apply)"
if ! jq -e 'type == "object" and (.ok == true) and (.running | type == "object") and (.reboot_required | type == "boolean")' <<<"${response}" >/dev/null 2>&1; then
    echo 'ERROR: JustVoxel Management API returned invalid system update information.' >&2
    exit 1
fi

message="$(jq -r '.message // empty' <<<"${response}")"
[[ -n ${message} ]] && echo "${message}"

if [[ $(jq -r '.reboot_required' <<<"${response}") == true ]]; then
    staged_version="$(jq -r '.staged.version // empty' <<<"${response}")"
    staged_digest="$(jq -r '.staged.digest // empty' <<<"${response}")"
    [[ -n ${staged_version} ]] && echo "Staged version: ${staged_version}"
    [[ -n ${staged_digest} ]] && echo "Staged digest:  ${staged_digest}"
    echo 'Minecraft continues running normally.'
    echo 'The staged OS deployment will be used after the next reboot.'
fi
