#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/minecraft-reset-common.sh
source /usr/libexec/justvoxel/mjust/ui.sh
require_root
require_config

timestamp="$(date +%Y%m%d-%H%M%S)"
data_path="${DATA_PATH}"
backup_path="${BACKUP_PATH}"
java_port="${JAVA_PORT}"
bedrock_enabled="${BEDROCK_ENABLED}"
bedrock_port="${BEDROCK_PORT}"
config_backup=''
container_action='none'
preserved_container=''
keep_dropin=/run/systemd/system/minecraft.service.d/justvoxel-keep-container.conf

echo 'Start over'
echo
echo 'This removes the active JustVoxel Minecraft configuration and returns'
echo 'the appliance to first-setup mode.'
echo
echo 'Minecraft world/data will NOT be deleted.'
echo
echo "Current Minecraft data: ${data_path}"
echo "Current backups:        ${backup_path}"
echo

backup_choice="$(jui_choose 'Configuration backup' \
    'Save a backup of the current JustVoxel configuration (recommended)' \
    'Continue without a configuration backup' \
    'Cancel')" || exit 0
case "${backup_choice}" in
    'Save a backup of the current JustVoxel configuration (recommended)') save_config=yes ;;
    'Continue without a configuration backup') save_config=no ;;
    *) echo 'Start over cancelled.'; exit 0 ;;
esac

if podman container exists minecraft 2>/dev/null; then
    container_choice="$(jui_choose 'Existing Minecraft container' \
        'Remove the old Minecraft container (recommended)' \
        'Keep the old container stopped' \
        'Cancel')" || exit 0
    case "${container_choice}" in
        'Remove the old Minecraft container (recommended)') container_action=remove ;;
        'Keep the old container stopped') container_action=keep ;;
        *) echo 'Start over cancelled.'; exit 0 ;;
    esac
fi

echo
echo 'The Minecraft world/data and existing backup archives will be preserved.'
echo 'Storage partitions, mounts and /etc/fstab entries will not be changed.'
echo 'Podman images and unrelated containers will not be removed.'
echo
echo 'Type exactly: START OVER'
read -r -p '> ' confirmation
[[ ${confirmation} == 'START OVER' ]] || {
    echo 'Start over cancelled.'
    exit 0
}

if [[ ${container_action} == keep ]]; then
    # Quadlet normally removes its service-managed container during stop. Clear
    # only ExecStopPost for this one stop so the stopped container can be
    # preserved and renamed after the normal graceful stop completes.
    install -d -m0755 "$(dirname "${keep_dropin}")"
    printf '[Service]\nExecStopPost=\n' > "${keep_dropin}"
    systemctl daemon-reload
fi

cleanup_keep_override() {
    rm -f -- "${keep_dropin}"
    rmdir /run/systemd/system/minecraft.service.d 2>/dev/null || true
    systemctl daemon-reload >/dev/null 2>&1 || true
}
trap cleanup_keep_override EXIT

# Reuse the normal player-aware shutdown path. If player state is unknown, or
# the administrator refuses to interrupt online players, this exits before any
# configuration is removed.
if systemctl is-active --quiet minecraft.service 2>/dev/null; then
    /usr/libexec/justvoxel/mjust/service stop
fi

if [[ ${container_action} == keep ]]; then
    podman container exists minecraft 2>/dev/null || {
        echo 'ERROR: the stopped Minecraft container could not be preserved. Configuration was not removed.' >&2
        exit 1
    }
    preserved_container="minecraft-preserved-${timestamp}"
    suffix=1
    while podman container exists "${preserved_container}" 2>/dev/null; do
        preserved_container="minecraft-preserved-${timestamp}-${suffix}"
        suffix=$((suffix + 1))
    done
    podman rename minecraft "${preserved_container}"
    cleanup_keep_override
    trap - EXIT
fi

if [[ ${save_config} == yes ]]; then
    config_backup_dir=/var/lib/justvoxel/config-backups
    install -d -m0700 -o root -g root "${config_backup_dir}"
    config_backup="${config_backup_dir}/justvoxel-config-${timestamp}.tar.gz"
    partial="${config_backup}.partial"
    rm -f -- "${partial}"

    archive_paths=()
    for path in \
        etc/justvoxel \
        etc/containers/systemd/minecraft.container \
        etc/systemd/system/minecraft-backup.service \
        etc/systemd/system/minecraft-backup.timer; do
        [[ -e "/${path}" ]] && archive_paths+=("${path}")
    done

    (( ${#archive_paths[@]} > 0 )) || {
        echo 'ERROR: no active JustVoxel configuration files were found to archive.' >&2
        exit 1
    }
    tar -C / -czf "${partial}" "${archive_paths[@]}"
    tar -tzf "${partial}" >/dev/null
    chmod 0600 "${partial}"
    mv -f -- "${partial}" "${config_backup}"
fi

if [[ ${container_action} == remove ]] && podman container exists minecraft 2>/dev/null; then
    podman rm minecraft >/dev/null
fi

jv_reset_remove_active_configuration "${java_port}" "${bedrock_enabled}" "${bedrock_port}"

echo
echo 'JustVoxel Minecraft configuration has been removed.'
echo
echo 'Preserved Minecraft data:'
echo "  ${data_path}"
echo
echo 'Preserved backups:'
echo "  ${backup_path}"
if [[ -n ${config_backup} ]]; then
    echo
    echo 'Configuration backup:'
    echo "  ${config_backup}"
fi
if [[ -n ${preserved_container} ]]; then
    echo
    echo 'Preserved stopped container:'
    echo "  ${preserved_container}"
elif [[ ${container_action} == remove ]]; then
    echo
    echo 'The old Minecraft container was removed. Its image was kept.'
fi

echo
echo 'JustVoxel is ready for first setup.'
echo 'Run: mjust'
