#!/usr/bin/bash
set -euo pipefail

source /usr/libexec/justvoxel/mjust/admin-storage-actions-common.sh
require_root
storage_action_load_config

source /usr/libexec/justvoxel/mjust/storage-mount-ownership.sh

REQUEST_JSON=''
PLAN_JSON=''
PLAN_WARNINGS='[]'

json_error() {
    jq -n --arg error "$1" '{ok:false,error:$error,warnings:[],applied:false}'
}

append_warning() {
    jq -c --arg message "$2" '. + [$message]' <<< "$1"
}

storage_mount_fingerprint() {
    local device="$1" uuid="$2" mountpoint="$3" state
    state="$(storage_mount_state_path "${uuid}")" || return 1
    {
        printf 'device=%s\n' "$(storage_action_fingerprint "${device}")"
        printf 'uuid=%s\nmountpoint=%s\n' "${uuid}" "${mountpoint}"
        if [[ -r ${state} ]]; then
            printf 'state-sha=%s\n' "$(sha256sum "${state}" | awk '{print $1}')"
        else
            printf 'state-sha=absent\n'
        fi
        storage_mount_fstab_matches "${uuid}" "${mountpoint}" | sort
    } | sha256sum | awk '{print $1}'
}

storage_mount_validate_location() {
    local mountpoint="$1" current="$2"
    storage_validate_mountpoint_path "${mountpoint}" >/dev/null 2>&1 || return 1
    if [[ -n ${current} ]]; then
        [[ ${current} == "${mountpoint}" ]] || return 2
        return 0
    fi
    storage_action_host_mountpoint_occupied "${mountpoint}" && return 1
    if [[ -d ${mountpoint} ]] && find "${mountpoint}" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null | grep -q .; then
        return 1
    fi
}

storage_mount_read_request() {
    REQUEST_JSON="$(cat)"
    jq -e '
        type == "object"
        and ((keys - ["operation","device","mount_point","fingerprint"]) | length == 0)
        and ((.operation // "") | type == "string")
        and ((.device // "") | type == "string")
        and ((.mount_point // "") | type == "string")
        and ((.fingerprint // "") | type == "string")
    ' >/dev/null 2>&1 <<< "${REQUEST_JSON}"
}

prepare_plan() {
    local operation device requested_mount filesystem uuid current_mount role size ownership fingerprint
    local mounted=false changed=true rc created=false
    PLAN_WARNINGS='[]'
    STORAGE_MOUNT_ORPHAN_LINE=''
    storage_mount_read_request || { json_error 'Invalid permanent-mount request.'; return 1; }

    operation="$(jq -r '.operation // ""' <<< "${REQUEST_JSON}")"
    device="$(storage_action_real_device "$(jq -r '.device // ""' <<< "${REQUEST_JSON}")")"
    requested_mount="$(jq -r '.mount_point // ""' <<< "${REQUEST_JSON}")"
    [[ -n ${device} ]] || { json_error 'Choose a storage partition.'; return 1; }
    storage_action_validate_target "${device}" >/dev/null 2>&1 || {
        json_error 'This partition is protected or unavailable for permanent mounting.'
        return 1
    }

    filesystem="$(storage_action_filesystem "${device}")"
    storage_action_mountable_filesystem "${filesystem}" || {
        json_error 'This partition does not use a filesystem supported for mounting.'
        return 1
    }
    uuid="$(storage_action_uuid "${device}")"
    [[ -n ${uuid} ]] && storage_mount_state_path "${uuid}" >/dev/null || {
        json_error 'This filesystem does not have a usable UUID.'
        return 1
    }
    current_mount="$(storage_action_mountpoint "${device}")" || { json_error 'Could not verify the host mount state for this partition.'; return 1; }
    [[ -z ${current_mount} ]] || { current_mount="$(realpath -m -- "${current_mount}")"; mounted=true; }
    role="$(storage_action_role "${device}" "${filesystem}" "${uuid}" "${current_mount}")"
    size="$(storage_action_size_bytes "${device}")"; size="${size:-0}"

    case "${operation}" in
        persist)
            [[ -n ${requested_mount} ]] || { json_error 'Choose where this filesystem should be mounted.'; return 1; }
            requested_mount="$(realpath -m -- "${requested_mount}" 2>/dev/null || true)"
            set +e
            storage_mount_validate_location "${requested_mount}" "${current_mount}"
            rc=$?
            set -e
            if (( rc == 2 )); then
                json_error "This filesystem is already mounted at ${current_mount}. Unmount it before choosing a different location."
                return 1
            elif (( rc != 0 )); then
                json_error 'Choose an unused, empty and non-critical mount location.'
                return 1
            fi
            ownership="$(storage_mount_ownership "${uuid}" "${requested_mount}" "${filesystem}")"
            case "${ownership}" in
                external)
                    if [[ -z ${current_mount} ]] && storage_mount_prove_orphan "${device}" "${uuid}" "${requested_mount}" "${filesystem}"; then
                        ownership=none
                    else
                        json_error 'This filesystem or mount location already has a permanent mount configured outside JustVoxel. JustVoxel will not replace it.'
                        return 1
                    fi
                    ;;
                conflict)
                    json_error 'The saved permanent-mount configuration is inconsistent. Nothing was changed.'
                    return 1
                    ;;
                other_mount)
                    storage_mount_load_state "${uuid}" || true
                    json_error "This filesystem already has a JustVoxel permanent mount at ${MOUNT_STATE_MOUNT:-another location}. Remove that mount before choosing another location."
                    return 1
                    ;;
                justvoxel)
                    storage_mount_load_state "${uuid}" || { json_error 'The saved permanent-mount configuration is inconsistent.'; return 1; }
                    created="${MOUNT_STATE_CREATED}"
                    [[ ${current_mount} == "${requested_mount}" ]] && changed=false
                    ;;
                none) ;;
            esac
            ;;
        remove)
            ownership="$(storage_mount_ownership "${uuid}" "" "${filesystem}")"
            case "${ownership}" in
                external)
                    json_error 'This permanent mount was not created by JustVoxel, so JustVoxel will not remove it.'
                    return 1
                    ;;
                none)
                    json_error 'This filesystem does not have a JustVoxel permanent mount to remove.'
                    return 1
                    ;;
                conflict|other_mount)
                    json_error 'The saved permanent-mount configuration is inconsistent. Nothing was changed.'
                    return 1
                    ;;
            esac
            storage_mount_load_state "${uuid}" || { json_error 'The saved permanent-mount configuration is incomplete.'; return 1; }
            requested_mount="${MOUNT_STATE_MOUNT}"
            created="${MOUNT_STATE_CREATED}"
            if [[ -n ${current_mount} && ${current_mount} != "${requested_mount}" ]]; then
                json_error "This filesystem is mounted at ${current_mount}, not at its saved JustVoxel mount location. Nothing was changed."
                return 1
            fi
            [[ ${role} != *Minecraft* ]] || PLAN_WARNINGS="$(append_warning "${PLAN_WARNINGS}" 'Minecraft data currently uses this filesystem. Removing its permanent mount can interrupt the server.')"
            [[ ${role} != *Backups* ]] || PLAN_WARNINGS="$(append_warning "${PLAN_WARNINGS}" 'Backups currently use this filesystem. Removing its permanent mount can make backups unavailable.')"
            ;;
        *) json_error 'Choose a permanent mount action.'; return 1 ;;
    esac

    fingerprint="$(storage_mount_fingerprint "${device}" "${uuid}" "${requested_mount}")"
    [[ -n ${fingerprint} ]] || { json_error 'Could not capture a stable permanent-mount fingerprint.'; return 1; }
    PLAN_JSON="$(jq -n \
        --arg operation "${operation}" --arg device "${device}" --arg filesystem "${filesystem}" \
        --arg uuid "${uuid}" --arg mount_point "${requested_mount}" --arg current_mount_point "${current_mount}" \
        --arg role "${role}" --arg ownership "${ownership}" --arg fingerprint "${fingerprint}" \
        --argjson size_bytes "${size}" --argjson mounted "${mounted}" --argjson changed "${changed}" \
        --argjson directory_created "${created}" \
        '{operation:$operation,device:$device,filesystem:$filesystem,uuid:$uuid,mount_point:$mount_point,current_mount_point:$current_mount_point,role:$role,persistence:$ownership,fingerprint:$fingerprint,size_bytes:$size_bytes,mounted:$mounted,changed:$changed,directory_created:$directory_created}')"
}

plan_json() {
    prepare_plan || return 0
    jq -n --argjson proposed "${PLAN_JSON}" --argjson warnings "${PLAN_WARNINGS}" '{ok:true,proposed:$proposed,warnings:$warnings,applied:false}'
}

status_json() {
    local request device filesystem uuid current mount ownership target created=false mounted=false
    request="$(cat)"
    jq -e 'type == "object" and ((keys - ["device"]) | length == 0) and (.device|type == "string")' >/dev/null 2>&1 <<< "${request}" || {
        json_error 'Invalid permanent-mount status request.'; return 0;
    }
    device="$(storage_action_real_device "$(jq -r '.device' <<< "${request}")")"
    storage_action_validate_target "${device}" >/dev/null 2>&1 || { json_error 'This partition is protected or unavailable for permanent mounting.'; return 0; }
    filesystem="$(storage_action_filesystem "${device}")"
    storage_action_mountable_filesystem "${filesystem}" || { json_error 'This partition does not use a filesystem supported for mounting.'; return 0; }
    uuid="$(storage_action_uuid "${device}")"
    [[ -n ${uuid} ]] || { json_error 'This filesystem does not have a usable UUID.'; return 0; }
    current="$(storage_action_mountpoint "${device}")" || { json_error 'Could not verify the host mount state for this partition.'; return 0; }
    [[ -z ${current} ]] || { current="$(realpath -m -- "${current}")"; mounted=true; }
    ownership="$(storage_mount_ownership "${uuid}" "" "${filesystem}")"
    target="${current}"
    if [[ ${ownership} == justvoxel ]]; then
        storage_mount_load_state "${uuid}" || { json_error 'The saved permanent-mount configuration is inconsistent.'; return 0; }
        target="${MOUNT_STATE_MOUNT}"; created="${MOUNT_STATE_CREATED}"
    elif [[ ${ownership} == external && -z ${target} ]]; then
        target="$(storage_mount_first_fstab_target "${uuid}")"
    fi
    jq -n --arg device "${device}" --arg filesystem "${filesystem}" --arg uuid "${uuid}" \
        --arg mount_point "${target}" --arg current_mount_point "${current}" --arg persistence "${ownership}" \
        --argjson mounted "${mounted}" --argjson directory_created "${created}" \
        '{ok:true,warnings:[],proposed:{device:$device,filesystem:$filesystem,uuid:$uuid,mount_point:$mount_point,current_mount_point:$current_mount_point,persistence:$persistence,mounted:$mounted,directory_created:$directory_created},applied:false}'
}

apply_json() {
    local submitted operation device filesystem uuid mountpoint current ownership created state line reviewed_orphan_line
    local fstab_snapshot state_snapshot='' fstab_existed=false state_existed=false created_now=false mounted_by_us=false was_mounted=false path_removed=false actual_uuid
    prepare_plan || return 0
    reviewed_orphan_line="${STORAGE_MOUNT_ORPHAN_LINE}"
    submitted="$(jq -r '.fingerprint // ""' <<< "${REQUEST_JSON}")"
    [[ -n ${submitted} && ${submitted} == "$(jq -r '.fingerprint' <<< "${PLAN_JSON}")" ]] || {
        json_error 'The selected filesystem or permanent-mount settings changed after Review. Nothing was changed. Review the action again.'
        return 0
    }

    operation="$(jq -r '.operation' <<< "${PLAN_JSON}")"; device="$(jq -r '.device' <<< "${PLAN_JSON}")"
    filesystem="$(jq -r '.filesystem' <<< "${PLAN_JSON}")"; uuid="$(jq -r '.uuid' <<< "${PLAN_JSON}")"
    mountpoint="$(jq -r '.mount_point' <<< "${PLAN_JSON}")"; current="$(jq -r '.current_mount_point' <<< "${PLAN_JSON}")"
    ownership="$(jq -r '.persistence' <<< "${PLAN_JSON}")"; created="$(jq -r '.directory_created' <<< "${PLAN_JSON}")"
    state="$(storage_mount_state_path "${uuid}")" || { json_error 'Invalid filesystem identity.'; return 0; }
    line="$(storage_mount_fstab_line "${uuid}" "${mountpoint}" "${filesystem}")"

    fstab_snapshot="$(mktemp "$(dirname -- "${STORAGE_MOUNT_FSTAB}")/.fstab.justvoxel-mount-before.XXXXXX")" || { json_error 'Could not prepare a permanent-mount rollback point.'; return 0; }
    if [[ -e ${STORAGE_MOUNT_FSTAB} ]]; then
        cp -a -- "${STORAGE_MOUNT_FSTAB}" "${fstab_snapshot}" || { rm -f -- "${fstab_snapshot}"; json_error 'Could not snapshot permanent-mount configuration.'; return 0; }
        fstab_existed=true
    else : > "${fstab_snapshot}"; fi
    if [[ -e ${state} ]]; then
        state_snapshot="$(mktemp "$(dirname -- "${STORAGE_MOUNT_FSTAB}")/.justvoxel-mount-state-before.XXXXXX")" && cp -a -- "${state}" "${state_snapshot}" || {
            rm -f -- "${fstab_snapshot}" "${state_snapshot}"; json_error 'Could not snapshot permanent-mount ownership.'; return 0;
        }
        state_existed=true
    fi

    restore() {
        local ok=true
        [[ ${mounted_by_us} != true ]] || storage_action_host_unmount "${mountpoint}" >/dev/null 2>&1 || ok=false
        if [[ ${fstab_existed} == true ]]; then cp -a -- "${fstab_snapshot}" "${STORAGE_MOUNT_FSTAB}" || ok=false; else rm -f -- "${STORAGE_MOUNT_FSTAB}" || ok=false; fi
        if [[ ${state_existed} == true ]]; then install -d -m0700 -o root -g root "${STORAGE_MOUNT_STATE_DIR}" || ok=false; cp -a -- "${state_snapshot}" "${state}" || ok=false; else rm -f -- "${state}" || ok=false; fi
        systemctl daemon-reload >/dev/null 2>&1 || ok=false
        [[ ${was_mounted} != true ]] || storage_action_host_mount "${mountpoint}" >/dev/null 2>&1 || ok=false
        [[ ${created_now} != true ]] || rmdir -- "${mountpoint}" >/dev/null 2>&1 || true
        [[ ${ok} == true ]]
    }

    permanent_mount_fail() {
        if restore; then
            rm -f -- "${fstab_snapshot}" "${state_snapshot}"
            json_error "$1 The previous configuration was restored."
        else
            json_error "$1 Rollback could not complete; the rollback snapshots were preserved."
        fi
    }

    case "${operation}" in
        persist)
            if [[ ${ownership} != justvoxel ]]; then
                if [[ ! -d ${mountpoint} ]]; then install -d -m0755 -o root -g root "${mountpoint}" || { rm -f -- "${fstab_snapshot}" "${state_snapshot}"; json_error 'Could not create the selected mount location.'; return 0; }; created_now=true; created=true; fi
                { [[ -z ${reviewed_orphan_line} ]] || {
                    storage_mount_prove_orphan "${device}" "${uuid}" "${mountpoint}" "${filesystem}" &&
                    [[ ${STORAGE_MOUNT_ORPHAN_LINE} == "${reviewed_orphan_line}" ]] &&
                    storage_mount_remove_fstab_line "${reviewed_orphan_line}"
                }; } && storage_mount_append_fstab "${line}" && storage_mount_write_state "${uuid}" "${mountpoint}" "${filesystem}" "${created}" && systemctl daemon-reload >/dev/null 2>&1 || {
                    permanent_mount_fail 'Could not save the permanent mount safely.'; return 0;
                }
            fi
            if [[ -z ${current} ]]; then
                storage_action_host_mount "${mountpoint}" >/dev/null 2>&1 || { permanent_mount_fail 'The filesystem could not be mounted.'; return 0; }
                mounted_by_us=true
            fi
            actual_uuid="$(storage_action_host_mount_identity UUID "${mountpoint}" 2>/dev/null || true)"
            [[ ${actual_uuid} == "${uuid}" ]] || { permanent_mount_fail 'The mounted filesystem did not match the reviewed filesystem.'; return 0; }
            rm -f -- "${fstab_snapshot}" "${state_snapshot}"
            jq -n --argjson proposed "${PLAN_JSON}" --argjson warnings "${PLAN_WARNINGS}" '{ok:true,proposed:($proposed + {persistence:"justvoxel",current_mount_point:$proposed.mount_point,mounted:true}),warnings:$warnings,applied:true,mount_point_removed:false}'
            ;;
        remove)
            if [[ -n ${current} ]]; then
                was_mounted=true
                actual_uuid="$(storage_action_host_mount_identity UUID "${mountpoint}" 2>/dev/null || true)"
                [[ ${actual_uuid} == "${uuid}" ]] || { rm -f -- "${fstab_snapshot}" "${state_snapshot}"; json_error 'The mounted filesystem no longer matches the reviewed filesystem. Nothing was changed.'; return 0; }
                storage_action_host_unmount "${mountpoint}" >/dev/null 2>&1 || { rm -f -- "${fstab_snapshot}" "${state_snapshot}"; json_error 'The filesystem is still in use and could not be unmounted. Its permanent mount was left unchanged.'; return 0; }
            fi
            storage_mount_remove_fstab_line "${line}" && rm -f -- "${state}" && systemctl daemon-reload >/dev/null 2>&1 || {
                permanent_mount_fail 'Could not remove the permanent mount safely.'; return 0;
            }
            if [[ ${created} == true ]] && rmdir -- "${mountpoint}" >/dev/null 2>&1; then path_removed=true; elif [[ ${created} == true ]]; then PLAN_WARNINGS="$(append_warning "${PLAN_WARNINGS}" 'The permanent mount was removed, but its folder was kept because it is not empty or could not be removed safely.')"; fi
            rm -f -- "${fstab_snapshot}" "${state_snapshot}"
            jq -n --argjson proposed "${PLAN_JSON}" --argjson warnings "${PLAN_WARNINGS}" --argjson path_removed "${path_removed}" '{ok:true,proposed:($proposed + {persistence:"none",current_mount_point:"",mounted:false}),warnings:$warnings,applied:true,mount_point_removed:$path_removed}'
            ;;
    esac
}

case "${1:-status}" in
    status) status_json ;;
    plan) plan_json ;;
    apply) apply_json ;;
    *) json_error 'Usage: admin-storage-mounts-json {status|plan|apply}' ;;
esac
