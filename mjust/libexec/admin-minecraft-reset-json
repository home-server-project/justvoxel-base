#!/usr/bin/bash
set -euo pipefail

source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/minecraft-reset-common.sh

require_root

action="${1:-}"
case "${action}" in
    plan|apply) ;;
    *)
        echo '{"ok":false,"error":"unsupported reset action"}'
        exit 2
        ;;
esac

if [[ ! -r ${JV_CONFIG} ]]; then
    jq -n '{ok:false,code:"not_configured",error:"JustVoxel Minecraft is not configured."}'
    exit 3
fi

# shellcheck disable=SC1090
source "${JV_CONFIG}"

data_scope="$(jv_reset_data_scope "${DATA_PATH}")"
data_action=preserve
warnings=()

case "${data_scope}" in
    internal)
        data_action=delete
        ;;
    network|external|unknown)
        warnings+=("Minecraft data is outside appliance-owned internal storage and will be preserved.")
        ;;
    unsafe)
        jq -n '{ok:false,code:"unsafe_data_path",error:"Minecraft data path is unsafe to reset."}'
        exit 4
        ;;
esac

if jv_reset_backup_nested_in_data "${DATA_PATH}" "${BACKUP_PATH}"; then
    jq -n         --arg data_path "${DATA_PATH}"         --arg backup_path "${BACKUP_PATH}"         '{ok:false,code:"backup_inside_minecraft_data",error:"Backup storage is inside the Minecraft data path. Move backups before resetting Minecraft.",data_path:$data_path,backup_path:$backup_path}'
    exit 4
fi

players_json='{"configured":true,"state":"unknown","online":0,"max":0,"names":[]}'
if status_json="$(/usr/libexec/justvoxel/mjust/web-status-json players 2>/dev/null)"; then
    if jq -e 'type=="object" and (.online|type=="number") and (.names|type=="array")' <<<"${status_json}" >/dev/null 2>&1; then
        players_json="${status_json}"
    else
        warnings+=("Player status could not be validated during reset planning.")
    fi
else
    warnings+=("Player status could not be validated during reset planning.")
fi

emit_plan() {
    local warnings_json
    warnings_json="$(printf '%s\n' "${warnings[@]-}" | jq -Rsc 'split("\n") | map(select(length>0))')"
    jq -n         --arg data_path "${DATA_PATH}"         --arg data_scope "${data_scope}"         --arg data_action "${data_action}"         --arg backup_path "${BACKUP_PATH}"         --argjson players "${players_json}"         --argjson warnings "${warnings_json}"         '{
          ok:true,
          schema_version:"v1",
          mode:"minecraft",
          data_path:$data_path,
          data_scope:$data_scope,
          data_action:$data_action,
          backup_path:$backup_path,
          backup_action:"preserve",
          storage_layout_action:"preserve",
          authentication_action:"preserve",
          webui_users_action:"preserve",
          players_online:($players.online // 0),
          players:($players.names // []),
          warnings:$warnings
        }'
}

if [[ ${action} == plan ]]; then
    emit_plan
    exit 0
fi

confirm_players="${2:-}"

minecraft_reset_fail() {
    local code="$1" message="$2" rc="${3:-5}"
    jq -n --arg code "${code}" --arg error "${message}" '{ok:false,code:$code,error:$error}'
    exit "${rc}"
}

if [[ ${confirm_players} != --confirm-players ]]; then
    minecraft_reset_fail "confirmation_required" "Minecraft reset Apply requires explicit player interruption confirmation." 4
fi

if systemctl is-active --quiet minecraft.service 2>/dev/null; then
    set +e
    stop_output="$(/usr/libexec/justvoxel/mjust/web-status-json stop --confirm-players 2>/dev/null)"
    stop_rc=$?
    set -e
    if (( stop_rc != 0 )) || ! jq -e '.ok == true' <<<"${stop_output}" >/dev/null 2>&1; then
        minecraft_reset_fail "minecraft_stop_failed" "Minecraft could not be stopped safely. Reset did not continue."
    fi
fi

# Quadlet/systemd stop and Podman container removal are asynchronous enough that a
# plain 'podman rm' can race the final container state. Force+ignore makes this
# retry-safe for running, stopped, or already-removed containers.
if ! podman rm --force --ignore minecraft >/dev/null 2>&1; then
    minecraft_reset_fail "container_cleanup_failed" "Minecraft container cleanup failed. Retry Reset Minecraft after reviewing the container state."
fi

if [[ ${data_action} == delete ]]; then
    if ! cleanup_error="$(jv_reset_delete_internal_data "${DATA_PATH}" "${BACKUP_PATH}" 2>&1)"; then
        minecraft_reset_fail "data_cleanup_failed" "Minecraft data cleanup failed: ${cleanup_error:-unknown cleanup error}"
    fi
fi

if ! jv_reset_remove_active_configuration "${JAVA_PORT}" "${BEDROCK_ENABLED}" "${BEDROCK_PORT}"; then
    minecraft_reset_fail "configuration_cleanup_failed" "JustVoxel runtime configuration could not be removed completely."
fi

jq -n     --arg data_path "${DATA_PATH}"     --arg data_scope "${data_scope}"     --arg data_action "${data_action}"     --arg backup_path "${BACKUP_PATH}"     '{
      ok:true,
      schema_version:"v1",
      mode:"minecraft",
      data_path:$data_path,
      data_scope:$data_scope,
      data_action:$data_action,
      backup_path:$backup_path,
      backup_action:"preserve",
      authentication_action:"preserve",
      webui_users_action:"preserve",
      message:"Minecraft reset completed."
    }'
