#!/usr/bin/bash
set -Eeuo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/ui.sh
source /usr/libexec/justvoxel/mjust/backup-common.sh
source /usr/libexec/justvoxel/mjust/restore-common.sh
source /usr/libexec/justvoxel/mjust/interrupt-safety.sh
source /usr/libexec/justvoxel/mjust/storage-common.sh
source /usr/libexec/justvoxel/mjust/migration-common.sh
source /usr/libexec/justvoxel/mjust/migration-transport.sh
require_root

if (( $# > 1 )); then
    echo 'Usage: migration-import [SOURCE]' >&2
    exit 2
fi
if [[ ${JV_MIGRATION_API_MODE:-0} != 1 ]] && ! jui_has_tty; then
    echo 'ERROR: import requires a controlling terminal for compatibility review and destructive confirmation.' >&2
    echo 'For SSH, allocate a terminal, for example: ssh -t <host> mjust import' >&2
    exit 1
fi

configured=no
if [[ -r ${JV_CONFIG} && -e ${JV_QUADLET} ]]; then
    configured=yes
    require_config
fi

transport_started=no
transaction=''
source_identity=''
source_class='unknown'
validated=no
live_modified=no
minecraft_was_active=no
minecraft_stopped_by_import=no
had_existing_data=no
rollback_attempted=no

# The Management Agent may have mounted SMB/NFS/device media before launching
# the backend. Carry only that owned transport state into this process so it can
# be released immediately after local staging. Existing administrator mounts
# have an empty owned-mount value and are never unmounted by JustVoxel.
if [[ ${JV_MIGRATION_API_SOURCE_TRANSPORT_STARTED:-no} == yes ]]; then
    transport_started=yes
    JV_MIGRATION_TRANSPORT_ROOT="${JV_MIGRATION_API_SOURCE_TRANSPORT_ROOT:-}"
    JV_MIGRATION_OWNED_MOUNT="${JV_MIGRATION_API_SOURCE_OWNED_MOUNT:-}"
    JV_MIGRATION_MEDIA_MOUNT="${JV_MIGRATION_API_SOURCE_MEDIA_MOUNT:-}"
    JV_MIGRATION_SMB_CREDENTIALS="${JV_MIGRATION_API_SOURCE_SMB_CREDENTIALS:-}"
fi

old_java=''
old_bedrock_enabled=no
old_bedrock='19132'
old_data=''
if [[ ${configured} == yes ]]; then
    old_java="${JAVA_PORT}"
    old_bedrock_enabled="${BEDROCK_ENABLED}"
    old_bedrock="${BEDROCK_PORT}"
    old_data="${DATA_PATH}"
fi

source /usr/libexec/justvoxel/mjust/migration-import-common.sh
source /usr/libexec/justvoxel/mjust/migration-import-plan-source.sh
source /usr/libexec/justvoxel/mjust/migration-import-plan-destination.sh
source /usr/libexec/justvoxel/mjust/migration-import-activate.sh
