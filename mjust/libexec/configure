#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/ui.sh
source /usr/libexec/justvoxel/mjust/configuration-api.sh

if (( EUID != 0 )); then
    echo 'ERROR: this operation must run as root.' >&2
    exit 1
fi

configuration=''

refresh_configuration() {
    configuration="$(jv_config_get)"
}

base_payload() {
    jv_config_payload <<<"${configuration}"
}

apply_and_refresh() {
    local payload="$1"
    jv_config_apply_payload "${payload}" || return 1
    refresh_configuration
}

show_configuration() {
    echo "Minecraft data: $(jq -r '.minecraft.data_path // "Unknown"' <<<"${configuration}")"
    echo "Container image: docker.io/itzg/minecraft-server:$(jq -r '.minecraft.image_tag // "Unknown"' <<<"${configuration}")"
    echo "Minecraft version policy: $(jq -r '.minecraft.version_mode // "Unknown"' <<<"${configuration}") ($(jq -r '.minecraft.version // "Unknown"' <<<"${configuration}"))"
    echo "Java heap / maximum total Minecraft memory: $(jq -r '.minecraft.java_memory // "Unknown"' <<<"${configuration}") / $(jq -r '.minecraft.container_memory // "Unknown"' <<<"${configuration}")"
    echo "Java port: $(jq -r '.minecraft.java_port // 0' <<<"${configuration}")/tcp"
    echo "Bedrock: $(jq -r 'if .minecraft.bedrock_enabled then "yes" else "no" end' <<<"${configuration}") ($(jq -r '.minecraft.bedrock_port // 0' <<<"${configuration}")/udp)"
    echo "Backup type: $(jq -r '.backup.type // "Unknown"' <<<"${configuration}")"
    echo "Backup path: $(jq -r '.backup.path // "Unknown"' <<<"${configuration}")"
    echo "Backup mount: $(jq -r 'if (.backup.mount_point // "") == "" then "none" else .backup.mount_point end' <<<"${configuration}")"
    echo "Backup schedule: $(jq -r '.backup.schedule // "Unknown"' <<<"${configuration}")"
    echo "Backup timer enabled: $(jq -r 'if .backup.timer_enabled then "yes" else "no" end' <<<"${configuration}")"
    echo "Maximum players: $(jq -r '.minecraft.max_players // 0' <<<"${configuration}")"
    echo "MOTD: $(jq -r '.minecraft.motd // ""' <<<"${configuration}")"
}

configure_memory() {
    local java_memory container_memory new_java new_container payload
    java_memory="$(jq -r '.minecraft.java_memory' <<<"${configuration}")"
    container_memory="$(jq -r '.minecraft.container_memory' <<<"${configuration}")"
    new_java="$(jui_input 'Minecraft Java heap' "${java_memory}")" || return 0
    new_container="$(jui_input 'Maximum total Minecraft memory' "${container_memory}")" || return 0
    payload="$(base_payload | jq -c --arg java "${new_java}" --arg container "${new_container}" '.java_memory=$java | .container_memory=$container')"
    apply_and_refresh "${payload}"
}

configure_ports() {
    local bedrock_enabled java_port bedrock_port new_java new_bedrock payload
    bedrock_enabled="$(jq -r '.minecraft.bedrock_enabled' <<<"${configuration}")"
    java_port="$(jq -r '.minecraft.java_port' <<<"${configuration}")"
    bedrock_port="$(jq -r '.minecraft.bedrock_port' <<<"${configuration}")"
    new_java="$(jui_input 'Java host TCP port' "${java_port}")" || return 0
    [[ ${new_java} =~ ^[0-9]+$ ]] || { echo 'ERROR: Java port must be a number.' >&2; return 1; }
    new_bedrock="${bedrock_port}"
    if [[ ${bedrock_enabled} == true ]]; then
        new_bedrock="$(jui_input 'Bedrock host UDP port' "${bedrock_port}")" || return 0
        [[ ${new_bedrock} =~ ^[0-9]+$ ]] || { echo 'ERROR: Bedrock port must be a number.' >&2; return 1; }
    fi
    payload="$(base_payload | jq -c --argjson java "${new_java}" --argjson bedrock "${new_bedrock}" '.java_port=$java | .bedrock_port=$bedrock')"
    apply_and_refresh "${payload}"
}

configure_bedrock() {
    local enabled state choice port new_port payload
    enabled="$(jq -r '.minecraft.bedrock_enabled' <<<"${configuration}")"
    port="$(jq -r '.minecraft.bedrock_port' <<<"${configuration}")"
    if [[ ${enabled} == true ]]; then state='enabled'; else state='disabled'; fi
    choice="$(jui_choose "Bedrock cross-play - currently ${state}"         "$([[ ${enabled} == true ]] && printf 'Disable Bedrock cross-play' || printf 'Enable Bedrock cross-play')"         'Back')" || return 0
    [[ ${choice} != Back ]] || return 0

    if [[ ${enabled} == true ]]; then
        payload="$(base_payload | jq -c '.bedrock_enabled=false')"
    else
        new_port="$(jui_input 'Bedrock host UDP port' "${port}")" || return 0
        [[ ${new_port} =~ ^[0-9]+$ ]] || { echo 'ERROR: Bedrock port must be a number.' >&2; return 1; }
        payload="$(base_payload | jq -c --argjson port "${new_port}" '.bedrock_enabled=true | .bedrock_port=$port')"
    fi
    apply_and_refresh "${payload}"
}

configure_motd() {
    local current new_motd payload
    current="$(jq -r '.minecraft.motd' <<<"${configuration}")"
    new_motd="$(jui_input 'Server welcome message (MOTD)' "${current}")" || return 0
    payload="$(base_payload | jq -c --arg motd "${new_motd}" '.motd=$motd')"
    apply_and_refresh "${payload}"
}

configure_backup_schedule() {
    local schedule timer_enabled new_schedule timer_choice new_timer payload
    schedule="$(jq -r '.backup.schedule' <<<"${configuration}")"
    timer_enabled="$(jq -r '.backup.timer_enabled' <<<"${configuration}")"
    new_schedule="$(jui_input 'Backup systemd calendar schedule' "${schedule}")" || return 0
    timer_choice="$(jui_choose 'Scheduled backup timer'         "Keep current: $([[ ${timer_enabled} == true ]] && printf yes || printf no)"         'Enable scheduled backups'         'Disable scheduled backups'         'Back')" || return 0
    case "${timer_choice}" in
        'Back') return 0 ;;
        'Enable scheduled backups') new_timer=true ;;
        'Disable scheduled backups') new_timer=false ;;
        *) new_timer="${timer_enabled}" ;;
    esac
    payload="$(base_payload | jq -c --arg schedule "${new_schedule}" --argjson timer "${new_timer}" '.backup_schedule=$schedule | .backup_timer_enabled=$timer')"
    apply_and_refresh "${payload}"
}

configure_image_version() {
    local current_tag current_mode current_version image_choice version_choice new_tag new_mode new_version payload
    current_tag="$(jq -r '.minecraft.image_tag' <<<"${configuration}")"
    current_mode="$(jq -r '.minecraft.version_mode' <<<"${configuration}")"
    current_version="$(jq -r '.minecraft.version' <<<"${configuration}")"
    new_tag="${current_tag}"
    new_mode="${current_mode}"
    new_version="${current_version}"

    image_choice="$(jui_choose 'Container image policy'         "Keep current: ${current_tag}"         'latest - newest upstream main-branch image'         'stable - newest released image'         'custom / exact tag'         'Back')" || return 0
    case "${image_choice}" in
        'Back') return 0 ;;
        'latest - newest upstream main-branch image') new_tag=latest ;;
        'stable - newest released image') new_tag=stable ;;
        'custom / exact tag') new_tag="$(jui_input 'Container image tag' "${current_tag}")" || return 0 ;;
    esac

    version_choice="$(jui_choose 'Minecraft version policy'         "Keep current: ${current_mode} (${current_version})"         'Pin newest stable Paper-supported Minecraft version'         'LATEST - resolve newest Minecraft/Paper release when Minecraft starts'         'Pin another exact stable Paper-supported version'         'Back')" || return 0
    case "${version_choice}" in
        'Back') return 0 ;;
        'Pin newest stable Paper-supported Minecraft version')
            new_mode=recommended
            ;;
        'LATEST - resolve newest Minecraft/Paper release when Minecraft starts')
            new_mode=latest
            new_version=LATEST
            echo 'WARNING: the game/Paper version may update when Minecraft starts, even without pulling a newer Podman image.'
            ;;
        'Pin another exact stable Paper-supported version')
            new_mode=pinned
            new_version="$(jui_input 'Exact Minecraft version' "${current_version}")" || return 0
            ;;
    esac

    payload="$(base_payload | jq -c --arg tag "${new_tag}" --arg policy "${new_mode}" --arg version "${new_version}" '.image_tag=$tag | .version_policy=$policy | .version=$version')"
    apply_and_refresh "${payload}"
}

refresh_configuration

case "${1:-menu}" in
    backup)
        configure_backup_schedule
        exit $?
        ;;
    menu|'') ;;
    *)
        echo 'Usage: configure [backup]' >&2
        exit 2
        ;;
esac

while true; do
    choice="$(jui_choose 'Configure Minecraft'         'Show current configuration'         'Maximum players'         'Change memory limits'         'Change Java/Bedrock host ports'         'Enable / disable Bedrock cross-play'         'Change server welcome message (MOTD)'         'Change backup schedule/timer'         'Change storage / migrate Minecraft data'         'Change container image or Minecraft version policy'         'Back')" || exit 0

    case "${choice}" in
        'Show current configuration') show_configuration ;;
        'Maximum players') /usr/libexec/justvoxel/mjust/configure-max-players || true; refresh_configuration ;;
        'Change memory limits') configure_memory || true ;;
        'Change Java/Bedrock host ports') configure_ports || true ;;
        'Enable / disable Bedrock cross-play') configure_bedrock || true ;;
        'Change server welcome message (MOTD)') configure_motd || true ;;
        'Change backup schedule/timer') configure_backup_schedule || true ;;
        'Change storage / migrate Minecraft data') /usr/libexec/justvoxel/mjust/storage-provision menu || true ;;
        'Change container image or Minecraft version policy') configure_image_version || true ;;
        'Back') exit 0 ;;
    esac
done
