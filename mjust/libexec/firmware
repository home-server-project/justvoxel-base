#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/interrupt-safety.sh
require_root

if ! jv_variant_is_hwe; then
    echo 'Firmware setup is available on JustVoxel HWE only.'
    echo 'For a JustVoxel VM, manage firmware/UEFI through the hypervisor.'
    exit 1
fi

if [[ ! -d /sys/firmware/efi ]]; then
    echo 'ERROR: this machine is not currently booted through EFI; firmware-setup reboot is unavailable.' >&2
    exit 1
fi

if ! systemctl reboot --firmware-setup --dry-run >/dev/null 2>&1; then
    echo 'ERROR: systemd/firmware does not report support for rebooting into firmware setup.' >&2
    exit 1
fi

display_state=unknown
found_connector=no
for status_file in /sys/class/drm/card*-*/status; do
    [[ -r ${status_file} ]] || continue
    found_connector=yes
    connector_state="$(cat "${status_file}" 2>/dev/null || true)"
    if [[ ${connector_state} == connected ]]; then
        display_state=connected
        break
    fi
    display_state=disconnected
done

case "${display_state}" in
    connected)
        echo 'Display: connected'
        echo 'Firmware setup reboot is supported.'
        ;;
    disconnected)
        echo 'WARNING: no connected display was detected.'
        echo 'Firmware setup may leave this machine waiting at a local firmware screen'
        echo 'that cannot be used over SSH.'
        ;;
    *)
        echo 'WARNING: display state is unknown.'
        echo 'JustVoxel cannot reliably confirm that a local display is available.'
        echo 'Continue only if you can access the machine locally.'
        ;;
esac

echo
confirm 'Reboot into firmware / UEFI setup?' || { echo 'Firmware reboot cancelled.'; exit 0; }

was_active=no
if systemctl is-active --quiet minecraft.service 2>/dev/null; then
    was_active=yes
fi
jv_stop_minecraft_for_system_action 'Reboot into firmware setup'

if ! systemctl reboot --firmware-setup; then
    echo 'ERROR: firmware reboot request failed.' >&2
    if [[ ${was_active} == yes ]]; then
        echo 'Restarting Minecraft because the host did not reboot.' >&2
        systemctl start minecraft.service || true
    fi
    exit 1
fi
