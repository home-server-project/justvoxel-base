#!/usr/bin/bash
set -euo pipefail

readonly api_client=/usr/libexec/justvoxel/mjust/api-client

if (( EUID != 0 )); then
    echo 'ERROR: this operation must run as root.' >&2
    exit 1
fi

instance_id=""
if [[ ${1:-} == --instance && $# == 2 ]]; then instance_id=$2
elif (( $# != 0 )); then echo 'Usage: backup [--instance jv-...]' >&2; exit 2; fi
source /usr/libexec/justvoxel/mjust/instance-selection.sh
instance_id="$(jv_select_registered_instance "${instance_id}")" || exit 1

set +e
response="$(printf '{}' | "${api_client}" POST "/v1/minecraft/instances/${instance_id}/backups/now" --data)"
rc=$?
set -e

if (( rc != 0 )); then
    if jq -e 'type == "object"' <<<"${response}" >/dev/null 2>&1; then
        message="$(jq -r '.error // .message // empty' <<<"${response}")"
        if [[ -n ${message} ]]; then
            printf 'ERROR: %s\n' "${message}" >&2
            exit 1
        fi
    fi
    echo 'ERROR: manual backup request failed through the JustVoxel Management API.' >&2
    exit 1
fi

if ! jq -e 'type == "object" and (.ok == true) and (.id | type == "string")' <<<"${response}" >/dev/null 2>&1; then
    echo 'ERROR: JustVoxel Management API returned invalid manual backup information.' >&2
    exit 1
fi

jq -e --arg id "${instance_id}" '.id == $id' <<<"${response}" >/dev/null || exit 1
echo 'Backup requested for the selected Minecraft server.'
