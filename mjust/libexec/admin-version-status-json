#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
require_root
if [[ -r ${JV_CONFIG:-/etc/justvoxel/justvoxel.conf} ]]; then
    require_config
fi

installed=''
latest_log="${DATA_PATH:-/var/lib/justvoxel/minecraft}/logs/latest.log"
if [[ -r ${latest_log} ]]; then
    installed="$(grep -Eo 'Starting minecraft server version [0-9A-Za-z._-]+' "${latest_log}" 2>/dev/null | tail -n1 | awk '{print $5}' || true)"
fi
available="$(resolve_latest_available_paper_version || true)"
available_channel=''
[[ -z ${available} ]] || available_channel="$(paper_version_build_channel "${available}" || true)"
recommended="$(resolve_latest_stable_paper_version || true)"
candidate=''
policy="${1:-${MINECRAFT_VERSION_MODE:-recommended}}"
specific="${2:-${MINECRAFT_VERSION:-}}"
bedrock="${3:-${BEDROCK_ENABLED:-no}}"
candidate_channel=''
paper_supported=false
geyser_version=''
crossplay_compatible=false
reason=''
if [[ ${bedrock} == yes ]]; then
    geyser_version="$(resolve_geyser_supported_java_version || true)"
    if [[ -n ${geyser_version} ]] && paper_version_has_stable_build "${geyser_version}"; then
        recommended="${geyser_version}"
    else
        recommended=''
    fi
fi
case "${policy}" in
    recommended) candidate="${recommended}" ;;
    latest) candidate="${available}" ;;
    pinned)
        if [[ ${specific} != LATEST ]]; then
            candidate="${specific}"
        fi
        ;;
esac
[[ -z ${candidate} ]] || candidate_channel="$(paper_version_build_channel "${candidate}" || true)"
if [[ -n ${candidate_channel} && ( ${policy} != recommended || ${bedrock} != yes || ${candidate_channel} == STABLE ) ]]; then
    paper_supported=true
else
    candidate=''
    reason='A usable Paper build for the selected version could not be confirmed.'
fi
if [[ ${bedrock} == yes ]]; then
    if [[ -z ${geyser_version} ]]; then
        reason='Geyser/Floodgate compatibility could not be confirmed.'
    elif [[ -n ${candidate} ]] && bedrock_crossplay_supports_version "${candidate}" "${geyser_version}"; then
        crossplay_compatible=true
        if [[ -n ${available} && ${available} != "${recommended}" ]]; then
            reason="Minecraft ${available} is available, but JustVoxel recommends ${recommended} while cross-play is enabled. Keep ${recommended} for cross-play, or turn off cross-play before selecting ${available}."
        fi
    elif [[ -n ${candidate} ]]; then
        reason="Minecraft ${available:-${candidate}} is available, but Geyser/Floodgate currently supports ${geyser_version}. JustVoxel recommends ${recommended} while cross-play is enabled. Keep ${geyser_version} for cross-play, or turn off cross-play before selecting ${candidate}."
    fi
fi
jq -n --arg installed "${installed}" --arg available "${available}" \
    --arg recommended "${recommended}" --arg candidate "${candidate}" \
    --arg available_channel "${available_channel}" --arg candidate_channel "${candidate_channel}" \
    --arg image_tag "${MINECRAFT_IMAGE_TAG:-stable}" --arg policy "${policy}" \
    --arg configured_version "${MINECRAFT_VERSION:-}" --arg geyser_version "${geyser_version}" \
    --arg reason "${reason}" --argjson paper_supported "${paper_supported}" \
    --argjson crossplay_compatible "${crossplay_compatible}" \
    --argjson crossplay_enabled "$([[ ${bedrock} == yes ]] && printf true || printf false)" \
    '{server_software:"Paper",installed:$installed,available:$available,available_channel:$available_channel,recommended:$recommended,selected_candidate:$candidate,candidate_channel:$candidate_channel,image_tag:$image_tag,policy:$policy,configured_version:$configured_version,
      update_available:($installed != "" and $available != "" and $installed != $available),paper_supported:$paper_supported,
      crossplay_enabled:$crossplay_enabled,geyser_supported_version:$geyser_version,crossplay_compatible:$crossplay_compatible,reason:$reason}'
