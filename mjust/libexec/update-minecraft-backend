#!/usr/bin/bash
set -Eeuo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/update-policy.sh
require_root
require_config

image="$(minecraft_image_ref)"
source /usr/libexec/justvoxel/mjust/managed-crossplay.sh
reviewed=no
expected_fingerprint=''
players_override=no
if (( $# > 0 )); then
    [[ $1 == --reviewed-stack && $# -ge 2 && $2 =~ ^sha256:[a-f0-9]{64}$ ]] || exit 1
    reviewed=yes
    expected_fingerprint="$2"
    shift 2
    if (( $# > 0 )); then
        [[ $# == 1 && $1 == --confirm-players ]] || exit 1
        players_override=yes
    fi
fi
stack_plan="$(/usr/libexec/justvoxel/mjust/admin-version-status-json)"
stack_state="$(jq -r '.stack_state' <<< "${stack_plan}")"
if [[ ${reviewed} == yes ]]; then
    [[ ${stack_state} == updates_available &&
       $(jq -r '.plan_fingerprint' <<< "${stack_plan}") == "${expected_fingerprint}" &&
       $(jq -r '.update_available' <<< "${stack_plan}") == true ]] || {
        echo 'ERROR: the reviewed server update changed; review again.' >&2; exit 1;
    }
fi
case "${stack_state}" in
    up_to_date) echo 'Up to date; no maintenance needed.'; exit 0 ;;
    waiting_for_compatibility)
        echo 'Newer Minecraft is available, but released cross-play support is not ready yet. No action is needed.'; exit 0 ;;
    updates_available)
        [[ $(jq -r '.update_available' <<< "${stack_plan}") == true ]] || {
            echo 'ERROR: server update information is unavailable; Minecraft was left untouched.' >&2; exit 1;
        } ;;
    *) echo 'ERROR: compatible server update information is unavailable; Minecraft was left untouched.' >&2; exit 1 ;;
esac
latest_mc="$(jq -r '.selected_candidate' <<< "${stack_plan}")"
latest_image_release=''
repin_game=no
old_game_mode="${MINECRAFT_VERSION_MODE}"
old_game_version="${MINECRAFT_VERSION}"
# Specific version remains explicit; Recommended follows verified compatibility.
if [[ ${MINECRAFT_VERSION_MODE} == recommended && ${MINECRAFT_VERSION} != "${latest_mc}" ]]; then
    repin_game=yes
fi
printf 'Minecraft: %s -> %s\n' "$(jq -r '.installed' <<< "${stack_plan}")" "${latest_mc}"
printf 'Geyser: %s\nFloodgate: %s\nViaVersion: Managed automatically\n' \
    "$(jq -r '.geyser_state' <<< "${stack_plan}")" "$(jq -r '.floodgate_state' <<< "${stack_plan}")"

echo
if [[ ${MINECRAFT_IMAGE_TAG} != stable && ${MINECRAFT_IMAGE_TAG} != latest ]]; then
    latest_image_release="$(resolve_latest_itzg_release || true)"
    echo "Container image tag is pinned/custom: ${MINECRAFT_IMAGE_TAG}"
    [[ -n ${latest_image_release} ]] && echo "Latest upstream itzg image release: ${latest_image_release}"
    echo 'mjust will check this exact tag for a rebuilt digest; use mjust configure to change tags.'
    echo
fi

remote_digest="$(jv_remote_platform_digest "${image}" || true)"
if [[ ! ${remote_digest} =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "ERROR: could not resolve the remote platform digest for ${image}" >&2
    exit 1
fi

[[ ${remote_digest} == "$(jq -r '.managed_image_digest' <<< "${stack_plan}")" ]] || {
    echo 'ERROR: the reviewed image changed; review again.' >&2; exit 1;
}

local_digest="$(podman image inspect "${image}" --format '{{.Digest}}' 2>/dev/null || true)"
local_id="$(podman image inspect "${image}" --format '{{.Id}}' 2>/dev/null || true)"

was_active=no
running_id=''
if systemctl is-active --quiet minecraft.service; then
    was_active=yes
    running_id="$(podman inspect minecraft --format '{{.Image}}' 2>/dev/null || true)"
    [[ -n ${running_id} ]] || { echo 'ERROR: Minecraft service is active but running image identity is unknown.' >&2; exit 1; }
fi

if [[ -z ${local_id} ]]; then
    state=image_missing
    echo 'Minecraft container: configured image is not local and must be pulled'
elif [[ ! ${local_digest} =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo 'ERROR: local Minecraft image exists but its platform digest is unknown.' >&2
    exit 1
elif [[ ${remote_digest} != ${local_digest} ]]; then
    state=update_available
    echo 'Minecraft container: UPDATE AVAILABLE for the configured tag'
elif [[ ${was_active} == yes && ${running_id} != ${local_id} ]]; then
    state=restart_needed
    echo 'Minecraft container: selected local image differs from the running image; restart is needed'
else
    state=current
    echo 'Minecraft container: CURRENT for the configured tag'
fi

echo "Remote platform digest: ${remote_digest}"
[[ -n ${local_digest} ]] && echo "Local platform digest:  ${local_digest}"
[[ -n ${running_id} ]] && echo "Running image ID:       ${running_id}"

query_players() {
    podman exec minecraft rcon-cli 'list' 2>/dev/null || true
}

approve_online_players() {
    local players="$1"
    echo "${players}"
    if grep -q 'There are 0 of' <<< "${players}"; then
        return 0
    fi
    echo 'Players appear to be online.'
    echo 'If you continue, Minecraft will use the player-aware 60-second in-game shutdown countdown.'
    if [[ ${players_override} == yes ]] || { [[ ${reviewed} != yes ]] && confirm 'Continue with maintenance anyway?'; }; then
        players_override=yes
        return 0
    fi
    echo 'Update cancelled; Minecraft was left untouched.'
    [[ ${reviewed} != yes ]] || exit 1
    exit 0
}

if [[ ${was_active} == yes ]]; then
    echo 'Checking players through RCON.'
    players="$(query_players)"
    if [[ -z ${players} ]]; then
        echo 'ERROR: could not confirm player status. Leaving Minecraft untouched.' >&2
        exit 1
    fi
    approve_online_players "${players}"
fi

if [[ ${reviewed} != yes ]] && ! confirm 'Create a cold backup and apply the selected Minecraft maintenance?'; then
    echo 'Update cancelled.'
    exit 0
fi

exec 9>"${JV_MAINTENANCE_LOCK}"
if ! flock -n 9; then
    echo 'ERROR: another JustVoxel maintenance operation is already running.' >&2
    exit 1
fi

old_local_id="${local_id}"
old_running_id="${running_id}"
maintenance_started=no
game_config_changed=no
component_staging="$(mktemp -d)"

cleanup() {
    local result=$? recovery_ok=yes
    trap - EXIT
    if (( result != 0 )) && [[ ${maintenance_started} == yes ]]; then
        # Never replace JARs underneath a running failed runtime.
        if ! systemctl stop minecraft.service; then
            echo 'ERROR: Minecraft could not be stopped for rollback; operation requires attention.' >&2
            recovery_ok=no
        else
            if ! jv_crossplay_rollback "${component_staging}"; then
                echo 'ERROR: managed Geyser/Floodgate rollback failed; previous runtime was not restored; operation requires attention.' >&2
                recovery_ok=no
            fi
            MINECRAFT_VERSION_MODE="${old_game_mode}"
            MINECRAFT_VERSION="${old_game_version}"
            if [[ ${game_config_changed} == yes ]] && ! write_main_config; then recovery_ok=no; fi
            if [[ -n ${old_running_id:-${old_local_id}} ]] && ! podman tag "${old_running_id:-${old_local_id}}" "${image}"; then recovery_ok=no; fi
            if ! render_runtime; then recovery_ok=no; fi
            # The start helper would recreate absent managed JARs. Keep the exact
            # restored state and require attention when that restart is unsafe.
            if [[ ${was_active} == yes && ${BEDROCK_ENABLED} == yes &&
                  -f ${component_staging}/replacement-started &&
                  ( -f ${component_staging}/previous/geyser.absent || -f ${component_staging}/previous/floodgate.absent ) ]]; then
                echo 'ERROR: the previous managed pair was incomplete; Minecraft cannot safely restart without changing the restored JAR state.' >&2
                recovery_ok=no
            fi
            if [[ ${recovery_ok} == yes && ${was_active} == yes ]]; then
                if ! systemctl start minecraft.service || ! wait_for_rcon 900; then recovery_ok=no; fi
            fi
        fi
        if [[ ${recovery_ok} != yes ]]; then
            echo "ERROR: previous runtime recovery is incomplete; operation requires attention. Recovery files: ${component_staging}" >&2
        fi
    fi
    if [[ ${recovery_ok} == yes ]]; then rm -rf -- "${component_staging}"; fi
    exit "${result}"
}
trap cleanup EXIT

# Resolve and verify downloads while the good runtime is still untouched.
if [[ ${BEDROCK_ENABLED} == yes ]]; then
    jv_crossplay_prepare "${component_staging}"
    for project in geyser floodgate; do
        [[ $(jq -cS ".managed_artifacts.${project}" <<< "${stack_plan}") == "$(jq -cS . "${component_staging}/${project}.json")" ]] || {
            echo 'ERROR: cross-play releases changed during preparation; review again.' >&2; exit 1;
        }
    done
fi
current_plan="$(/usr/libexec/justvoxel/mjust/admin-version-status-json)"
[[ $(jq -r '.plan_fingerprint' <<< "${current_plan}") == "$(jq -r '.plan_fingerprint' <<< "${stack_plan}")" &&
   $(jq -r '.stack_state' <<< "${current_plan}") == updates_available &&
   $(jq -r '.update_available' <<< "${current_plan}") == true ]] || {
    echo 'ERROR: server update plan changed before shutdown; review again.' >&2; exit 1;
}

if systemctl is-active --quiet minecraft.service; then
    echo 'Final player check immediately before the graceful stop.'
    players="$(query_players)"
    if [[ -z ${players} ]]; then
        echo 'ERROR: player state became unknown. Update cancelled.' >&2
        exit 1
    fi
    echo "${players}"
    if ! grep -q 'There are 0 of' <<< "${players}" && [[ ${players_override} != yes ]]; then
        echo 'A player joined after the first check.'
        echo 'Continuing will use the player-aware 60-second in-game shutdown countdown.'
        if [[ ${reviewed} != yes ]] && confirm 'Continue anyway?'; then
            players_override=yes
        else
            echo 'Update cancelled; Minecraft was left untouched.'
            [[ ${reviewed} != yes ]] || exit 1
            exit 0
        fi
    fi
fi

maintenance_started=yes
echo 'Creating pre-update cold backup.'
JUSTVOXEL_MAINTENANCE_LOCK_HELD=1 \
    /usr/libexec/justvoxel/minecraft-backup --leave-stopped

if [[ ${state} == update_available || ${state} == image_missing ]]; then
    echo "Pulling ${image}"
    podman pull "${image}"
fi

new_local_id="$(podman image inspect "${image}" --format '{{.Id}}' 2>/dev/null || true)"
new_local_digest="$(podman image inspect "${image}" --format '{{.Digest}}' 2>/dev/null || true)"
[[ -n ${new_local_id} ]] || { echo 'ERROR: selected Minecraft image is still not available locally.' >&2; exit 1; }
[[ ${new_local_digest} =~ ^sha256:[0-9a-f]{64}$ ]] || { echo 'ERROR: selected local Minecraft platform digest is unknown.' >&2; exit 1; }

# Refresh the remote digest after pulling so a tag that moved during maintenance
# is compared against its current platform manifest rather than a stale index.
remote_digest_after="$(jv_remote_platform_digest "${image}" || true)"
[[ ${remote_digest_after} =~ ^sha256:[0-9a-f]{64}$ ]] || { echo 'ERROR: could not re-check the remote Minecraft platform digest.' >&2; exit 1; }
if [[ ${new_local_digest} != "${remote_digest_after}" || ${new_local_digest} != "$(jq -r '.managed_image_digest' <<< "${stack_plan}")" ]]; then
    echo 'ERROR: pulled Minecraft image does not match the current remote platform digest.' >&2
    echo "Remote platform digest: ${remote_digest_after}" >&2
    echo "Local platform digest:  ${new_local_digest}" >&2
    exit 1
fi
remote_digest="${remote_digest_after}"

if [[ ${repin_game} == yes ]]; then
    MINECRAFT_VERSION="${latest_mc}"
    game_config_changed=yes
    write_main_config
    echo "Minecraft/Paper selected version updated to ${MINECRAFT_VERSION}."
fi

# Retire the legacy imported-binary opt-out and the container URL downloader.
if [[ ${BEDROCK_ENABLED} == yes ]]; then
    BEDROCK_MANAGED_PLUGINS=yes
    write_main_config
    jv_crossplay_install "${component_staging}"
    jv_crossplay_verify "${component_staging}"
fi
render_runtime

# A startup pass refreshes ViaVersion through the existing Modrinth integration.
# Stopped servers start temporarily for verification, then return to stopped.
systemctl start minecraft.service
if ! wait_for_rcon 900; then
    echo 'ERROR: Minecraft did not become ready after the update.' >&2
    echo "Previous image ID retained for rollback: ${old_running_id:-${old_local_id:-unknown}}" >&2
    exit 1
fi

new_running_id="$(podman inspect minecraft --format '{{.Image}}' 2>/dev/null || true)"
if [[ ${new_running_id} != ${new_local_id} ]]; then
    echo 'ERROR: Minecraft is not running the newly selected local image.' >&2
    exit 1
fi

JUSTVOXEL_MAINTENANCE_LOCK_HELD=1 /usr/libexec/justvoxel/mjust/verify-minecraft-stack "${latest_mc}"
if [[ ${BEDROCK_ENABLED} == yes ]]; then
    jv_crossplay_verify "${component_staging}"
fi

if [[ ${was_active} != yes ]]; then
    systemctl stop minecraft.service
fi

candidate_previous_id=''
if [[ -n ${old_running_id} && ${old_running_id} != ${new_local_id} ]]; then
    candidate_previous_id="${old_running_id}"
elif [[ -n ${old_local_id} && ${old_local_id} != ${new_local_id} ]]; then
    candidate_previous_id="${old_local_id}"
fi

if [[ -n ${candidate_previous_id} ]]; then
    install -d -m0700 -o root -g root "${JV_STATE_DIR}"
    older_previous_id=''
    if [[ -r ${JV_PREVIOUS_IMAGE_STATE} ]]; then
        older_previous_id="$(head -n1 "${JV_PREVIOUS_IMAGE_STATE}" 2>/dev/null || true)"
    fi

    if [[ -n ${older_previous_id} && ${older_previous_id} != ${candidate_previous_id} && ${older_previous_id} != ${new_local_id} ]]; then
        if [[ -n $(podman ps -a --filter "ancestor=${older_previous_id}" -q 2>/dev/null || true) ]]; then
            echo "Older Minecraft image ${older_previous_id} is still used by a container; leaving it in place."
        elif podman image exists "${older_previous_id}" 2>/dev/null; then
            echo "Removing Minecraft image older than the one-generation rollback copy: ${older_previous_id}"
            podman image rm "${older_previous_id}" >/dev/null || \
                echo "WARNING: could not remove older Minecraft image ${older_previous_id}; no broad image prune was attempted." >&2
        fi
    fi

    tmp_state="$(mktemp "${JV_STATE_DIR}/.minecraft-previous-image.XXXXXX")"
    printf '%s\n' "${candidate_previous_id}" > "${tmp_state}"
    chmod 0600 "${tmp_state}"
    mv -f "${tmp_state}" "${JV_PREVIOUS_IMAGE_STATE}"
    echo "Previous Minecraft image retained for rollback: ${candidate_previous_id}"
fi

rm -rf -- "${component_staging}"
trap - EXIT
echo "Minecraft maintenance completed and runtime verified. Platform digest: ${new_local_digest}"
