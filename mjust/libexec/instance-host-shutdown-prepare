#!/usr/bin/bash
set -u
# One bounded window for all independent instances; no maintenance lock while
# systemd drains services. Failed checks simply preserve the normal stop delay.
timeout 8s python3 - <<'PY'
import concurrent.futures, hashlib, json, os, re, stat, subprocess, time

root = '/etc/justvoxel/instances'
registry = '/var/lib/justvoxel/instances'
deadline = time.monotonic() + 6
pattern = re.compile(r'^jv-[a-z0-9]{6,12}$')
players = re.compile(r'^There are ([0-9]+) of a max of ([0-9]+) players online:?[ \t]*([^\r\n]*)$')

def private(path, directory=False):
    if os.path.realpath(path) != path:
        raise ValueError('path')
    info = os.lstat(path)
    if info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != (0o700 if directory else 0o600):
        raise ValueError('ownership')
    if not (stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode)):
        raise ValueError('type')

def read(path):
    private(path)
    with open(path, 'rb') as stream:
        data = stream.read(65537)
    if len(data) > 65536:
        raise ValueError('size')
    return data

def run(*args):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise ValueError('deadline')
    # stdout files bound capture even if an unhealthy tool produces excess data.
    import tempfile
    with tempfile.TemporaryFile() as output:
        subprocess.run(args, check=True, stdout=output, stderr=subprocess.DEVNULL,
                       timeout=min(2, remaining))
        output.seek(0)
        data = output.read(8193)
    if len(data) > 8192:
        raise ValueError('output')
    return data.decode('utf-8').strip()

def prepare(instance):
    try:
        if not pattern.fullmatch(instance):
            return False
        directory = root + '/' + instance
        private(directory, True)
        identity = json.loads(read(registry + '/' + instance + '.json'))
        record = json.loads(read(directory + '/config.json'))
        if identity != {'id': instance} or record.get('schema_version') != 1 or record['runtime']['id'] != instance:
            return False
        # Incomplete runtime evidence must never authorize a delay bypass.
        for key, path in [('environment_sha256', directory + '/minecraft.env'),
                          ('quadlet_sha256', '/etc/containers/systemd/minecraft-' + instance + '.container')]:
            if hashlib.sha256(read(path)).hexdigest() != record.get(key):
                return False
        container = 'minecraft-' + instance
        if run('podman', 'inspect', '--type', 'container', '--format', '{{.State.Running}}', container) != 'true':
            return True
        raw = run('podman', 'exec', container, 'rcon-cli', 'list')
        match = players.fullmatch(raw)
        if not match:
            return False
        online, maximum = int(match[1]), int(match[2])
        if not 0 <= online <= maximum <= 1000 or maximum == 0:
            return False
        names = match[3].strip()
        if online:
            return bool(names) and len(names.split(', ')) == online
        if names:
            return False
        # SIGUSR1 is itzg's graceful announcement-delay bypass, not a force kill.
        run('podman', 'kill', '--signal', 'SIGUSR1', container)
        return True
    except Exception:
        return False

try:
    if not os.path.lexists(root):
        raise SystemExit(0)
    private(root, True)
    private(registry, True)
    instances = sorted(os.listdir(root))
    if len(instances) > 1024:
        raise ValueError('count')
    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        results = list(pool.map(prepare, instances))
    if not all(results):
        print('WARNING: Some instance player states were unavailable; normal graceful shutdown delays are preserved.', flush=True)
except Exception:
    print('WARNING: Instance shutdown discovery was unavailable; normal graceful shutdown delays are preserved.', flush=True)
PY
status=$?
if (( status != 0 )); then
    echo 'WARNING: Instance shutdown preparation exceeded its safety window; normal graceful shutdown continues.' >&2
fi
exit 0
