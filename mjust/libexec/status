#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/status-lib.sh

readonly api_client=/usr/libexec/justvoxel/mjust/api-client

if (( EUID != 0 )); then
    echo 'ERROR: this operation must run as root.' >&2
    exit 1
fi

details=no
if [[ ${1:-} == --details ]]; then
    details=yes
    shift
fi
if (( $# > 0 )); then
    echo 'Usage: mjust status [--details]' >&2
    exit 2
fi

if [[ -t 1 && ${TERM:-dumb} != dumb ]]; then
    c_label=$'\033[38;5;45m'
    c_value=$'\033[97m'
    c_good=$'\033[38;5;82m'
    c_warn=$'\033[38;5;220m'
    c_bad=$'\033[38;5;196m'
    c_dim=$'\033[38;5;245m'
    c_bold=$'\033[1m'
    c_reset=$'\033[0m'
else
    c_label='' c_value='' c_good='' c_warn='' c_bad='' c_dim='' c_bold='' c_reset=''
fi

section() {
    printf '\n%s%s%s\n' "${c_bold}" "$1" "${c_reset}"
}

row() {
    local label="$1" value="$2" color="${3:-${c_value}}"
    printf '  %s%-22s%s %s%s%s\n' "${c_label}" "${label}:" "${c_reset}" "${color}" "${value}" "${c_reset}"
}

format_kib() {
    jv_status_format_kib "${1:-0}"
}

path=/v1/status
[[ ${details} == yes ]] && path='/v1/status?details=1'

set +e
response="$("${api_client}" GET "${path}")"
rc=$?
set -e
if (( rc != 0 )); then
    if jq -e 'type == "object" and (.error | type == "string")' <<<"${response}" >/dev/null 2>&1; then
        printf 'ERROR: %s\n' "$(jq -r '.error' <<<"${response}")" >&2
    else
        echo 'ERROR: status information is unavailable from the JustVoxel Management API.' >&2
    fi
    exit 1
fi

if ! jq -e '
    type == "object" and
    (.system | type == "object") and
    (.minecraft | type == "object") and
    (.backup | type == "object") and
    (.extended | type == "object")
' <<<"${response}" >/dev/null 2>&1; then
    echo 'ERROR: JustVoxel Management API returned invalid status information.' >&2
    exit 1
fi

overall="$(jq -r '.system.health // "Unknown"' <<<"${response}")"
case "${overall}" in
    Healthy) overall_color="${c_good}" ;;
    'Attention needed') overall_color="${c_bad}" ;;
    *) overall_color="${c_warn}" ;;
esac

configured="$(jq -r '.minecraft.configured // false' <<<"${response}")"
service_state="$(jq -r '.minecraft.state // "Unknown"' <<<"${response}")"
case "${service_state}" in
    Running) service_color="${c_good}" ;;
    Failed) service_color="${c_bad}" ;;
    *) service_color="${c_warn}" ;;
esac

hostname_value="$(jq -r '.extended.system.hostname // "Unknown"' <<<"${response}")"
variant="$(jq -r '.system.variant // "Unknown"' <<<"${response}")"
host_uptime="$(jv_status_format_duration "$(jq -r '.extended.system.uptime_seconds // 0' <<<"${response}")")"
physical_ram="$(format_kib "$(jq -r '.extended.system.physical_ram_kib // 0' <<<"${response}")")"
failed_count="$(jq -r '.extended.system.failed_count // 0' <<<"${response}")"
if (( failed_count == 0 )); then services_summary='Healthy - no failed services'; else services_summary="${failed_count} failed service(s)"; fi

players='Unknown'
if [[ ${service_state} == Running ]]; then
    players="$(jq -r '(.minecraft.players // 0 | tostring) + " / " + (.minecraft.max_players // 0 | tostring)' <<<"${response}")"
elif [[ ${service_state} == Stopped ]]; then
    players='Not running'
fi

host_ip="$(jq -r '.system.ipv4 // "Unknown"' <<<"${response}")"
java_port="$(jq -r '.minecraft.java_port // 0' <<<"${response}")"
bedrock_enabled="$(jq -r '.minecraft.bedrock // false' <<<"${response}")"
bedrock_port="$(jq -r '.minecraft.bedrock_port // 0' <<<"${response}")"
java_address='Unknown'
bedrock_address='Disabled'
if [[ ${configured} == true && ${java_port} != 0 ]]; then java_address="${host_ip}:${java_port}"; fi
if [[ ${bedrock_enabled} == true && ${bedrock_port} != 0 ]]; then bedrock_address="${host_ip}:${bedrock_port}"; fi

printf '%s%s================ JUSTVOXEL STATUS ================%s\n' "${c_bold}" "${c_label}" "${c_reset}"
row 'Overall' "${overall}" "${overall_color}"

section 'System'
row 'Hostname' "${hostname_value}"
row 'Variant' "${variant}"
row 'Uptime' "${host_uptime}"
row 'Physical RAM' "${physical_ram}"
if (( failed_count == 0 )); then row 'System services' "${services_summary}" "${c_good}"; else row 'System services' "${services_summary}" "${c_bad}"; fi

section 'Minecraft'
row 'State' "${service_state}" "${service_color}"
row 'Players' "${players}"
row 'Version policy' "$(jq -r '.extended.minecraft.version_policy // "Unknown"' <<<"${response}")"
bedrock_state="$(jq -r '.extended.minecraft.bedrock_state // "Disabled"' <<<"${response}")"
if [[ ${bedrock_enabled} == true ]]; then
    if [[ ${bedrock_state} == Ready ]]; then row 'Bedrock cross-play' "${bedrock_state}" "${c_good}"; else row 'Bedrock cross-play' "${bedrock_state}" "${c_warn}"; fi
else
    row 'Bedrock cross-play' 'Disabled' "${c_dim}"
fi
row 'Java address' "${java_address}"
row 'Bedrock address' "${bedrock_address}"
row 'Memory' "$(jq -r '.extended.minecraft.memory_current // "Unknown"' <<<"${response}") / $(jq -r '.extended.minecraft.container_max // "Unknown"' <<<"${response}")"
row 'Java heap' "$(jq -r '.extended.minecraft.java_heap // "Unknown"' <<<"${response}")"
if [[ ${service_state} == Running ]]; then
    row 'Minecraft uptime' "$(jv_status_format_duration "$(jq -r '.extended.minecraft.uptime_seconds // 0' <<<"${response}")")"
else
    row 'Minecraft uptime' 'Not running'
fi

section 'Network'
row 'Interface' "$(jq -r '.extended.network.interface // "Unknown"' <<<"${response}")"
row 'IPv4' "${host_ip}"
row 'Gateway' "$(jq -r '.extended.network.gateway // "Unknown"' <<<"${response}")"
row 'DNS' "$(jq -r '.extended.network.dns // "Unknown"' <<<"${response}")"

section 'Storage'
system_source="$(jq -r '.extended.storage.system.source // "Unknown"' <<<"${response}")"
system_mount="$(jq -r '.extended.storage.system.mount // "Unknown"' <<<"${response}")"
system_available="$(format_kib "$(jq -r '.extended.storage.system.available_kib // 0' <<<"${response}")")"
system_used="$(jq -r '.extended.storage.system.used // "Unknown"' <<<"${response}")"
row 'System/container' "${system_source} at ${system_mount}"
row 'Available' "${system_available} (${system_used} used)"

if [[ ${configured} == true ]]; then
    data_path="$(jq -r '.extended.storage.data.path // "Unknown"' <<<"${response}")"
    backup_path="$(jq -r '.extended.storage.backup.path // "Unknown"' <<<"${response}")"
    row 'Minecraft data' "${data_path}"
    if [[ $(jq -r '.extended.storage.data.shares_system // false' <<<"${response}") == true ]]; then
        printf '    %sShares the system/container filesystem.%s\n' "${c_dim}" "${c_reset}"
    else
        row 'Data filesystem' "$(jq -r '.extended.storage.data.source // "Unknown"' <<<"${response}") at $(jq -r '.extended.storage.data.mount // "Unknown"' <<<"${response}") - $(format_kib "$(jq -r '.extended.storage.data.available_kib // 0' <<<"${response}")") available ($(jq -r '.extended.storage.data.used // "Unknown"' <<<"${response}") used)"
    fi
    row 'Backup storage' "${backup_path}"
    if [[ $(jq -r '.extended.storage.backup.shares_data // false' <<<"${response}") == true ]]; then
        printf '    %sShares the same filesystem as Minecraft data.%s\n' "${c_dim}" "${c_reset}"
    else
        row 'Backup filesystem' "$(jq -r '.extended.storage.backup.source // "Unknown"' <<<"${response}") at $(jq -r '.extended.storage.backup.mount // "Unknown"' <<<"${response}") - $(format_kib "$(jq -r '.extended.storage.backup.available_kib // 0' <<<"${response}")") available ($(jq -r '.extended.storage.backup.used // "Unknown"' <<<"${response}") used)"
    fi
else
    row 'Minecraft data' 'Not configured' "${c_dim}"
    row 'Backup storage' 'Not configured' "${c_dim}"
fi

section 'Backups'
backup_enabled="$(jq -r '.backup.enabled // false' <<<"${response}")"
if [[ ${backup_enabled} == true ]]; then row 'Automatic backups' 'Enabled' "${c_good}"; else row 'Automatic backups' 'Disabled' "${c_dim}"; fi
row 'Last backup' "$(jq -r '.extended.backup.last_summary // .backup.last // "Unknown"' <<<"${response}")"
row 'Next backup' "$(jq -r '.backup.next // "Unknown"' <<<"${response}")"

section 'Container'
row 'Channel' "$(jq -r '.extended.minecraft.image_channel // "Unknown"' <<<"${response}")"
row 'Image' "$(jq -r '.extended.minecraft.image_ref // "Unknown"' <<<"${response}")"

if [[ ${details} == yes ]]; then
    section 'Advanced details'
    printf '%sRaw Minecraft version:%s %s\n' "${c_label}" "${c_reset}" "$(jq -r '.minecraft.version // "Unknown"' <<<"${response}")"

    echo
    echo 'Failed services'
    jq -r '.extended.details.failed_services // ""' <<<"${response}"
    echo
    echo 'Minecraft systemd'
    jq -r '.extended.details.minecraft_systemd // ""' <<<"${response}"
    echo
    echo 'Podman'
    jq -r '.extended.details.podman // ""' <<<"${response}"
    echo
    echo 'Storage'
    jq -r '.extended.details.storage // ""' <<<"${response}"
    echo
    echo 'Network'
    jq -r '.extended.details.network // ""' <<<"${response}"
fi
