#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/migration-common.sh
require_root
source /usr/libexec/justvoxel/mjust/migration-instance.sh
[[ ${1:-} == --instance && ${2:-} =~ ^jv-[a-z0-9]{6,12}$ ]] || { echo 'ERROR: --instance jv-... is required.' >&2; exit 2; }
jv_migration_load_instance "$2" migration-recovery || exit 1
shift 2
request="$(cat)"
jq -e 'type=="object" and (.transaction|type=="string") and (.state_identity|type=="string")' >/dev/null <<< "${request}"
transaction="$(jq -r '.transaction' <<< "${request}")"
expected_identity="$(jq -r '.state_identity' <<< "${request}")"
plan="$(printf '%s\n' "$(jq -cn --arg transaction "${transaction}" '{transaction:$transaction}')" | /usr/libexec/justvoxel/mjust/admin-migration-recovery-json --instance "${JV_INSTANCE_ID}" plan)"
[[ $(jq -r '.ok' <<< "${plan}") == true ]] || { echo "recovery plan is no longer valid" >&2; exit 1; }
actual_identity="$(jq -r '.context.state_identity' <<< "${plan}")"
[[ ${actual_identity} == "${expected_identity}" ]] || { echo "recovery state changed after review" >&2; exit 1; }
phase="$(jq -r '.normalized.phase' <<< "${plan}")"
printf '%s\n' '{"event":"progress","state":"validating","stage":"recovery_preflight","status":"Revalidating retained migration recovery state."}'
exec 9>"${JV_MAINTENANCE_LOCK}"
flock -n 9 || { echo 'Another Minecraft maintenance operation is active.' >&2; exit 1; }
jv_migration_validate_evidence "${transaction}" || exit 1
if [[ ${phase} == validated ]]; then
    jv_migration_validate_current >&2
else
    jv_migration_recover_selected "${transaction}" >&2
fi
printf '%s\n' '{"event":"progress","state":"running","stage":"recovery_finalize","status":"Removing retained migration recovery transaction."}'
rm -rf -- "${transaction}"
jv_migration_clear_recovery "${transaction}"
printf '%s\n' '{"event":"progress","state":"verifying","stage":"recovery_verify","status":"Verifying recovery state was finalized."}'
[[ ! -e ${transaction} ]] || { echo "recovery transaction still exists" >&2; exit 1; }
key="$(jv_migration_recovery_key "${transaction}")"
[[ ! -e ${JV_MIGRATION_RECOVERY_ROOT}/${key} ]] || { echo "recovery registry still references finalized transaction" >&2; exit 1; }
printf '%s\n' '{"event":"result","outcome":"succeeded","status":"Migration recovery finalized successfully."}'
