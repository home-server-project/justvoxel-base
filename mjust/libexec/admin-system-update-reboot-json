#!/usr/bin/bash
set -euo pipefail

source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/system-update-api.sh
readonly shutdown_helper=/usr/libexec/justvoxel/mjust/instance-host-shutdown-prepare
require_root

readonly state_file="/run/justvoxel/system-update-reboot.json"
readonly worker="/usr/libexec/justvoxel/system-update-reboot-worker"
readonly unit_name="justvoxel-update-reboot"

emit_state() {
    if [[ -r ${state_file} ]] && jq -e 'type == "object" and (.ok == true) and (.state | type == "string")' "${state_file}" >/dev/null 2>&1; then
        cat "${state_file}"
        return
    fi
    jq -cn '{ok:true,state:"idle",accepted:false,confirmation_required:false}'
}

emit_error() {
    local reason="$1" message="$2"
    jq -cn --arg reason "${reason}" --arg message "${message}" '{ok:false,state:"failed",accepted:false,confirmation_required:false,reason:$reason,message:$message}'
}

request_reboot() {
    local confirm_players=no backup_minecraft=no warning_seconds=60 expected_digest=""
    local instances online=0 players_json='[]'

    shift
    while (( $# > 0 )); do
        case "$1" in
            --staged-digest=sha256:*)
                expected_digest="${1#--staged-digest=}"
                [[ ${expected_digest} =~ ^sha256:[a-f0-9]{64}$ ]] || { emit_error invalid_stage 'Invalid staged update.'; return 2; } ;;
            --confirm-players) confirm_players=yes ;;
            --backup-minecraft) backup_minecraft=yes ;;
            --warning-seconds=10) warning_seconds=10 ;;
            --warning-seconds=60) warning_seconds=60 ;;
            *)
                emit_error invalid_option 'Invalid system update reboot option.'
                return 2
                ;;
        esac
        shift
    done

    if systemctl is-active --quiet "${unit_name}.service" 2>/dev/null; then
        emit_error workflow_active 'A system update reboot workflow is already running.'
        return 2
    fi

    if ! instances="$("${shutdown_helper}" check)"; then
        emit_error player_status_unavailable 'Could not confirm Minecraft player status through RCON.'
        return 3
    fi
    online="$(jq '.online' <<<"${instances}")"
    players_json="$(jq '.players' <<<"${instances}")"
    if (( online > 0 )) && [[ ${confirm_players} != yes ]]; then
        jq -cn --argjson online "${online}" --argjson players "${players_json}" --argjson warning "${warning_seconds}" --argjson backup "$([[ ${backup_minecraft} == yes ]] && echo true || echo false)" \
            '{ok:false,state:"confirmation_required",accepted:false,confirmation_required:true,reason:"players_online",online:$online,players:$players,warning_seconds:$warning,backup_minecraft:$backup}'
        return 10
    fi

    local update_status staged_digest
    if ! update_status="$(jv_system_update_get)" || ! staged_digest="$(jq -er 'select(.reboot_required == true) | .staged.digest | select(test("^sha256:[a-f0-9]{64}$"))' <<<"${update_status}")"; then
        emit_error stage_unavailable 'No verified staged update is ready. Refresh and try again.'
        return 3
    fi

    if [[ -n ${expected_digest} && ${expected_digest} != "${staged_digest}" ]]; then
        emit_error stage_changed 'The staged update changed. Refresh and try again.'
        return 3
    fi

    install -d -m0755 /run/justvoxel
    jq -cn --argjson warning "${warning_seconds}" --argjson backup "$([[ ${backup_minecraft} == yes ]] && echo true || echo false)"         '{ok:true,state:"queued",accepted:true,confirmation_required:false,warning_seconds:$warning,backup_minecraft:$backup}' > "${state_file}.tmp"
    mv -f "${state_file}.tmp" "${state_file}"

    if ! systemd-run --quiet --collect --unit="${unit_name}"         --setenv="JV_UPDATE_REBOOT_DIGEST=${staged_digest}" --setenv="JV_UPDATE_REBOOT_BACKUP=${backup_minecraft}"         --setenv="JV_UPDATE_REBOOT_WARNING_SECONDS=${warning_seconds}"         "${worker}"; then
        jq -cn '{ok:true,state:"failed",accepted:false,confirmation_required:false,reason:"action_failed",message:"System update reboot workflow could not be started."}' > "${state_file}.tmp"
        mv -f "${state_file}.tmp" "${state_file}"
        emit_error action_failed 'System update reboot workflow could not be started.'
        return 4
    fi

    jq -cn --argjson warning "${warning_seconds}" --argjson backup "$([[ ${backup_minecraft} == yes ]] && echo true || echo false)"         '{ok:true,state:"queued",accepted:true,confirmation_required:false,warning_seconds:$warning,backup_minecraft:$backup,message:"Reboot workflow started."}'
}

case "${1:-}" in
    status)
        [[ $# -eq 1 ]] || { echo 'Usage: admin-system-update-reboot-json status' >&2; exit 2; }
        emit_state
        ;;
    request)
        request_reboot "$@"
        ;;
    *)
        echo 'Usage: admin-system-update-reboot-json {status|request [--confirm-players] [--backup-minecraft] [--warning-seconds=10|60]}' >&2
        exit 2
        ;;
esac
