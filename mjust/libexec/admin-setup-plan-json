#!/usr/bin/bash
set -euo pipefail

source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/storage-common-base.sh
require_root

readonly SETUP_PLAN_SCHEMA_VERSION=v1
readonly SETUP_DEFAULT_DATA_PATH=/var/lib/justvoxel/minecraft
readonly SETUP_DEFAULT_BACKUP_PATH=/var/lib/justvoxel/backups
readonly SETUP_MIN_SYSTEM_RESERVE_MIB=1024
readonly SETUP_RECOMMENDED_SYSTEM_RESERVE_MIB=2048

json_error() {
    local message="$1" code="${2:-invalid_request}"
    jq -n --arg schema_version "${SETUP_PLAN_SCHEMA_VERSION}" --arg code "${code}" --arg error "${message}" \
        '{ok:false,schema_version:$schema_version,code:$code,error:$error,warnings:[]}'
}

warning_add() {
    local warnings="$1" code="$2" message="$3"
    jq -c --arg code "${code}" --arg message "${message}" '. + [{code:$code,message:$message}]' <<< "${warnings}"
}

system_memory_mib() {
    awk '/^MemTotal:/ {printf "%d\n", $2 / 1024; exit}' /proc/meminfo 2>/dev/null || printf '0\n'
}

normalize_path() {
    realpath -m -- "$1" 2>/dev/null || true
}

path_is_within() {
    local path="${1%/}" mountpoint="${2%/}"
    [[ ${path} == "${mountpoint}" || ${path} == "${mountpoint}/"* ]]
}

paths_overlap() {
    local first="${1%/}" second="${2%/}"
    [[ ${first} == "${second}" || ${first} == "${second}/"* || ${second} == "${first}/"* ]]
}

parent_disk() {
    local device real
    device="$1"
    real="$(readlink -f -- "${device}" 2>/dev/null || true)"
    [[ -n ${real} ]] || return 0
    lsblk -s -npo NAME,TYPE "${real}" 2>/dev/null | awk '$2 == "disk" {print $1; exit}'
}

device_metadata_json() {
    local device="$1" parent model transport size fstype uuid source mounted system_disk=false
    parent="$(parent_disk "${device}")"
    model="$(lsblk -dnro MODEL "${device}" 2>/dev/null | xargs || true)"
    transport="$(lsblk -dnro TRAN "${parent:-${device}}" 2>/dev/null | xargs || true)"
    size="$(lsblk -bdnro SIZE "${device}" 2>/dev/null | head -n1)"
    size="${size:-0}"
    fstype="$(blkid -s TYPE -o value "${device}" 2>/dev/null || true)"
    uuid="$(blkid -s UUID -o value "${device}" 2>/dev/null || true)"
    mounted="$(lsblk -nro MOUNTPOINT "${device}" 2>/dev/null | sed '/^$/d' | head -n1)"
    source=''
    if [[ -n ${mounted} ]]; then
        source="$(findmnt -n -o SOURCE --target "${mounted}" 2>/dev/null || true)"
    fi
    if [[ -n ${parent} ]] && storage_disk_is_system "${parent}"; then
        system_disk=true
    fi
    jq -n \
        --arg device "$(readlink -f -- "${device}" 2>/dev/null || printf '%s' "${device}")" \
        --arg parent "${parent}" \
        --arg model "${model}" \
        --arg transport "${transport}" \
        --arg filesystem "${fstype}" \
        --arg uuid "${uuid}" \
        --arg mounted_at "${mounted}" \
        --arg source "${source}" \
        --argjson size_bytes "${size}" \
        --argjson system_disk "${system_disk}" \
        '{device:$device,parent_disk:$parent,model:$model,transport:$transport,size_bytes:$size_bytes,filesystem:$filesystem,uuid:$uuid,mounted_at:$mounted_at,source:$source,system_disk:$system_disk}'
}

validate_request_shape() {
    local request="$1"
    jq -e '
      type == "object" and
      ((keys - ["server","minecraft","storage","backups"]) | length == 0) and
      (.server|type == "object") and
      (.minecraft|type == "object") and
      (.storage|type == "object") and
      (.backups|type == "object") and
      ((.server|keys) - ["motd","max_players","bedrock_enabled","timezone"] | length == 0) and
      ((.minecraft|keys) - ["java_memory","container_memory","java_port","bedrock_port","image_tag","version_policy","version"] | length == 0) and
      ((.storage|keys) - ["type","path","device","mount_point"] | length == 0) and
      ((.backups|keys) - ["automatic","daily_time","keep","type","path","device","mount_point","source","username","domain"] | length == 0) and
      (.server.motd|type == "string") and
      (.server.max_players|type == "number") and
      (.server.bedrock_enabled|type == "boolean") and
      (.server.timezone|type == "string") and
      (.minecraft.java_memory|type == "string") and
      (.minecraft.container_memory|type == "string") and
      (.minecraft.java_port|type == "number") and
      (.minecraft.bedrock_port|type == "number") and
      (.minecraft.image_tag|type == "string") and
      (.minecraft.version_policy|type == "string") and
      ((.minecraft.version // "")|type == "string") and
      (.storage.type|type == "string") and
      (.storage.path|type == "string") and
      ((.storage.device // "")|type == "string") and
      ((.storage.mount_point // "")|type == "string") and
      (.backups.automatic|type == "boolean") and
      (.backups.daily_time|type == "string") and
      (.backups.keep|type == "number") and
      (.backups.type|type == "string") and
      (.backups.path|type == "string") and
      ((.backups.device // "")|type == "string") and
      ((.backups.mount_point // "")|type == "string") and
      ((.backups.source // "")|type == "string") and
      ((.backups.username // "")|type == "string") and
      ((.backups.domain // "")|type == "string") and
      ([paths | select((last|type) == "string" and ((last|ascii_downcase)|contains("password")))] | length == 0)
    ' >/dev/null 2>&1 <<< "${request}"
}

port_in_use() {
    local protocol="$1" port="$2"
    command -v ss >/dev/null 2>&1 || return 1
    if [[ ${protocol} == tcp ]]; then
        ss -H -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:|\\])${port}$"
    else
        ss -H -lun 2>/dev/null | awk '{print $5}' | grep -Eq "(^|:|\\])${port}$"
    fi
}

validate_local_target() {
    local purpose="$1" device="$2" requested_mount="$3" requested_path="$4"
    local mounted mountpoint fstype uuid metadata actual_source normalized_path

    storage_validate_partition "${device}" >/dev/null 2>&1 || return 10
    fstype="$(blkid -s TYPE -o value "${device}" 2>/dev/null || true)"
    case "${fstype}" in
        xfs|ext4|btrfs) ;;
        *) return 11 ;;
    esac
    uuid="$(blkid -s UUID -o value "${device}" 2>/dev/null || true)"
    [[ -n ${uuid} ]] || return 12

    while IFS= read -r mounted; do
        [[ -n ${mounted} ]] || continue
        storage_mount_is_critical "${mounted}" && return 13
    done < <(lsblk -nro MOUNTPOINT "${device}" 2>/dev/null | sed '/^$/d')

    mounted="$(lsblk -nro MOUNTPOINT "${device}" 2>/dev/null | sed '/^$/d' | head -n1)"
    if [[ -n ${mounted} ]]; then
        mountpoint="$(normalize_path "${mounted}")"
        [[ -n ${mountpoint} ]] || return 14
        [[ $(normalize_path "${requested_mount}") == "${mountpoint}" ]] || return 15
        actual_source="$(findmnt -n -o SOURCE --target "${mountpoint}" 2>/dev/null || true)"
    else
        mountpoint="$(normalize_path "${requested_mount}")"
        [[ -n ${mountpoint} ]] || return 14
        storage_validate_mountpoint_path "${mountpoint}" >/dev/null 2>&1 || return 14
        if mountpoint -q -- "${mountpoint}"; then
            return 16
        fi
        actual_source=""
    fi

    normalized_path="$(normalize_path "${requested_path}")"
    [[ -n ${normalized_path} ]] || return 17
    validate_storage_path "${normalized_path}" || return 17
    path_is_within "${normalized_path}" "${mountpoint}" || return 18

    metadata="$(device_metadata_json "${device}")"
    jq -n \
        --arg type partition \
        --arg path "${normalized_path}" \
        --arg mount_point "${mountpoint}" \
        --arg expected_uuid "${uuid}" \
        --arg expected_source "${actual_source}" \
        --arg purpose "${purpose}" \
        --argjson device_meta "${metadata}" \
        '{type:$type,path:$path,mount_point:$mount_point,expected_uuid:$expected_uuid,expected_source:$expected_source,purpose:$purpose} + $device_meta'
}

local_target_error() {
    case "$1" in
        10) printf 'Choose a writable local partition that still exists.' ;;
        11) printf 'Existing local storage must use XFS, ext4, or Btrfs.' ;;
        12) printf 'The selected local filesystem has no usable UUID.' ;;
        13) printf 'Root, boot, EFI, and /var filesystems cannot be selected as Minecraft or backup storage.' ;;
        14) printf 'Choose a safe absolute mount point for the selected filesystem.' ;;
        15) printf 'The selected filesystem is already mounted somewhere else. Use its current mount point.' ;;
        16) printf 'The requested mount point is already occupied by another filesystem.' ;;
        17) printf 'Choose a safe absolute data directory inside the selected filesystem.' ;;
        18) printf 'The selected data directory must be inside the selected filesystem mount point.' ;;
        *) printf 'The selected local filesystem could not be validated safely.' ;;
    esac
}

validate_nfs_source() {
    local source="$1"
    [[ -n ${source} && ${source} != *[[:space:]]* && ${source} =~ ^[^:]+:.+ ]]
}

validate_smb_source() {
    local source="$1" rest server share
    [[ ${source} == //* && ${source} != *[[:space:]]* ]] || return 1
    rest="${source#//}"
    server="${rest%%/*}"
    share="${rest#*/}"
    [[ -n ${server} && -n ${share} && ${share} != "${rest}" ]]
}

validate_network_target() {
    local type="$1" source="$2" requested_mount="$3" requested_path="$4" username="$5" domain="$6"
    local mountpoint path
    mountpoint="$(normalize_path "${requested_mount}")"
    path="$(normalize_path "${requested_path}")"
    [[ -n ${mountpoint} && -n ${path} ]] || return 20
    storage_validate_mountpoint_path "${mountpoint}" >/dev/null 2>&1 || return 20
    validate_storage_path "${path}" || return 21
    path_is_within "${path}" "${mountpoint}" || return 22

    case "${type}" in
        nfs)
            validate_nfs_source "${source}" || return 23
            ;;
        smb)
            validate_smb_source "${source}" || return 24
            [[ -n ${username} ]] || return 25
            validate_simple_text "${username}" && validate_simple_text "${domain}" || return 26
            [[ ${username} != *$'\t'* && ${domain} != *$'\t'* ]] || return 26
            ;;
        *) return 27 ;;
    esac

    jq -n \
        --arg type "${type}" \
        --arg path "${path}" \
        --arg mount_point "${mountpoint}" \
        --arg source "${source}" \
        --arg username "${username}" \
        --arg domain "${domain}" \
        --argjson credentials_required "$([[ ${type} == smb ]] && printf true || printf false)" \
        '{type:$type,path:$path,mount_point:$mount_point,source:$source,username:$username,domain:$domain,credentials_required:$credentials_required,expected_uuid:"",expected_source:$source,device:"",parent_disk:"",model:"",transport:"",size_bytes:0,filesystem:"",mounted_at:"",system_disk:false}'
}

network_target_error() {
    case "$1" in
        20) printf 'Choose a safe absolute mount point for the network backup destination.' ;;
        21) printf 'Choose a safe absolute backup directory.' ;;
        22) printf 'The backup directory must be inside the network mount point.' ;;
        23) printf 'NFS source must look like server:/export and cannot contain spaces.' ;;
        24) printf 'SMB source must look like //server/share and cannot contain spaces.' ;;
        25) printf 'SMB username is required. The password is requested only when setup is executed.' ;;
        26) printf 'SMB username or domain contains unsupported control characters.' ;;
        *) printf 'The network backup destination could not be validated.' ;;
    esac
}

request="$(cat)"
if ! jq -e . >/dev/null 2>&1 <<< "${request}" || ! validate_request_shape "${request}"; then
    json_error 'Setup request does not match the JustVoxel first-run planning schema.' schema_error
    exit 0
fi

if [[ -e ${JV_CONFIG} || -e ${JV_QUADLET} ]]; then
    json_error 'JustVoxel is already configured. First-run setup planning is available only before the initial configuration is created.' already_configured
    exit 0
fi

motd="$(jq -r '.server.motd' <<< "${request}")"
max_players="$(jq -r '.server.max_players' <<< "${request}")"
bedrock_enabled="$(jq -r '.server.bedrock_enabled' <<< "${request}")"
timezone="$(jq -r '.server.timezone' <<< "${request}")"
java_memory="$(jq -r '.minecraft.java_memory' <<< "${request}")"
container_memory="$(jq -r '.minecraft.container_memory' <<< "${request}")"
java_port="$(jq -r '.minecraft.java_port' <<< "${request}")"
bedrock_port="$(jq -r '.minecraft.bedrock_port' <<< "${request}")"
image_tag="$(jq -r '.minecraft.image_tag' <<< "${request}")"
version_policy="$(jq -r '.minecraft.version_policy' <<< "${request}")"
version="$(jq -r '.minecraft.version // ""' <<< "${request}")"
storage_type="$(jq -r '.storage.type' <<< "${request}")"
storage_path="$(jq -r '.storage.path' <<< "${request}")"
storage_device="$(jq -r '.storage.device // ""' <<< "${request}")"
storage_mount="$(jq -r '.storage.mount_point // ""' <<< "${request}")"
backup_automatic="$(jq -r '.backups.automatic' <<< "${request}")"
backup_daily_time="$(jq -r '.backups.daily_time' <<< "${request}")"
backup_keep="$(jq -r '.backups.keep' <<< "${request}")"
backup_type="$(jq -r '.backups.type' <<< "${request}")"
backup_path="$(jq -r '.backups.path' <<< "${request}")"
backup_device="$(jq -r '.backups.device // ""' <<< "${request}")"
backup_mount="$(jq -r '.backups.mount_point // ""' <<< "${request}")"
backup_source="$(jq -r '.backups.source // ""' <<< "${request}")"
backup_username="$(jq -r '.backups.username // ""' <<< "${request}")"
backup_domain="$(jq -r '.backups.domain // ""' <<< "${request}")"

warnings='[]'

read -r minecraft_uid minecraft_gid minecraft_id_source < <(resolve_minecraft_ids)
validate_nonroot_id "${minecraft_uid}" && validate_nonroot_id "${minecraft_gid}" || { json_error 'Minecraft runtime identity could not be resolved safely.' invalid_minecraft; exit 0; }

validate_simple_text "${motd}" || { json_error 'Server welcome message must be a single line.' invalid_server; exit 0; }
validate_positive_int "${max_players}" || { json_error 'Maximum players must be a positive integer.' invalid_server; exit 0; }
[[ -n ${timezone} && ${timezone} != /* && ${timezone} != *..* && -e /usr/share/zoneinfo/${timezone} ]] || { json_error 'Timezone was not found on this JustVoxel system.' invalid_server; exit 0; }

validate_memory "${java_memory}" && validate_memory "${container_memory}" || { json_error 'Memory values must use a size such as 4G or 4096M.' invalid_minecraft; exit 0; }
java_memory="${java_memory^^}"
container_memory="${container_memory^^}"
java_mib="$(memory_to_mib "${java_memory}")"
container_mib="$(memory_to_mib "${container_memory}")"
(( container_mib > java_mib )) || { json_error 'Maximum Minecraft memory must be larger than Minecraft game memory.' invalid_minecraft; exit 0; }
total_mib="$(system_memory_mib)"
remaining_mib=$(( total_mib - container_mib ))
if (( total_mib > 0 && remaining_mib < SETUP_MIN_SYSTEM_RESERVE_MIB )); then
    json_error 'Maximum Minecraft memory must leave at least 1 GiB for JustVoxel and system services.' invalid_minecraft
    exit 0
fi
if (( total_mib > 0 && remaining_mib < SETUP_RECOMMENDED_SYSTEM_RESERVE_MIB )); then
    warnings="$(warning_add "${warnings}" low_system_reserve 'Less than the recommended 2 GiB remains for JustVoxel and system services.')"
fi

validate_port "${java_port}" || { json_error 'Minecraft Java port must be between 1 and 65535.' invalid_minecraft; exit 0; }
validate_port "${bedrock_port}" || { json_error 'Bedrock UDP port must be between 1 and 65535.' invalid_minecraft; exit 0; }
if port_in_use tcp "${java_port}"; then
    json_error "Minecraft Java TCP port ${java_port} is already in use on this appliance." port_conflict
    exit 0
fi
if [[ ${bedrock_enabled} == true ]] && port_in_use udp "${bedrock_port}"; then
    json_error "Bedrock UDP port ${bedrock_port} is already in use on this appliance." port_conflict
    exit 0
fi

if [[ -z ${image_tag} || ! ${image_tag} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    json_error 'Minecraft container channel or tag is invalid.' invalid_minecraft
    exit 0
fi
image_rc=0
if validate_minecraft_image_tag "${image_tag}"; then
    :
else
    image_rc=$?
    if (( image_rc == 2 )); then
        json_error 'Upstream marks that Minecraft container tag as deprecated.' invalid_minecraft
    else
        json_error 'Minecraft container tag could not be validated against the upstream registry.' upstream_unavailable
    fi
    exit 0
fi

requested_bedrock_enabled="${bedrock_enabled}"
geyser_supported_version=''
bedrock_compatibility_version=''
if [[ ${requested_bedrock_enabled} == true ]]; then
    geyser_supported_version="$(resolve_geyser_supported_java_version || true)"
fi

case "${version_policy}" in
    recommended)
        if [[ ${requested_bedrock_enabled} == true && -n ${geyser_supported_version} ]] && paper_version_has_stable_build "${geyser_supported_version}"; then
            version="${geyser_supported_version}"
        else
            version="$(resolve_latest_stable_paper_version || true)"
        fi
        [[ -n ${version} ]] || { json_error 'Could not resolve a stable Paper-backed Minecraft version.' upstream_unavailable; exit 0; }
        bedrock_compatibility_version="${version}"
        resolved_version_policy=pinned
        ;;
    latest)
        if [[ ${requested_bedrock_enabled} == true ]]; then
            bedrock_compatibility_version="$(resolve_latest_stable_paper_version || true)"
        fi
        resolved_version_policy=latest
        version=LATEST
        warnings="$(warning_add "${warnings}" moving_minecraft_version 'Always newest can move the Minecraft/Paper version when Minecraft starts. Recommended version pins the reviewed version instead.')"
        ;;
    pinned)
        if [[ -z ${version} || ${version} == LATEST || ! ${version} =~ ^[0-9A-Za-z._-]+$ ]]; then
            json_error 'Specific Minecraft version is invalid.' invalid_minecraft
            exit 0
        fi
        if ! paper_version_has_stable_build "${version}"; then
            json_error 'PaperMC did not confirm a stable build for that Minecraft version.' invalid_minecraft
            exit 0
        fi
        bedrock_compatibility_version="${version}"
        resolved_version_policy=pinned
        ;;
    *)
        json_error 'Minecraft version choice is invalid.' invalid_minecraft
        exit 0
        ;;
esac

if [[ ${requested_bedrock_enabled} == true ]]; then
    if [[ -z ${geyser_supported_version} || -z ${bedrock_compatibility_version} ]]; then
        bedrock_enabled=false
        warnings="$(warning_add "${warnings}" bedrock_compatibility_unavailable 'Bedrock cross-play was turned off because JustVoxel could not confirm the current Geyser/Floodgate Minecraft compatibility. Java server setup can continue. Come back later and enable Bedrock cross-play after compatibility can be checked again.')"
    elif ! bedrock_crossplay_supports_version "${bedrock_compatibility_version}" "${geyser_supported_version}"; then
        bedrock_enabled=false
        warnings="$(warning_add "${warnings}" bedrock_version_unsupported "Bedrock cross-play was turned off because Geyser/Floodgate currently supports Minecraft ${geyser_supported_version}, while this setup uses ${bedrock_compatibility_version}. Java server setup can continue. Come back later and enable Bedrock cross-play after Geyser/Floodgate adds support for this Minecraft version.")"
    elif [[ ${version_policy} == latest ]]; then
        warnings="$(warning_add "${warnings}" bedrock_moving_version "Bedrock cross-play is compatible with Minecraft ${bedrock_compatibility_version} now, but Always newest can move to a newer Minecraft version before Geyser/Floodgate catches up.")"
    fi
fi

storage_json=''
case "${storage_type}" in
    system)
        normalized_storage_path="$(normalize_path "${storage_path}")"
        if [[ ${normalized_storage_path} != "${SETUP_DEFAULT_DATA_PATH}" ]]; then
            json_error "System Minecraft storage uses ${SETUP_DEFAULT_DATA_PATH}." invalid_storage
            exit 0
        fi
        storage_json="$(jq -n --arg path "${SETUP_DEFAULT_DATA_PATH}" '{type:"system",path:$path,device:"",parent_disk:"",model:"JustVoxel system storage",transport:"",size_bytes:0,filesystem:"",mount_point:"",expected_uuid:"",expected_source:"",mounted_at:"",system_disk:true}')"
        ;;
    partition)
        set +e
        storage_json="$(validate_local_target data "${storage_device}" "${storage_mount}" "${storage_path}")"
        storage_rc=$?
        set -e
        if (( storage_rc != 0 )); then
            json_error "$(local_target_error "${storage_rc}")" invalid_storage
            exit 0
        fi
        ;;
    *)
        json_error 'Minecraft storage must use JustVoxel system storage or an existing local filesystem.' invalid_storage
        exit 0
        ;;
esac

validate_positive_int "${backup_keep}" || { json_error 'Backup retention must be a positive integer.' invalid_backup; exit 0; }
normalized_daily_time="$(normalize_daily_backup_time "${backup_daily_time}" 2>/dev/null || true)"
[[ -n ${normalized_daily_time} ]] || { json_error 'Automatic backup time must use HH:MM, for example 04:30.' invalid_backup; exit 0; }
backup_schedule="$(daily_backup_schedule_from_time "${normalized_daily_time}")"
systemd-analyze calendar "${backup_schedule}" >/dev/null 2>&1 || { json_error 'The generated automatic backup schedule was rejected by systemd.' invalid_backup; exit 0; }

backup_json=''
case "${backup_type}" in
    system)
        normalized_backup_path="$(normalize_path "${backup_path}")"
        if [[ ${normalized_backup_path} != "${SETUP_DEFAULT_BACKUP_PATH}" ]]; then
            json_error "System backup storage uses ${SETUP_DEFAULT_BACKUP_PATH}." invalid_backup
            exit 0
        fi
        backup_json="$(jq -n --arg path "${SETUP_DEFAULT_BACKUP_PATH}" '{type:"system",path:$path,device:"",parent_disk:"",model:"JustVoxel system storage",transport:"",size_bytes:0,filesystem:"",mount_point:"",expected_uuid:"",expected_source:"",mounted_at:"",system_disk:true,source:"",username:"",domain:"",credentials_required:false}')"
        ;;
    partition)
        set +e
        backup_json="$(validate_local_target backup "${backup_device}" "${backup_mount}" "${backup_path}")"
        backup_rc=$?
        set -e
        if (( backup_rc != 0 )); then
            json_error "$(local_target_error "${backup_rc}")" invalid_backup
            exit 0
        fi
        backup_json="$(jq -c '. + {source:"",username:"",domain:"",credentials_required:false}' <<< "${backup_json}")"
        ;;
    nfs|smb)
        set +e
        backup_json="$(validate_network_target "${backup_type}" "${backup_source}" "${backup_mount}" "${backup_path}" "${backup_username}" "${backup_domain}")"
        backup_rc=$?
        set -e
        if (( backup_rc != 0 )); then
            json_error "$(network_target_error "${backup_rc}")" invalid_backup
            exit 0
        fi
        warnings="$(warning_add "${warnings}" network_backup_dependency 'Network backup storage will be mounted and verified only when setup is executed. Backups fail closed if the expected network source is unavailable.')"
        ;;
    *)
        json_error 'Choose system storage, an existing local filesystem, NFS, or SMB for backups.' invalid_backup
        exit 0
        ;;
esac

normalized_storage_path="$(jq -r '.path' <<< "${storage_json}")"
normalized_backup_path="$(jq -r '.path' <<< "${backup_json}")"
if paths_overlap "${normalized_storage_path}" "${normalized_backup_path}"; then
    json_error 'Minecraft data and backups cannot use the same directory or contain one another.' invalid_storage_layout
    exit 0
fi

storage_parent="$(jq -r '.parent_disk // ""' <<< "${storage_json}")"
backup_parent="$(jq -r '.parent_disk // ""' <<< "${backup_json}")"
storage_system="$(jq -r '.system_disk // false' <<< "${storage_json}")"
backup_system="$(jq -r '.system_disk // false' <<< "${backup_json}")"
if [[ ${storage_type} == system && ${backup_type} == system ]]; then
    warnings="$(warning_add "${warnings}" same_physical_disk 'Minecraft data and backups use JustVoxel system storage. This protects against accidental file loss but may not protect against physical disk failure.')"
elif [[ ${storage_type} == system && ${backup_type} == partition && ${backup_system} == true ]]; then
    warnings="$(warning_add "${warnings}" same_physical_disk 'The selected backup filesystem is on the JustVoxel system disk. A separate disk or NAS provides a stronger backup failure boundary.')"
elif [[ ${storage_type} == partition && ${backup_type} == system && ${storage_system} == true ]]; then
    warnings="$(warning_add "${warnings}" same_physical_disk 'Minecraft data and system backups share the JustVoxel system disk. A separate disk or NAS provides a stronger backup failure boundary.')"
elif [[ ${storage_type} == partition && ${backup_type} == partition && -n ${storage_parent} && ${storage_parent} == "${backup_parent}" ]]; then
    warnings="$(warning_add "${warnings}" same_physical_disk 'Minecraft data and backups are on partitions of the same physical disk. A separate disk or NAS provides a stronger backup failure boundary.')"
fi

if [[ ${backup_type} == smb ]]; then
    smb_password_required=true
else
    smb_password_required=false
fi
if [[ ${backup_type} == nfs || ${backup_type} == smb ]]; then
    network_validation_on_apply=true
else
    network_validation_on_apply=false
fi

server_json="$(jq -n \
    --arg motd "${motd}" \
    --argjson max_players "${max_players}" \
    --argjson bedrock_enabled "${bedrock_enabled}" \
    --arg timezone "${timezone}" \
    '{motd:$motd,max_players:$max_players,bedrock_enabled:$bedrock_enabled,timezone:$timezone}')"

minecraft_json="$(jq -n \
    --arg java_memory "${java_memory}" \
    --arg container_memory "${container_memory}" \
    --argjson java_port "${java_port}" \
    --argjson bedrock_port "${bedrock_port}" \
    --arg image_tag "${image_tag}" \
    --arg requested_version_policy "${version_policy}" \
    --arg version_policy "${resolved_version_policy}" \
    --arg version "${version}" \
    --argjson system_memory_mib "${total_mib}" \
    --argjson system_reserve_mib "${remaining_mib}" \
    --argjson minecraft_uid "${minecraft_uid}" \
    --argjson minecraft_gid "${minecraft_gid}" \
    '{java_memory:$java_memory,container_memory:$container_memory,java_port:$java_port,bedrock_port:$bedrock_port,image_tag:$image_tag,requested_version_policy:$requested_version_policy,version_policy:$version_policy,version:$version,system_memory_mib:$system_memory_mib,system_reserve_mib:$system_reserve_mib,minecraft_uid:$minecraft_uid,minecraft_gid:$minecraft_gid}')"

backup_json="$(jq -c \
    --argjson automatic "${backup_automatic}" \
    --arg daily_time "${normalized_daily_time}" \
    --arg schedule "${backup_schedule}" \
    --argjson keep "${backup_keep}" \
    '. + {automatic:$automatic,daily_time:$daily_time,schedule:$schedule,keep:$keep}' <<< "${backup_json}")"

jq -n \
    --arg schema_version "${SETUP_PLAN_SCHEMA_VERSION}" \
    --argjson server "${server_json}" \
    --argjson minecraft "${minecraft_json}" \
    --argjson storage "${storage_json}" \
    --argjson backups "${backup_json}" \
    --argjson warnings "${warnings}" \
    --argjson smb_password_required "${smb_password_required}" \
    --argjson network_validation_on_apply "${network_validation_on_apply}" \
    '{
        ok:true,
        schema_version:$schema_version,
        normalized:{server:$server,minecraft:$minecraft,storage:$storage,backups:$backups},
        warnings:$warnings,
        requirements:{smb_password_required:$smb_password_required,network_backup_validation_on_apply:$network_validation_on_apply}
    }'
