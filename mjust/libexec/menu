#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/ui.sh

configured=no
[[ -e /etc/containers/systemd/minecraft.container ]] && configured=yes

preview() {
    case "${1:-}" in
        setup) echo -e 'First setup\n\nConfigure Minecraft, memory, ports, Bedrock cross-play, storage and backups.' ;;
        import) echo -e 'Import existing Minecraft server\n\nImport an existing JustVoxel, Paper or compatible server.' ;;
        status) echo -e 'Status\n\nFriendly JustVoxel health dashboard. Advanced details are available separately.' ;;
        players) echo -e 'Players\n\nShow the current Minecraft player list.' ;;
        configure) echo -e 'Configure Minecraft\n\nChange supported Minecraft settings through guided menus.' ;;
        whitelist) echo -e 'Whitelist\n\nAdd or remove Java Edition and Bedrock/Xbox players.' ;;
        service) echo -e 'Start / Stop / Restart\n\nControl Minecraft safely.' ;;
        backups) echo -e 'Backups\n\nCreate, restore and configure Minecraft backups.' ;;
        migration) echo -e 'Migration\n\nExport, import or recover a server migration.' ;;
        storage) echo -e 'Storage\n\nView storage and move Minecraft data. Device provisioning is under Advanced.' ;;
        update) echo -e 'Update Minecraft\n\nCheck Minecraft/Paper and container image updates.' ;;
        system) echo -e 'System\n\nView OS status and updates, resources, reboot and power controls.\n\nSystem resources opens btop. Press q to return to JustVoxel. Esc opens the btop menu, and Ctrl-C also exits the monitor.' ;;
        validate) echo -e 'Validation\n\nRun the complete JustVoxel deployment validation.' ;;
        logs) echo -e 'Logs\n\nReadable recent Minecraft logs from the JustVoxel Management API.' ;;
        advanced) echo -e 'Advanced\n\nDetailed status, storage device provisioning, welcome controls and reset tools.' ;;
        exit) echo 'Exit the JustVoxel menu.' ;;
        *) echo 'Unknown menu item.' ;;
    esac
}

if [[ ${1:-} == --preview ]]; then
    preview "${2:-}"
    exit 0
fi

show_noninteractive_help() {
    cat <<'TEXT'
JustVoxel mjust

Interactive menu unavailable because this session has no usable TTY.
Use a direct command instead, for example:
  mjust status
  mjust status --details
  mjust players
  mjust configure
  mjust whitelist-list
  mjust backup
  mjust restore
  mjust export
  mjust import
  mjust update-minecraft
  mjust os-status
  mjust os-update
  mjust web status
  mjust password-reset
  mjust logs
  mjust --list

For an SSH menu, allocate a terminal, for example: ssh -t <host> mjust
TEXT
}

if ! jui_is_interactive; then
    show_noninteractive_help
    exit 0
fi

run_and_pause() {
    "$@"
    local rc=$?
    jui_pause
    return "${rc}"
}

service_menu() {
    local choice
    choice="$(jui_choose 'Minecraft service' 'Start Minecraft' 'Stop Minecraft' 'Restart Minecraft' 'Back')" || return 0
    case "${choice}" in
        'Start Minecraft') run_and_pause /usr/bin/mjust start || true ;;
        'Stop Minecraft') run_and_pause /usr/bin/mjust stop || true ;;
        'Restart Minecraft') run_and_pause /usr/bin/mjust restart || true ;;
        *) return 0 ;;
    esac
}

configure_menu() {
    local choice
    while true; do
        choice="$(jui_choose 'Configure Minecraft' 'Maximum players' 'Other safe Minecraft settings' 'Back')" || return 0
        case "${choice}" in
            'Maximum players') run_and_pause /usr/bin/mjust configure-max-players || true ;;
            'Other safe Minecraft settings') run_and_pause /usr/bin/mjust configure || true ;;
            'Back') return 0 ;;
        esac
    done
}

bedrock_enabled() {
    sudo /usr/libexec/justvoxel/mjust/whitelist bedrock-enabled >/dev/null 2>&1
}

whitelist_player_type() {
    local operation="$1" type name
    type="$(jui_choose "$([[ ${operation} == add ]] && printf 'Add player' || printf 'Remove player')" 'Java Edition' 'Bedrock / Xbox' 'Back')" || return 0
    case "${type}" in
        'Java Edition')
            name="$(jui_input 'Java username')" || return 0
            [[ -n ${name} ]] || return 0
            run_and_pause /usr/bin/mjust "whitelist-${operation}-java" "${name}" || true
            ;;
        'Bedrock / Xbox')
            if ! bedrock_enabled; then
                echo 'Bedrock cross-play is disabled.'
                echo 'Enable it from Configure Minecraft -> Other safe Minecraft settings first.'
                jui_pause
                return 0
            fi
            name="$(jui_input 'Bedrock / Xbox gamertag')" || return 0
            [[ -n ${name} ]] || return 0
            run_and_pause /usr/bin/mjust "whitelist-${operation}-bedrock" "${name}" || true
            ;;
        *) return 0 ;;
    esac
}

whitelist_menu() {
    local choice
    while true; do
        choice="$(jui_choose 'Whitelist' 'Show whitelist' 'Add player' 'Remove player' 'Back')" || return 0
        case "${choice}" in
            'Show whitelist') run_and_pause /usr/bin/mjust whitelist-list || true ;;
            'Add player') whitelist_player_type add ;;
            'Remove player') whitelist_player_type remove ;;
            'Back') return 0 ;;
        esac
    done
}

backup_menu() {
    local choice
    while true; do
        choice="$(jui_choose 'Backups' 'Create backup now' 'Restore world' 'Restore full Minecraft data' 'Automatic backup settings' 'Backup storage location' 'Back')" || return 0
        case "${choice}" in
            'Create backup now') run_and_pause /usr/bin/mjust backup || true ;;
            'Restore world') run_and_pause /usr/bin/mjust restore || true ;;
            'Restore full Minecraft data') run_and_pause /usr/bin/mjust restore-full || true ;;
            'Automatic backup settings') run_and_pause sudo /usr/libexec/justvoxel/mjust/configure backup || true ;;
            'Backup storage location') run_and_pause sudo /usr/libexec/justvoxel/mjust/storage-provision backup || true ;;
            'Back') return 0 ;;
        esac
    done
}

migration_menu() {
    local choice
    while true; do
        choice="$(jui_choose 'Migration' 'Export server' 'Import server' 'Recover / finalize interrupted import' 'Back')" || return 0
        case "${choice}" in
            'Export server') run_and_pause /usr/bin/mjust export || true ;;
            'Import server') run_and_pause /usr/bin/mjust import || true ;;
            'Recover / finalize interrupted import') run_and_pause /usr/bin/mjust migration-recover || true ;;
            'Back') return 0 ;;
        esac
    done
}

storage_menu() {
    local choice
    while true; do
        choice="$(jui_choose 'Storage' 'Storage overview' 'Move Minecraft data' 'Back')" || return 0
        case "${choice}" in
            'Storage overview')
                if [[ ${configured} == yes ]]; then run_and_pause sudo /usr/libexec/justvoxel/mjust/storage-summary || true; else echo 'Storage overview is available after first setup.'; jui_pause; fi
                ;;
            'Move Minecraft data')
                if [[ ${configured} == yes ]]; then run_and_pause /usr/bin/mjust storage-migrate || true; else echo 'Minecraft data migration is available after first setup.'; jui_pause; fi
                ;;
            'Back') return 0 ;;
        esac
    done
}

system_status_menu() {
    local choice
    while true; do
        /usr/bin/mjust os-status || true
        echo
        choice="$(jui_choose 'System status & updates' 'Check for updates' 'Back')" || return 0
        case "${choice}" in
            'Check for updates') run_and_pause /usr/bin/mjust os-update || true ;;
            'Back') return 0 ;;
        esac
    done
}

system_menu() {
    local choice
    local -a options=('System status & updates' 'System resources' 'Reboot JustVoxel' 'Power off JustVoxel')
    jv_variant_is_hwe && options+=('Firmware / UEFI setup')
    options+=('Back')

    while true; do
        choice="$(jui_choose 'System' "${options[@]}")" || return 0
        case "${choice}" in
            'System status & updates') system_status_menu ;;
            'System resources') /usr/bin/mjust resources || true ;;
            'Reboot JustVoxel') run_and_pause /usr/bin/mjust reboot || true ;;
            'Power off JustVoxel') run_and_pause /usr/bin/mjust poweroff || true ;;
            'Firmware / UEFI setup') run_and_pause /usr/bin/mjust firmware || true ;;
            'Back') return 0 ;;
        esac
    done
}

all_commands() {
    echo 'All mjust commands'
    echo '------------------'
    /usr/bin/mjust --list
}

advanced_storage_menu() {
    local choice
    while true; do
        choice="$(jui_choose 'Storage devices / provisioning' 'Dedicated disk / USB backup storage' 'Existing partition / filesystem backup storage' 'Use unallocated disk space for backup storage' 'Network backup storage (NFS / SMB)' 'Directory on the system filesystem' 'Storage plan / devices' 'Back')" || return 0
        case "${choice}" in
            'Dedicated disk / USB backup storage') run_and_pause /usr/bin/mjust storage-disk || true ;;
            'Existing partition / filesystem backup storage') run_and_pause /usr/bin/mjust storage-partition || true ;;
            'Use unallocated disk space for backup storage') run_and_pause /usr/bin/mjust storage-free-space || true ;;
            'Network backup storage (NFS / SMB)') run_and_pause /usr/bin/mjust storage-network || true ;;
            'Directory on the system filesystem') run_and_pause /usr/bin/mjust storage-system || true ;;
            'Storage plan / devices') run_and_pause /usr/bin/mjust storage-plan || true ;;
            'Back') return 0 ;;
        esac
    done
}

advanced_menu() {
    local -a options=('Detailed status' 'Storage devices / provisioning' 'Administrator password' 'Show login welcome' 'Hide login welcome' 'Enable login welcome' 'All mjust commands')
    if [[ ${configured} == yes ]]; then options+=('Start over / reset Minecraft'); fi
    options+=('Back')

    local choice
    choice="$(jui_choose 'Advanced' "${options[@]}")" || return 0
    case "${choice}" in
        'Detailed status') run_and_pause /usr/bin/mjust status --details || true ;;
        'Storage devices / provisioning') advanced_storage_menu ;;
        'Administrator password') run_and_pause /usr/bin/mjust password-reset || true ;;
        'Show login welcome') run_and_pause /usr/bin/mjust welcome || true ;;
        'Hide login welcome') run_and_pause /usr/bin/mjust welcome-off || true ;;
        'Enable login welcome') run_and_pause /usr/bin/mjust welcome-on || true ;;
        'All mjust commands') all_commands; jui_pause ;;
        'Start over / reset Minecraft') run_and_pause /usr/bin/mjust start-over || true ;;
        *) return 0 ;;
    esac
}

select_rich() {
    local rows selected
    if [[ ${configured} == yes ]]; then
        rows=$'status\tStatus\nplayers\tPlayers\nconfigure\tConfigure Minecraft\nservice\tStart / Stop / Restart\nwhitelist\tWhitelist\nbackups\tBackups\nmigration\tMigration\nstorage\tStorage\nupdate\tUpdate Minecraft\nsystem\tSystem\nvalidate\tValidation\nlogs\tLogs\nadvanced\tAdvanced\nexit\tExit'
    else
        rows=$'setup\tFirst setup\nimport\tImport existing Minecraft server\nstatus\tStatus\nstorage\tStorage\nsystem\tSystem\nexit\tExit'
    fi
    selected="$(printf '%s\n' "${rows}" | fzf --delimiter=$'\t' --with-nth=2 --no-multi --layout=reverse --border --height=90% --prompt='JustVoxel > ' --preview='/usr/libexec/justvoxel/mjust/menu --preview {1}' --preview-window='right,55%,wrap,border-left' || true)"
    [[ -n ${selected} ]] || { printf 'exit'; return 0; }
    printf '%s' "${selected%%$'\t'*}"
}

select_compact() {
    local choice
    if [[ ${configured} == yes ]]; then
        choice="$(jui_choose 'JustVoxel' 'Status' 'Players' 'Configure Minecraft' 'Start / Stop / Restart' 'Whitelist' 'Backups' 'Migration' 'Storage' 'Update Minecraft' 'System' 'Validation' 'Logs' 'Advanced' 'Exit')" || { printf 'exit'; return 0; }
        case "${choice}" in
            'Status') printf 'status' ;; 'Players') printf 'players' ;; 'Configure Minecraft') printf 'configure' ;; 'Start / Stop / Restart') printf 'service' ;;
            'Whitelist') printf 'whitelist' ;; 'Backups') printf 'backups' ;; 'Migration') printf 'migration' ;; 'Storage') printf 'storage' ;; 'Update Minecraft') printf 'update' ;; 'System') printf 'system' ;;
            'Validation') printf 'validate' ;; 'Logs') printf 'logs' ;; 'Advanced') printf 'advanced' ;; *) printf 'exit' ;;
        esac
    else
        choice="$(jui_choose 'JustVoxel' 'First setup' 'Import existing Minecraft server' 'Status' 'Storage' 'System' 'Exit')" || { printf 'exit'; return 0; }
        case "${choice}" in 'First setup') printf 'setup' ;; 'Import existing Minecraft server') printf 'import' ;; 'Status') printf 'status' ;; 'Storage') printf 'storage' ;; 'System') printf 'system' ;; *) printf 'exit' ;; esac
    fi
}

while true; do
    [[ -e /etc/containers/systemd/minecraft.container ]] && configured=yes || configured=no
    if jui_rich_supported; then action="$(select_rich)"; else action="$(select_compact)"; fi
    echo
    case "${action}" in
        setup) run_and_pause /usr/bin/mjust setup || true ;;
        import) run_and_pause /usr/bin/mjust import || true ;;
        status) run_and_pause /usr/bin/mjust status || true ;;
        players) run_and_pause /usr/bin/mjust players || true ;;
        configure) configure_menu ;;
        service) service_menu ;;
        whitelist) whitelist_menu ;;
        backups) backup_menu ;;
        migration) migration_menu ;;
        storage) storage_menu ;;
        update) run_and_pause /usr/bin/mjust update-minecraft || true ;;
        system) system_menu ;;
        validate) run_and_pause /usr/bin/mjust validate || true ;;
        logs) run_and_pause /usr/bin/mjust logs || true ;;
        advanced) advanced_menu ;;
        exit) exit 0 ;;
        *) echo 'Unknown menu selection.' >&2 ;;
    esac
done
