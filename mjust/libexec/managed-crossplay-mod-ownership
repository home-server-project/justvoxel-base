#!/usr/bin/bash
# Root-private evidence for the fixed mod set; never infer ownership by filename.
set -euo pipefail
[[ $# == 5 && ( $1 == verify || $1 == record ) && ( $2 == fabric || $2 == neoforge ) ]] || exit 1
exec python3 - "$@" <<'PY'
import hashlib, json, os, re, stat, sys, zipfile
mode, platform, data, evidence, staging = sys.argv[1:]
names = {'Geyser-Fabric.jar':'geyser-fabric', 'floodgate-fabric.jar':'floodgate'} if platform == 'fabric' else {'Geyser-NeoForge.jar':'geyser_neoforge', 'floodgate-neoforge.jar':'floodgate'}
if platform == 'fabric': names['fabric-api.jar'] = 'fabric-api'
root = os.path.join(data, 'mods')
def digest(path):
    st = os.lstat(path)
    if not stat.S_ISREG(st.st_mode) or st.st_size > 64*1024*1024:
        raise ValueError('Unsafe mod artifact')
    with open(path, 'rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()
try:
    if os.path.lexists(root) and (os.path.islink(root) or not os.path.isdir(root)):
        raise ValueError('Unsafe mods root')
    if mode == 'record':
        projects = {'Geyser-Fabric.jar':'geyser', 'Geyser-NeoForge.jar':'geyser', 'floodgate-fabric.jar':'floodgate', 'floodgate-neoforge.jar':'floodgate', 'fabric-api.jar':'fabric-api'}
        hashes = {}
        for name in names:
            with open(os.path.join(staging, projects[name] + '.json')) as stream:
                expected = json.load(stream)['sha256']
            if digest(os.path.join(root, name)) != expected:
                raise ValueError('Installed mod hash mismatch')
            hashes[name] = expected
        with open(os.path.join(staging, 'mod-ownership.json'), 'x') as stream:
            json.dump({'schema':1, 'platform':platform, 'artifacts':hashes}, stream)
    else:
        old = {}
        if os.path.lexists(evidence):
            st = os.lstat(evidence)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o077 or st.st_size > 65536:
                raise ValueError('Unsafe ownership evidence')
            with open(evidence) as stream: manifest = json.load(stream)
            if manifest.get('schema') != 1 or manifest.get('platform') != platform or set(manifest.get('artifacts', {})) not in (set(), set(names), {'fabric-api.jar'} if platform == 'fabric' else set()):
                raise ValueError('Invalid ownership evidence')
            old = manifest['artifacts']
        for name in names:
            path = os.path.join(root, name)
            if os.path.lexists(path) and (name not in old or not re.fullmatch('[a-f0-9]{64}', old[name]) or digest(path) != old[name]):
                raise ValueError('Unowned or modified canonical mod')
        # Refuse alternate copies of managed mod identities, including Fabric API.
        entries = os.listdir(root) if os.path.isdir(root) else []
        if len(entries) > 1024: raise ValueError('Too many mod artifacts')
        for name in entries:
            if name in names or not name.endswith('.jar'): continue
            path = os.path.join(root, name)
            digest(path)
            with zipfile.ZipFile(path) as jar:
                for entry in jar.infolist():
                    if entry.filename not in ('fabric.mod.json', 'META-INF/neoforge.mods.toml'): continue
                    if entry.file_size > 65536: raise ValueError('Oversized mod descriptor')
                    text = jar.read(entry).decode('utf-8')
                    if entry.filename == 'fabric.mod.json':
                        identity = json.loads(text).get('id', '')
                        conflict = identity in names.values()
                    else:
                        import tomllib
                        conflict = any(m.get('modId') in names.values() for m in tomllib.loads(text).get('mods', []))
                    if conflict: raise ValueError('Duplicate managed mod identity')
except Exception:
    print('ERROR: Managed mod ownership cannot be verified; server files were preserved.', file=sys.stderr)
    sys.exit(1)
PY
