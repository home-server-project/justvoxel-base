#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/interrupt-safety.sh

metadata=/usr/lib/justvoxel/webui-release.json

trim_player_names_json() {
    local names="${1:-}"
    printf '%s\n' "${names}" | jq -R 'if length == 0 then [] else split(",") | map(gsub("^ +| +$"; "")) | map(select(length > 0)) end'
}

emit_players_from_raw() {
    local raw="$1" fallback_max="$2" online maximum names names_json
    if [[ ${raw} =~ There[[:space:]]are[[:space:]]([0-9]+)[[:space:]]of[[:space:]]a[[:space:]]max[[:space:]]of[[:space:]]([0-9]+)[[:space:]]players[[:space:]]online:?([[:space:]]*)(.*) ]]; then
        online="${BASH_REMATCH[1]}"
        maximum="${BASH_REMATCH[2]}"
        names="${BASH_REMATCH[4]}"
        names_json="$(trim_player_names_json "${names}")"
        jq -n \
            --argjson configured true \
            --arg state running \
            --argjson online "${online}" \
            --argjson max "${maximum}" \
            --argjson names "${names_json}" \
            '{configured:$configured,state:$state,online:$online,max:$max,names:$names}'
        return 0
    fi

    jq -n \
        --argjson configured true \
        --arg state unavailable \
        --argjson online 0 \
        --argjson max "${fallback_max}" \
        --arg error 'RCON player response could not be parsed.' \
        '{configured:$configured,state:$state,online:$online,max:$max,names:[],error:$error}'
}

web_players() {
    local configured_max=0 raw
    if [[ ! -r ${JV_CONFIG} || -e ${JV_SETUP_IN_PROGRESS} ]]; then
        jq -n '{configured:false,state:"not_configured",online:0,max:0,names:[]}'
        return 0
    fi

    # shellcheck disable=SC1090
    source "${JV_CONFIG}"
    [[ ${MAX_PLAYERS:-} =~ ^[0-9]+$ ]] && configured_max="${MAX_PLAYERS}"

    if ! systemctl is-active --quiet minecraft.service 2>/dev/null; then
        jq -n \
            --argjson configured true \
            --arg state stopped \
            --argjson online 0 \
            --argjson max "${configured_max}" \
            '{configured:$configured,state:$state,online:$online,max:$max,names:[]}'
        return 0
    fi

    raw="$(jv_player_list_raw 2>/dev/null || true)"
    if [[ -z ${raw} ]]; then
        jq -n \
            --argjson configured true \
            --arg state unavailable \
            --argjson online 0 \
            --argjson max "${configured_max}" \
            --arg error 'RCON player query failed.' \
            '{configured:$configured,state:$state,online:$online,max:$max,names:[],error:$error}'
        return 0
    fi

    emit_players_from_raw "${raw}" "${configured_max}"
}

emit_confirmation_from_raw() {
    local action="$1" raw="$2" online=0 names='' names_json='[]'
    if [[ ${raw} =~ There[[:space:]]are[[:space:]]([0-9]+)[[:space:]]of[[:space:]]a[[:space:]]max[[:space:]]of[[:space:]]([0-9]+)[[:space:]]players[[:space:]]online:?([[:space:]]*)(.*) ]]; then
        online="${BASH_REMATCH[1]}"
        names="${BASH_REMATCH[4]}"
        names_json="$(trim_player_names_json "${names}")"
    fi
    jq -n \
        --arg action "${action}" \
        --arg reason players_online \
        --argjson online "${online}" \
        --argjson players "${names_json}" \
        '{ok:false,action:$action,confirmation_required:true,reason:$reason,online:$online,players:$players}'
}

web_action() {
    local action="$1" confirmation="${2:-}" mode safety_output rc message

    if [[ ! -r ${JV_CONFIG} || -e ${JV_SETUP_IN_PROGRESS} ]]; then
        jq -n \
            --arg action "${action}" \
            --arg reason not_configured \
            --arg message 'JustVoxel has not been configured yet.' \
            '{ok:false,action:$action,reason:$reason,message:$message}'
        return 2
    fi

    # shellcheck disable=SC1090
    source "${JV_CONFIG}"

    case "${action}" in
        start)
            if ! systemctl --no-block start minecraft.service; then
                jq -n --arg action "${action}" --arg reason operation_failed --arg message 'Minecraft could not be started.' \
                    '{ok:false,action:$action,reason:$reason,message:$message}'
                return 4
            fi
            jq -n --arg action "${action}" --arg message 'Minecraft start requested.' \
                '{ok:true,action:$action,message:$message}'
            return 0
            ;;
        stop|restart)
            mode=required
            if [[ ${confirmation} == --confirm-players ]]; then
                mode=confirmed
            elif [[ -n ${confirmation} ]]; then
                jq -n --arg action "${action}" --arg reason invalid_request --arg message 'Invalid Minecraft control confirmation.' \
                    '{ok:false,action:$action,reason:$reason,message:$message}'
                return 4
            fi

            set +e
            safety_output="$(JV_INTERRUPT_CONFIRMATION_MODE="${mode}" jv_player_check_before_interrupt "${action^} Minecraft" 2>/dev/null)"
            rc=$?
            set -e
            case "${rc}" in
                0)
                    ;;
                10)
                    emit_confirmation_from_raw "${action}" "${safety_output}"
                    return 10
                    ;;
                1)
                    jq -n --arg action "${action}" --arg reason player_status_unavailable --arg message 'Could not confirm player status through RCON. Minecraft was not interrupted.' \
                        '{ok:false,action:$action,reason:$reason,message:$message}'
                    return 3
                    ;;
                *)
                    jq -n --arg action "${action}" --arg reason operation_failed --arg message 'Minecraft safety check failed.' \
                        '{ok:false,action:$action,reason:$reason,message:$message}'
                    return 4
                    ;;
            esac

            if ! systemctl --no-block "${action}" minecraft.service; then
                jq -n --arg action "${action}" --arg reason operation_failed --arg message "Minecraft ${action} failed." \
                    '{ok:false,action:$action,reason:$reason,message:$message}'
                return 4
            fi
            if [[ ${action} == stop ]]; then
                message='Minecraft stop requested.'
            else
                message='Minecraft restart requested.'
            fi
            jq -n --arg action "${action}" --arg message "${message}" \
                '{ok:true,action:$action,message:$message}'
            return 0
            ;;
        *)
            jq -n --arg action "${action}" --arg reason invalid_request --arg message 'Unsupported Minecraft control action.' \
                '{ok:false,action:$action,reason:$reason,message:$message}'
            return 4
            ;;
    esac
}

web_status() {
    local configured=no variant_raw variant ipv4 failed_count system_state health
    local minecraft_state players max_players mc_version java_port bedrock bedrock_port
    local backup_enabled backup_last backup_next list_output version_output latest latest_log log_version
    local webui_version api_version justvoxel_version

    if [[ -r ${JV_CONFIG} && ! -e ${JV_SETUP_IN_PROGRESS} ]]; then
        # shellcheck disable=SC1090
        source "${JV_CONFIG}"
        configured=yes
    fi

    variant="$(jv_variant_name)"

    ipv4="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}' || true)"
    if [[ -z ${ipv4} ]]; then
        ipv4="$(ip -o -4 addr show scope global up 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}' || true)"
    fi
    [[ -n ${ipv4} ]] || ipv4='Unknown'

    failed_count="$(systemctl --failed --type=service --no-legend --plain 2>/dev/null | grep -c . || true)"
    system_state="$(systemctl is-system-running 2>/dev/null || true)"
    if [[ ${failed_count} == 0 && ( ${system_state} == running || ${system_state} == degraded ) ]]; then
        health='Healthy'
    else
        health='Attention needed'
    fi

    minecraft_state='Not configured'
    players=0
    max_players=0
    mc_version='Not configured'
    java_port=0
    bedrock=false
    bedrock_port=0
    backup_enabled=false
    backup_last='None found'
    backup_next='Disabled'

    if [[ ${configured} == yes ]]; then
        minecraft_state='Stopped'
        mc_version='Unavailable'
        if [[ -n ${MINECRAFT_VERSION:-} && ${MINECRAFT_VERSION} != LATEST ]]; then
            mc_version="${MINECRAFT_VERSION}"
        fi

        latest_log="${DATA_PATH:-}/logs/latest.log"
        if [[ -r ${latest_log} ]]; then
            log_version="$(grep -Eo 'Starting minecraft server version [0-9A-Za-z._-]+' "${latest_log}" 2>/dev/null | tail -n1 | awk '{print $5}' || true)"
            [[ -n ${log_version} ]] && mc_version="${log_version}"
        fi

        if systemctl is-failed --quiet minecraft.service 2>/dev/null; then
            minecraft_state='Failed'
        elif systemctl is-active --quiet minecraft.service 2>/dev/null; then
            minecraft_state='Running'
        fi

        [[ ${MAX_PLAYERS:-} =~ ^[0-9]+$ ]] && max_players="${MAX_PLAYERS}"
        [[ ${JAVA_PORT:-} =~ ^[0-9]+$ ]] && java_port="${JAVA_PORT}"
        if [[ ${BEDROCK_ENABLED:-no} == yes ]]; then
            bedrock=true
            [[ ${BEDROCK_PORT:-} =~ ^[0-9]+$ ]] && bedrock_port="${BEDROCK_PORT}"
        fi

        if [[ ${minecraft_state} == Running ]]; then
            list_output="$(jv_player_list_raw 2>/dev/null || true)"
            if [[ ${list_output} =~ There[[:space:]]are[[:space:]]([0-9]+)[[:space:]]of[[:space:]]a[[:space:]]max[[:space:]]of[[:space:]]([0-9]+) ]]; then
                players="${BASH_REMATCH[1]}"
                max_players="${BASH_REMATCH[2]}"
            fi
            version_output="$(podman exec minecraft rcon-cli 'version' 2>/dev/null | head -n1 || true)"
            if [[ ${version_output} =~ \(MC:[[:space:]]*([0-9A-Za-z._-]+)\) ]]; then
                mc_version="${BASH_REMATCH[1]}"
            elif [[ ${version_output} =~ Paper[[:space:]]version[[:space:]]([0-9A-Za-z._-]+) ]]; then
                mc_version="${BASH_REMATCH[1]}"
            fi
        fi

        if [[ ${BACKUP_TIMER_ENABLED:-no} == yes ]]; then
            backup_enabled=true
            backup_next="$(systemctl show minecraft-backup.timer -p NextElapseUSecRealtime --value 2>/dev/null || true)"
            [[ -n ${backup_next} && ${backup_next} != n/a ]] || backup_next='Unknown'
        fi
        if [[ -n ${BACKUP_PATH:-} && -d ${BACKUP_PATH} ]]; then
            latest="$(find "${BACKUP_PATH}" -maxdepth 1 -type f -name 'minecraft-*.tar.gz' -printf '%T@ %f\n' 2>/dev/null | sort -nr | head -n1 || true)"
            [[ -n ${latest} ]] && backup_last="${latest#* }"
        fi
    fi

    webui_version='Unknown'
    api_version='v1'
    if [[ -r ${metadata} ]]; then
        webui_version="$(jq -r '.version // "Unknown"' "${metadata}" 2>/dev/null || echo Unknown)"
        api_version="$(jq -r '.management_api // "v1"' "${metadata}" 2>/dev/null || echo v1)"
    fi

    justvoxel_version='10'
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release
        justvoxel_version="${VERSION_ID:-10}"
    fi

    jq -n \
        --arg variant "${variant}" \
        --arg health "${health}" \
        --arg ipv4 "${ipv4}" \
        --argjson configured "$([[ ${configured} == yes ]] && echo true || echo false)" \
        --arg mc_state "${minecraft_state}" \
        --argjson players "${players}" \
        --argjson max_players "${max_players}" \
        --arg mc_version "${mc_version}" \
        --argjson java_port "${java_port}" \
        --argjson bedrock "${bedrock}" \
        --argjson bedrock_port "${bedrock_port}" \
        --argjson backup_enabled "${backup_enabled}" \
        --arg backup_last "${backup_last}" \
        --arg backup_next "${backup_next}" \
        --arg justvoxel_version "${justvoxel_version}" \
        --arg webui_version "${webui_version}" \
        --arg api_version "${api_version}" \
        '{system:{variant:$variant,health:$health,ipv4:$ipv4},minecraft:{configured:$configured,state:$mc_state,players:$players,max_players:$max_players,version:$mc_version,java_port:$java_port,bedrock:$bedrock,bedrock_port:$bedrock_port},backup:{enabled:$backup_enabled,last:$backup_last,next:$backup_next},justvoxel:{version:$justvoxel_version,webui:$webui_version,management_api:$api_version}}'
}

command="${1:-status}"
case "${command}" in
    status)
        (( $# <= 1 )) || { echo 'Usage: web-status-json [status|players|start|stop|restart [--confirm-players]]' >&2; exit 4; }
        web_status
        ;;
    players)
        (( $# == 1 )) || { echo 'Usage: web-status-json players' >&2; exit 4; }
        web_players
        ;;
    start|stop|restart)
        (( $# <= 2 )) || { echo 'Usage: web-status-json {start|stop|restart} [--confirm-players]' >&2; exit 4; }
        web_action "${command}" "${2:-}"
        ;;
    *)
        echo 'Usage: web-status-json [status|players|start|stop|restart [--confirm-players]]' >&2
        exit 4
        ;;
esac
