#!/usr/bin/bash
set -uo pipefail

source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/storage-common.sh
require_root

json_error() {
    jq -n --arg error "$1" '{ok:false,error:$error,warnings:[]}'
}

append_warning() {
    local json="$1" message="$2"
    jq -c --arg message "${message}" '. + [$message]' <<< "${json}"
}

real_device() {
    readlink -f -- "$1" 2>/dev/null || true
}

model_for() {
    lsblk -dnro MODEL "$1" 2>/dev/null | xargs || true
}

size_for() {
    lsblk -bdnro SIZE "$1" 2>/dev/null | head -n1
}

transport_for() {
    lsblk -dnro TRAN "$1" 2>/dev/null | xargs || true
}

parent_disk() {
    local real
    real="$(real_device "$1")"
    [[ -n ${real} ]] || return 0
    lsblk -s -npo NAME,TYPE "${real}" 2>/dev/null | awk '$2 == "disk" {print $1; exit}'
}

is_system_disk() {
    storage_disk_is_system "$1"
}

critical_mount_present() {
    local mountpoint
    while IFS= read -r mountpoint; do
        [[ -n ${mountpoint} ]] || continue
        storage_mount_is_critical "${mountpoint}" && return 0
    done < <(lsblk -nrpo MOUNTPOINT "$1" 2>/dev/null | sed '/^$/d')
    return 1
}

mountpoint_safe_and_empty() {
    local mountpoint="$1"
    storage_validate_mountpoint_path "${mountpoint}" >/dev/null 2>&1 || return 1
    mountpoint -q -- "${mountpoint}" && return 1
    if [[ -d ${mountpoint} ]] && find "${mountpoint}" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null | grep -q .; then
        return 1
    fi
    return 0
}

backup_path_safe() {
    local path="$1" mountpoint="$2"
    validate_storage_path "${path}" || return 1
    [[ ${path} == "${mountpoint}" || ${path} == "${mountpoint}/"* ]] || return 1
    [[ ${path} != "${DATA_PATH}" && ${path} != "${DATA_PATH}/"* ]]
}

largest_free_segment() {
    local disk="$1"
    parted -s -m "${disk}" unit MiB print free 2>/dev/null \
        | awk -F: '$5 == "free;" {s=$4; gsub("MiB","",s); if ((s+0) > max) {max=s+0; line=$0}} END {print line}'
}

fingerprint_device() {
    local device="$1"
    {
        printf 'device=%s\n' "$(real_device "${device}")"
        lsblk -b -P -o PATH,PKNAME,TYPE,SIZE,FSTYPE,UUID,PARTUUID,MOUNTPOINTS,START,RO,MODEL,SERIAL,WWN,TRAN "${device}" 2>/dev/null || true
        blkid "${device}" 2>/dev/null || true
        parted -s -m "${device}" unit MiB print free 2>/dev/null || true
    } | sha256sum | awk '{print $1}'
}

candidate_json() {
    local device="$1" system=false parent model size transport fstype mountpoint free_line free_size=0
    parent="$(parent_disk "${device}")"
    [[ -n ${parent} ]] && is_system_disk "${parent}" && system=true
    model="$(model_for "${device}")"
    size="$(size_for "${device}")"; size="${size:-0}"
    transport="$(transport_for "${device}")"
    fstype="$(blkid -s TYPE -o value "${device}" 2>/dev/null || true)"
    mountpoint="$(lsblk -nro MOUNTPOINT "${device}" 2>/dev/null | sed '/^$/d' | head -n1)"
    free_line="$(largest_free_segment "${device}")"
    if [[ -n ${free_line} ]]; then
        IFS=: read -r _ _ _ free_size _ <<< "${free_line}"
        free_size="${free_size%MiB}"
        free_size="$(awk -v n="${free_size:-0}" 'BEGIN {printf "%.0f", n * 1048576}')"
    fi
    jq -n --arg path "$(real_device "${device}")" --arg parent "${parent}" --arg model "${model}" --arg transport "${transport}" --arg filesystem "${fstype}" --arg mountpoint "${mountpoint}" --argjson size_bytes "${size}" --argjson free_bytes "${free_size:-0}" --argjson system_disk "${system}" '{path:$path,parent:$parent,model:$model,transport:$transport,filesystem:$filesystem,mountpoint:$mountpoint,size_bytes:$size_bytes,free_bytes:$free_bytes,system_disk:$system_disk}'
}

discover_json() {
    local whole='[]' blank='[]' free='[]' disk part free_line free_size fstype mounted
    if ! storage_require_identified_system_disk >/dev/null 2>&1; then
        jq -n '{ok:false,error:"JustVoxel could not identify the system disk safely. Destructive storage provisioning is disabled.",warnings:[],whole_disks:[],blank_partitions:[],free_space_disks:[]}'
        return 0
    fi

    while IFS= read -r disk; do
        [[ -n ${disk} ]] || continue
        storage_validate_disk "${disk}" >/dev/null 2>&1 || continue
        if ! is_system_disk "${disk}" && ! storage_has_mounted_children "${disk}"; then
            whole="$(jq -c --argjson item "$(candidate_json "${disk}")" '. + [$item]' <<< "${whole}")"
        fi
        free_line="$(largest_free_segment "${disk}")"
        if [[ -n ${free_line} ]]; then
            IFS=: read -r _ _ _ free_size _ <<< "${free_line}"
            free_size="${free_size%MiB}"
            if awk -v n="${free_size:-0}" 'BEGIN {exit !(n >= 1024)}'; then
                free="$(jq -c --argjson item "$(candidate_json "${disk}")" '. + [$item]' <<< "${free}")"
            fi
        fi
    done < <(lsblk -dnpo NAME,TYPE | awk '$2 == "disk" {print $1}')

    while IFS= read -r part; do
        [[ -n ${part} ]] || continue
        storage_validate_partition "${part}" >/dev/null 2>&1 || continue
        fstype="$(blkid -s TYPE -o value "${part}" 2>/dev/null || true)"
        [[ -z ${fstype} ]] || continue
        mounted="$(lsblk -nro MOUNTPOINT "${part}" 2>/dev/null | sed '/^$/d' | head -n1)"
        [[ -z ${mounted} ]] || continue
        critical_mount_present "${part}" && continue
        blank="$(jq -c --argjson item "$(candidate_json "${part}")" '. + [$item]' <<< "${blank}")"
    done < <(lsblk -lnpo NAME,TYPE | awk '$2 == "part" {print $1}')

    jq -n --argjson whole_disks "${whole}" --argjson blank_partitions "${blank}" --argjson free_space_disks "${free}" '{ok:true,warnings:[],whole_disks:$whole_disks,blank_partitions:$blank_partitions,free_space_disks:$free_space_disks}'
}

validate_plan() {
    require_config
    REQUEST="$(cat)"
    if ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "${REQUEST}"; then
        json_error 'Invalid storage provisioning request.'
        return 1
    fi

    OPERATION="$(jq -r '.operation // ""' <<< "${REQUEST}")"
    DEVICE="$(real_device "$(jq -r '.device // ""' <<< "${REQUEST}")")"
    MOUNT_POINT="$(realpath -m -- "$(jq -r '.mount_point // "/var/mnt/justvoxel-backup"' <<< "${REQUEST}")" 2>/dev/null || true)"
    BACKUP_DIR="$(realpath -m -- "$(jq -r '.path // ""' <<< "${REQUEST}")" 2>/dev/null || true)"
    SIZE_GIB="$(jq -r '.size_gib // "all"' <<< "${REQUEST}")"
    CONFIRMATION="$(jq -r '.confirmation // ""' <<< "${REQUEST}")"
    EXPECTED_FINGERPRINT="$(jq -r '.fingerprint // ""' <<< "${REQUEST}")"
    WARNINGS='[]'
    FREE_START=''
    FREE_END=''
    PLANNED_END=''
    FREE_MIB=0
    PLANNED_MIB=0

    [[ -n ${DEVICE} && -b ${DEVICE} ]] || { json_error 'Choose a valid storage device.'; return 1; }
    [[ -n ${MOUNT_POINT} ]] && mountpoint_safe_and_empty "${MOUNT_POINT}" || { json_error 'Choose an unused, empty and non-critical mount point.'; return 1; }
    [[ -n ${BACKUP_DIR} ]] && backup_path_safe "${BACKUP_DIR}" "${MOUNT_POINT}" || { json_error 'Backup directory must be inside the new storage mount and cannot overlap Minecraft data.'; return 1; }
    storage_require_identified_system_disk >/dev/null 2>&1 || { json_error 'JustVoxel could not identify the system disk safely. Destructive storage provisioning is disabled.'; return 1; }

    local model size transport parent free_line table parent_system=false
    model="$(model_for "${DEVICE}")"
    size="$(size_for "${DEVICE}")"; size="${size:-0}"
    transport="$(transport_for "${DEVICE}")"
    parent="$(parent_disk "${DEVICE}")"
    [[ -n ${parent} ]] && is_system_disk "${parent}" && parent_system=true

    case "${OPERATION}" in
        erase_disk)
            storage_validate_disk "${DEVICE}" >/dev/null 2>&1 || { json_error 'The selected device is not a writable whole disk.'; return 1; }
            is_system_disk "${DEVICE}" && { json_error 'The system disk can never be erased by JustVoxel.'; return 1; }
            storage_has_mounted_children "${DEVICE}" && { json_error 'The selected disk or one of its partitions is mounted. Unmount it before whole-disk provisioning.'; return 1; }
            EXACT_CONFIRMATION="ERASE ${DEVICE}"
            WARNINGS="$(append_warning "${WARNINGS}" 'This erases the entire selected disk, including every partition and filesystem currently on it. This cannot be undone by JustVoxel.')"
            ;;
        format_partition)
            storage_validate_partition "${DEVICE}" >/dev/null 2>&1 || { json_error 'The selected device is not a writable partition.'; return 1; }
            [[ -z $(blkid -s TYPE -o value "${DEVICE}" 2>/dev/null || true) ]] || { json_error 'The selected partition already contains a filesystem. A3.2 only formats partitions that are currently blank.'; return 1; }
            [[ -z $(lsblk -nro MOUNTPOINT "${DEVICE}" 2>/dev/null | sed '/^$/d' | head -n1) ]] || { json_error 'The selected partition is mounted and cannot be formatted.'; return 1; }
            critical_mount_present "${DEVICE}" && { json_error 'The selected partition is part of a critical system mount.'; return 1; }
            EXACT_CONFIRMATION="FORMAT ${DEVICE}"
            WARNINGS="$(append_warning "${WARNINGS}" 'Formatting creates a new XFS filesystem on exactly this partition. Any recoverable remnants on that partition will be overwritten.')"
            if [[ ${parent_system} == true ]]; then
                WARNINGS="$(append_warning "${WARNINGS}" 'This blank partition is located on the system disk. Only the selected blank partition will be formatted; existing system partitions are not resized or reformatted.')"
            fi
            ;;
        create_partition)
            storage_validate_disk "${DEVICE}" >/dev/null 2>&1 || { json_error 'The selected device is not a writable disk.'; return 1; }
            table="$(parted -s -m "${DEVICE}" print 2>/dev/null | awk -F: 'NR == 2 {print $6}' || true)"
            [[ -n ${table} && ${table} != unknown ]] || { json_error 'This disk does not have a usable partition table. Use dedicated whole-disk provisioning instead.'; return 1; }
            free_line="$(largest_free_segment "${DEVICE}")"
            [[ -n ${free_line} ]] || { json_error 'No unallocated disk segment is available.'; return 1; }
            IFS=: read -r _ FREE_START FREE_END free_size _ <<< "${free_line}"
            free_size="${free_size%MiB}"
            awk -v n="${free_size}" 'BEGIN {exit !(n >= 1024)}' || { json_error 'The largest unallocated segment is smaller than 1 GiB.'; return 1; }
            FREE_MIB="$(awk -v n="${free_size}" 'BEGIN {printf "%.0f", n}')"
            if [[ ${SIZE_GIB} == all ]]; then
                PLANNED_END="${FREE_END}"
                PLANNED_MIB="${FREE_MIB}"
            elif [[ ${SIZE_GIB} =~ ^[1-9][0-9]*$ ]]; then
                (( SIZE_GIB * 1024 <= FREE_MIB )) || { json_error 'Requested partition size is larger than the largest unallocated segment.'; return 1; }
                PLANNED_MIB=$(( SIZE_GIB * 1024 ))
                PLANNED_END="$(awk -v s="${FREE_START%MiB}" -v m="${PLANNED_MIB}" 'BEGIN {printf "%.2fMiB", s + m}')"
            else
                json_error 'Partition size must be an integer number of GiB or all.'
                return 1
            fi
            EXACT_CONFIRMATION="CREATE PARTITION ${DEVICE}"
            WARNINGS="$(append_warning "${WARNINGS}" 'JustVoxel will create a new XFS partition only inside the already-unallocated segment shown below. Existing partitions are never shrunk or moved.')"
            if is_system_disk "${DEVICE}"; then
                WARNINGS="$(append_warning "${WARNINGS}" 'This modifies the partition table on the system disk. The operation is limited to currently unallocated space and does not resize existing system partitions.')"
            fi
            ;;
        *)
            json_error 'Choose whole-disk erase, blank-partition format, or unallocated-space partition creation.'
            return 1
            ;;
    esac

    FINGERPRINT="$(fingerprint_device "${DEVICE}")"
    [[ -n ${FINGERPRINT} ]] || { json_error 'Could not capture a stable device fingerprint for review.'; return 1; }

    PLAN_JSON="$(jq -n \
        --arg operation "${OPERATION}" \
        --arg device "${DEVICE}" \
        --arg model "${model}" \
        --arg transport "${transport}" \
        --argjson size_bytes "${size}" \
        --arg mount_point "${MOUNT_POINT}" \
        --arg path "${BACKUP_DIR}" \
        --arg size_gib "${SIZE_GIB}" \
        --arg free_start "${FREE_START}" \
        --arg free_end "${FREE_END}" \
        --arg planned_end "${PLANNED_END}" \
        --argjson free_mib "${FREE_MIB}" \
        --argjson planned_mib "${PLANNED_MIB}" \
        --arg confirmation "${EXACT_CONFIRMATION}" \
        --arg fingerprint "${FINGERPRINT}" \
        --argjson system_disk "$([[ -n ${parent} ]] && is_system_disk "${parent}" && printf true || printf false)" \
        '{operation:$operation,device:$device,model:$model,transport:$transport,size_bytes:$size_bytes,mount_point:$mount_point,path:$path,size_gib:$size_gib,free_start:$free_start,free_end:$free_end,planned_end:$planned_end,free_mib:$free_mib,planned_mib:$planned_mib,confirmation:$confirmation,fingerprint:$fingerprint,system_disk:$system_disk}')"
    return 0
}

plan_json() {
    if ! validate_plan; then
        return 0
    fi
    jq -n --argjson proposed "${PLAN_JSON}" --argjson warnings "${WARNINGS}" '{ok:true,proposed:$proposed,warnings:$warnings,applied:false}'
}

activate_new_backup_storage() {
    local partition="$1" storage_type="$2" old_config config_backup
    config_backup="$(mktemp "${JV_CONFIG_DIR}/.justvoxel.conf.pre-provision.XXXXXX")"
    cp -a "${JV_CONFIG}" "${config_backup}" || return 1

    STORAGE_MOUNT_POINT="${MOUNT_POINT}"
    STORAGE_EXPECTED_UUID=''
    STORAGE_EXPECTED_SOURCE=''
    if ! storage_mount_local "${partition}" "${MOUNT_POINT}"; then
        rm -f "${config_backup}"
        return 1
    fi
    STORAGE_TYPE="${storage_type}"
    STORAGE_PATH="${BACKUP_DIR}"
    install -d -m0700 -o root -g root "${STORAGE_PATH}" || {
        umount "${MOUNT_POINT}" >/dev/null 2>&1 || true
        storage_restore_fstab_backup >/dev/null 2>&1 || true
        rm -f "${config_backup}"
        return 1
    }
    if ! storage_assert_writable_dir "${STORAGE_PATH}"; then
        umount "${MOUNT_POINT}" >/dev/null 2>&1 || true
        storage_restore_fstab_backup >/dev/null 2>&1 || true
        rm -f "${config_backup}"
        return 1
    fi

    BACKUP_TYPE="${STORAGE_TYPE}"
    BACKUP_PATH="${STORAGE_PATH}"
    BACKUP_MOUNT_POINT="${STORAGE_MOUNT_POINT}"
    BACKUP_EXPECTED_UUID="${STORAGE_EXPECTED_UUID}"
    BACKUP_EXPECTED_SOURCE="${STORAGE_EXPECTED_SOURCE}"
    if ! write_main_config || ! render_runtime; then
        cp -a "${config_backup}" "${JV_CONFIG}" >/dev/null 2>&1 || true
        require_config >/dev/null 2>&1 || true
        render_runtime >/dev/null 2>&1 || true
        umount "${MOUNT_POINT}" >/dev/null 2>&1 || true
        storage_restore_fstab_backup >/dev/null 2>&1 || true
        rm -f "${config_backup}"
        return 1
    fi
    rm -f "${config_backup}"
    return 0
}

apply_json() {
    if ! validate_plan; then
        return 0
    fi
    if [[ ${CONFIRMATION} != "${EXACT_CONFIRMATION}" ]]; then
        json_error "Confirmation does not match. Type exactly: ${EXACT_CONFIRMATION}"
        return 0
    fi
    if [[ -z ${EXPECTED_FINGERPRINT} || ${EXPECTED_FINGERPRINT} != "${FINGERPRINT}" ]]; then
        json_error 'The selected device or disk layout changed after Review. Nothing was changed. Review the storage operation again.'
        return 0
    fi

    local partition='' before after storage_type
    case "${OPERATION}" in
        erase_disk)
            if ! wipefs -a -- "${DEVICE}" >/dev/null 2>&1 \
                || ! parted -s -a optimal -- "${DEVICE}" mklabel gpt >/dev/null 2>&1 \
                || ! storage_create_partition "${DEVICE}" 1MiB 100% >/dev/null 2>&1 \
                || ! partprobe "${DEVICE}" >/dev/null 2>&1 \
                || ! udevadm settle >/dev/null 2>&1; then
                json_error 'Whole-disk provisioning failed after the destructive operation began. Inspect the selected disk before retrying.'
                return 0
            fi
            partition="$(lsblk -nrpo NAME,TYPE "${DEVICE}" | awk '$2 == "part" {print $1; exit}')"
            [[ -b ${partition} ]] || { json_error 'The new partition did not appear after whole-disk provisioning.'; return 0; }
            mkfs.xfs -f -L JUSTVOXEL_BACKUP "${partition}" >/dev/null 2>&1 || { json_error 'The disk was repartitioned, but creating the XFS filesystem failed. Inspect the disk before retrying.'; return 0; }
            storage_type=disk
            ;;
        format_partition)
            partition="${DEVICE}"
            mkfs.xfs -f -L JUSTVOXEL_BACKUP "${partition}" >/dev/null 2>&1 || { json_error 'Formatting the selected partition failed. Inspect the partition before retrying.'; return 0; }
            storage_type=partition
            ;;
        create_partition)
            before="$(mktemp)"; after="$(mktemp)"
            lsblk -nrpo NAME,TYPE "${DEVICE}" | awk '$2 == "part" {print $1}' | sort > "${before}"
            if ! storage_create_partition "${DEVICE}" "${FREE_START}" "${PLANNED_END}" >/dev/null 2>&1 \
                || ! partprobe "${DEVICE}" >/dev/null 2>&1 \
                || ! udevadm settle >/dev/null 2>&1; then
                rm -f "${before}" "${after}"
                json_error 'Creating the new partition failed after the partition-table operation began. Inspect the disk before retrying.'
                return 0
            fi
            lsblk -nrpo NAME,TYPE "${DEVICE}" | awk '$2 == "part" {print $1}' | sort > "${after}"
            partition="$(comm -13 "${before}" "${after}" | head -n1)"
            rm -f "${before}" "${after}"
            [[ -b ${partition} ]] || { json_error 'The new partition could not be identified safely. Inspect the disk before retrying.'; return 0; }
            mkfs.xfs -f -L JUSTVOXEL_BACKUP "${partition}" >/dev/null 2>&1 || { json_error 'The partition was created, but creating the XFS filesystem failed. Inspect the partition before retrying.'; return 0; }
            storage_type=partition
            ;;
    esac

    if ! activate_new_backup_storage "${partition}" "${storage_type}"; then
        json_error 'Storage was provisioned, but JustVoxel could not activate it as the backup destination. The previous backup configuration was restored; the newly provisioned disk or partition was not erased again.'
        return 0
    fi

    local uuid source size
    uuid="$(findmnt -n -o UUID --target "${MOUNT_POINT}" 2>/dev/null || true)"
    source="$(findmnt -n -o SOURCE --target "${MOUNT_POINT}" 2>/dev/null || true)"
    size="$(size_for "${partition}")"; size="${size:-0}"
    jq -n \
        --argjson proposed "${PLAN_JSON}" \
        --argjson warnings "${WARNINGS}" \
        --arg partition "${partition}" \
        --arg uuid "${uuid}" \
        --arg source "${source}" \
        --argjson partition_size_bytes "${size}" \
        '{ok:true,proposed:($proposed + {partition:$partition,filesystem:"xfs",expected_uuid:$uuid,expected_source:$source,partition_size_bytes:$partition_size_bytes}),warnings:$warnings,applied:true}'
}

action="${1:-discover}"
case "${action}" in
    discover) discover_json ;;
    plan) plan_json ;;
    apply) apply_json ;;
    *) json_error 'Usage: admin-storage-provision-json {discover|plan|apply}' ;;
esac
