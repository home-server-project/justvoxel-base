#!/usr/bin/bash
set -uo pipefail

source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/admin-setup-storage-transaction-common.sh
source /usr/libexec/justvoxel/mjust/minecraft-reset-common.sh
require_root

readonly A55_SETUP_MARKER=${JV_SETUP_IN_PROGRESS}
readonly A55_RUNTIME_FILES=(
    /etc/justvoxel/justvoxel.conf
    /etc/justvoxel/minecraft.env
    /etc/justvoxel/minecraft-backup.env
    /etc/containers/systemd/minecraft.container
    /etc/systemd/system/minecraft-backup.service
    /etc/systemd/system/minecraft-backup.timer
)

A55_REQUEST=''
A55_OPERATION_ID=''
A55_PLAN_FINGERPRINT=''
A55_EVIDENCE='{}'

_a55_evidence_set() {
    local key="$1" value="$2"
    A55_EVIDENCE="$(jq -c --arg key "${key}" --arg value "${value}" '. + {($key):$value}' <<< "${A55_EVIDENCE}")" || return 1
}

_a55_evidence_set_bounded() {
    local key="$1" value="$2" max="${3:-12000}"
    if (( ${#value} > max )); then
        value="${value:0:max}…"
    fi
    _a55_evidence_set "${key}" "${value}"
}

_a55_json() {
    local ok="$1" applied="$2" phase="$3" error="$4" evidence="${5:-}"
    [[ -n ${evidence} ]] || evidence='{}'
    jq -n \
        --argjson ok "${ok}" \
        --argjson applied "${applied}" \
        --arg phase "${phase}" \
        --arg error "${error}" \
        --argjson evidence "${evidence}" \
        '{ok:$ok,applied:$applied,phase:$phase}
         + (if $error == "" then {} else {error:$error} end)
         + (if ($evidence|length) == 0 then {} else {evidence:$evidence} end)'
}

_a55_parse_request() {
    A55_REQUEST="$(cat)"
    jq -e '
      type == "object" and
      ((keys - ["schema_version","operation_id","plan_fingerprint","server","minecraft","storage","backups"]) | length == 0) and
      .schema_version == "v1" and
      (.operation_id|type == "string") and
      (.plan_fingerprint|type == "string") and
      (.server|type == "object") and
      (.minecraft|type == "object") and
      (.storage|type == "object") and
      (.backups|type == "object") and
      ((.server|keys) - ["motd","max_players","bedrock_enabled","timezone"] | length == 0) and
      ((.minecraft|keys) - ["server_type","java_memory","container_memory","java_port","bedrock_port","image_tag","version_policy","version","game_mode","minecraft_uid","minecraft_gid"] | length == 0) and
      ((.storage|keys) - ["type","path","mount_point","expected_uuid","expected_source"] | length == 0) and
      ((.backups|keys) - ["type","path","mount_point","expected_uuid","expected_source","automatic","schedule","keep"] | length == 0) and
      (.server.motd|type == "string") and
      (.server.max_players|type == "number") and
      (.server.bedrock_enabled|type == "boolean") and
      (.server.timezone|type == "string") and
      (.minecraft | (has("server_type") | not) or (.server_type | type == "string" and (. == "paper" or . == "purpur" or . == "vanilla"))) and
      (.minecraft.java_memory|type == "string") and
      (.minecraft.container_memory|type == "string") and
      (.minecraft.java_port|type == "number") and
      (.minecraft.bedrock_port|type == "number") and
      (.minecraft.image_tag|type == "string") and
      (.minecraft.version_policy|type == "string") and
      (.minecraft.version|type == "string") and
      (.minecraft.game_mode|type == "string") and
      (.minecraft.game_mode == "survival" or .minecraft.game_mode == "creative" or .minecraft.game_mode == "adventure" or .minecraft.game_mode == "spectator") and
      (.minecraft.minecraft_uid|type == "number") and
      (.minecraft.minecraft_gid|type == "number") and
      (.storage.type|type == "string") and
      (.storage.path|type == "string") and
      ((.storage.mount_point // "")|type == "string") and
      ((.storage.expected_uuid // "")|type == "string") and
      ((.storage.expected_source // "")|type == "string") and
      (.backups.type|type == "string") and
      (.backups.path|type == "string") and
      ((.backups.mount_point // "")|type == "string") and
      ((.backups.expected_uuid // "")|type == "string") and
      ((.backups.expected_source // "")|type == "string") and
      (.backups.automatic|type == "boolean") and
      (.backups.schedule|type == "string") and
      (.backups.keep|type == "number") and
      ([paths | select((last|type) == "string" and ((last|ascii_downcase)|contains("password")))] | length == 0)
    ' >/dev/null 2>&1 <<< "${A55_REQUEST}" || return 1

    A55_OPERATION_ID="$(jq -r '.operation_id' <<< "${A55_REQUEST}")"
    A55_PLAN_FINGERPRINT="$(jq -r '.plan_fingerprint' <<< "${A55_REQUEST}")"
    [[ ${A55_OPERATION_ID} =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] || return 1
    [[ ${A55_PLAN_FINGERPRINT} =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    A53_OPERATION_ID="${A55_OPERATION_ID}"
    A53_PLAN_FINGERPRINT="${A55_PLAN_FINGERPRINT}"
    A53_TX_DIR="${A53_TRANSACTION_ROOT}/${A55_OPERATION_ID}"
    A53_MANIFEST="${A53_TX_DIR}/manifest.json"
    [[ -f ${A53_MANIFEST} ]] || return 1
    [[ $(jq -r '.operation_id // ""' "${A53_MANIFEST}") == "${A55_OPERATION_ID}" ]] || return 1
    [[ $(jq -r '.plan_fingerprint // ""' "${A53_MANIFEST}") == "${A55_PLAN_FINGERPRINT}" ]] || return 1
    return 0
}

_a55_load_values() {
    DATA_PATH="$(jq -r '.storage.path' <<< "${A55_REQUEST}")"
    DATA_MOUNT_POINT="$(jq -r '.storage.mount_point // ""' <<< "${A55_REQUEST}")"
    DATA_EXPECTED_UUID="$(jq -r '.storage.expected_uuid // ""' <<< "${A55_REQUEST}")"
    DATA_EXPECTED_SOURCE="$(jq -r '.storage.expected_source // ""' <<< "${A55_REQUEST}")"
    BACKUP_TYPE="$(jq -r '.backups.type' <<< "${A55_REQUEST}")"
    BACKUP_PATH="$(jq -r '.backups.path' <<< "${A55_REQUEST}")"
    BACKUP_MOUNT_POINT="$(jq -r '.backups.mount_point // ""' <<< "${A55_REQUEST}")"
    BACKUP_EXPECTED_UUID="$(jq -r '.backups.expected_uuid // ""' <<< "${A55_REQUEST}")"
    BACKUP_EXPECTED_SOURCE="$(jq -r '.backups.expected_source // ""' <<< "${A55_REQUEST}")"
    BACKUP_KEEP="$(jq -r '.backups.keep' <<< "${A55_REQUEST}")"
    BACKUP_SCHEDULE="$(jq -r '.backups.schedule' <<< "${A55_REQUEST}")"
    if [[ $(jq -r '.backups.automatic' <<< "${A55_REQUEST}") == true ]]; then BACKUP_TIMER_ENABLED=yes; else BACKUP_TIMER_ENABLED=no; fi

    JAVA_PORT="$(jq -r '.minecraft.java_port' <<< "${A55_REQUEST}")"
    BEDROCK_PORT="$(jq -r '.minecraft.bedrock_port' <<< "${A55_REQUEST}")"
    if [[ $(jq -r '.server.bedrock_enabled' <<< "${A55_REQUEST}") == true ]]; then BEDROCK_ENABLED=yes; else BEDROCK_ENABLED=no; fi
    BEDROCK_MANAGED_PLUGINS=yes
    JAVA_MEMORY="$(jq -r '.minecraft.java_memory' <<< "${A55_REQUEST}")"
    CONTAINER_MEMORY="$(jq -r '.minecraft.container_memory' <<< "${A55_REQUEST}")"
    MINECRAFT_SERVER_TYPE="$(jq -r '.minecraft.server_type // "paper"' <<< "${A55_REQUEST}")"
    MINECRAFT_IMAGE_TAG="$(jq -r '.minecraft.image_tag' <<< "${A55_REQUEST}")"
    MINECRAFT_VERSION_MODE="$(jq -r '.minecraft.version_policy' <<< "${A55_REQUEST}")"
    MINECRAFT_VERSION="$(jq -r '.minecraft.version' <<< "${A55_REQUEST}")"
    MINECRAFT_UID="$(jq -r '.minecraft.minecraft_uid' <<< "${A55_REQUEST}")"
    MINECRAFT_GID="$(jq -r '.minecraft.minecraft_gid' <<< "${A55_REQUEST}")"
    TIMEZONE="$(jq -r '.server.timezone' <<< "${A55_REQUEST}")"
    MAX_PLAYERS="$(jq -r '.server.max_players' <<< "${A55_REQUEST}")"
    MOTD="$(jq -r '.server.motd' <<< "${A55_REQUEST}")"
    GAME_MODE="$(jq -r '.minecraft.game_mode' <<< "${A55_REQUEST}")"
    DIFFICULTY=normal
    WHITELIST_ENABLED=yes
    ENFORCE_WHITELIST=yes
}

_a55_validate_runtime_inputs() {
    _a55_load_values
    validate_server_capabilities || return 1
    validate_storage_path "${DATA_PATH}" || return 1
    validate_storage_path "${BACKUP_PATH}" || return 1
    validate_memory "${JAVA_MEMORY}" && validate_memory "${CONTAINER_MEMORY}" || return 1
    validate_port "${JAVA_PORT}" && validate_port "${BEDROCK_PORT}" || return 1
    validate_nonroot_id "${MINECRAFT_UID}" && validate_nonroot_id "${MINECRAFT_GID}" || return 1
    validate_positive_int "${MAX_PLAYERS}" && validate_positive_int "${BACKUP_KEEP}" || return 1
    validate_simple_text "${MOTD}" || return 1
    [[ -e /usr/share/zoneinfo/${TIMEZONE} ]] || return 1
    [[ ${MINECRAFT_IMAGE_TAG} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
    [[ ${MINECRAFT_VERSION_MODE} == pinned || ${MINECRAFT_VERSION_MODE} == recommended || ${MINECRAFT_VERSION_MODE} == latest ]] || return 1
    [[ -n ${MINECRAFT_VERSION} ]] || return 1
    validate_game_mode "${GAME_MODE}" || return 1
    [[ -d ${DATA_PATH} && -w ${BACKUP_PATH} ]] || return 1
    if [[ -n ${DATA_MOUNT_POINT} ]]; then mountpoint -q -- "${DATA_MOUNT_POINT}" || return 1; fi
    if [[ -n ${BACKUP_MOUNT_POINT} ]]; then mountpoint -q -- "${BACKUP_MOUNT_POINT}" || return 1; fi
    local file
    for file in "${A55_RUNTIME_FILES[@]}"; do
        [[ ! -e ${file} ]] || return 1
    done
    systemctl cat minecraft.service >/dev/null 2>&1 && return 1
    systemctl cat minecraft-backup.timer >/dev/null 2>&1 && return 1
    [[ ! -e ${A55_SETUP_MARKER} ]] || return 1
    return 0
}

_a55_manifest_update() {
    local filter="$1" tmp current
    current="$(cat -- "${A53_MANIFEST}")" || return 1
    tmp="$(mktemp "${A53_TX_DIR}/.runtime-manifest.XXXXXX")" || return 1
    jq -c "${filter}" <<< "${current}" > "${tmp}" || { rm -f -- "${tmp}"; return 1; }
    chmod 0600 "${tmp}" || { rm -f -- "${tmp}"; return 1; }
    mv -f -- "${tmp}" "${A53_MANIFEST}" || { rm -f -- "${tmp}"; return 1; }
}

# Record before rendering/starting Minecraft. Missing evidence always preserves data.
# Canonical paths, directory identity and mount identity must remain unchanged.
_a55_data_identity() {
    local canonical scope mount_identity fstype canonical_backup
    canonical="$(realpath -e -- "${DATA_PATH}")" || return 1
    [[ ${canonical} == "${DATA_PATH}" && -d ${DATA_PATH} && ! -L ${DATA_PATH} ]] || return 1
    scope="$(jv_reset_data_scope "${DATA_PATH}")" || return 1
    [[ ${scope} == internal ]] || return 1
    mount_identity="$(findmnt -n -o SOURCE,FSTYPE,TARGET --target "${DATA_PATH}")" || return 1
    # Even an appliance path must not permit deletion of a network mount.
    fstype="$(findmnt -n -o FSTYPE --target "${DATA_PATH}")" || return 1
    case "${fstype,,}" in
        nfs|nfs4|cifs|smb3) return 1 ;;
    esac
    [[ -z $(jv_reset_nested_mounts "${DATA_PATH}") ]] || return 1
    jv_reset_backup_nested_in_data "${DATA_PATH}" "${BACKUP_PATH}" && return 1
    canonical_backup="$(realpath -e -- "${BACKUP_PATH}")" || return 1
    jv_reset_backup_nested_in_data "${DATA_PATH}" "${canonical_backup}" && return 1
    local directory_identity
    directory_identity="$(stat -c '%d:%i' -- "${DATA_PATH}")" || return 1
    jq -cn --arg path "${DATA_PATH}" --arg directory "${directory_identity}" \
        --arg mount "${mount_identity}" '{path:$path,directory:$directory,mount:$mount}'
}

_a55_cleanup_failed_data() {
    local recorded current
    # Only an empty pre-runtime directory owned by this transaction is eligible.
    recorded="$(jq -c '.runtime.empty_data_identity // null' "${A53_MANIFEST}")" || return 1
    [[ ${recorded} != null ]] || return 0
    current="$(_a55_data_identity)" || {
        echo 'ERROR: failed setup data no longer passes reset storage safety checks.' >&2
        return 1
    }
    [[ ${recorded} == "${current}" ]] || {
        echo 'ERROR: failed setup data identity changed; preserving data.' >&2
        return 1
    }
    jv_reset_remove_minecraft_container || return 1
    jv_reset_delete_internal_data "${DATA_PATH}" "${BACKUP_PATH}"
}

_a55_record_initial_state() {
    local java_open=false bedrock_open=false data_identity=null first_entry
    # A failed enumeration must never be mistaken for an empty directory.
    first_entry="$(find "${DATA_PATH}" -mindepth 1 -maxdepth 1 -print -quit)" || return 1
    if [[ -z ${first_entry} ]]; then
        data_identity="$(_a55_data_identity)" || data_identity=null
    fi
    firewall-cmd --permanent --query-port="${JAVA_PORT}/tcp" >/dev/null 2>&1 && java_open=true
    if [[ ${BEDROCK_ENABLED} == yes ]]; then
        firewall-cmd --permanent --query-port="${BEDROCK_PORT}/udp" >/dev/null 2>&1 && bedrock_open=true
    fi
    _a55_manifest_update ".runtime = {java_firewall_preexisting:${java_open},bedrock_firewall_preexisting:${bedrock_open},minecraft_started:false,timer_activated:false,marker:true,empty_data_identity:${data_identity}}" || return 1
}

_a55_apply_action() {
    _a55_load_values
    install -d -m0700 -o root -g root "$(dirname -- "${A55_SETUP_MARKER}")" || return 1
    printf '%s %s\n' "${A55_OPERATION_ID}" "${A55_PLAN_FINGERPRINT}" > "${A55_SETUP_MARKER}" || return 1
    chmod 0600 "${A55_SETUP_MARKER}" || return 1
    _a55_record_initial_state || return 1

    if jq -e --arg p "${DATA_PATH}" '.directories_created | index($p) != null' "${A53_MANIFEST}" >/dev/null 2>&1; then
        chown "${MINECRAFT_UID}:${MINECRAFT_GID}" "${DATA_PATH}" || return 1
        chmod 0750 "${DATA_PATH}" || return 1
    fi

    write_main_config || return 1
    _a55_evidence_set runtime_config_written yes || return 1
    render_runtime_files || return 1
    _a55_evidence_set runtime_files_rendered yes || return 1

    firewall-cmd --permanent --add-port="${JAVA_PORT}/tcp" >/dev/null || return 1
    _a55_evidence_set java_firewall_rule present || return 1
    if [[ ${BEDROCK_ENABLED} == yes ]]; then
        firewall-cmd --permanent --add-port="${BEDROCK_PORT}/udp" >/dev/null || return 1
        _a55_evidence_set bedrock_firewall_rule present || return 1
    fi
    firewall-cmd --reload >/dev/null || return 1
    _a55_evidence_set firewalld_reload ok || return 1
    _a55_json true true runtime_configured '' "${A55_EVIDENCE}"
}

# First-run setup retains the full slow-start allowance but stops after three
# automatic restarts since this start, rather than waiting out a crash loop.
_a55_wait_for_rcon() {
    local timeout="$1" baseline="$2" elapsed=0 restarts
    while (( elapsed < timeout )); do
        if podman exec minecraft rcon-cli list >/dev/null 2>&1 &&
            systemctl is-active --quiet minecraft.service; then
            return 0
        fi
        restarts="$(systemctl show minecraft.service --property=NRestarts --value)" || return 1
        [[ ${restarts} =~ ^[0-9]+$ ]] || return 1
        # A manual start can reset systemd's historical restart counter.
        if (( restarts < baseline )); then baseline=0; fi
        if (( restarts >= baseline + 3 )); then
            _a55_evidence_set rcon_result crash_loop || return 1
            echo 'ERROR: Minecraft repeatedly restarted during first-run startup.' >&2
            return 1
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    _a55_evidence_set rcon_result timeout || return 1
    return 1
}

_a55_verify_action() {
    _a55_load_values
    local output rc rcon_started rcon_elapsed validation_output image restart_baseline

    image="$(minecraft_image_ref)" || return 1
    output="$(podman pull "${image}" 2>&1)"
    rc=$?
    _a55_evidence_set minecraft_image_pull "$([[ ${rc} -eq 0 ]] && printf ok || printf failed)" || return 1
    _a55_evidence_set_bounded minecraft_image_pull_output "${output}" || return 1
    (( rc == 0 )) || return 1

    restart_baseline="$(systemctl show minecraft.service --property=NRestarts --value)" || return 1
    [[ ${restart_baseline} =~ ^[0-9]+$ ]] || return 1
    output="$(systemctl start minecraft.service 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        _a55_evidence_set systemctl_start_result failed || return 1
        _a55_evidence_set_bounded systemctl_start_output "${output}" || return 1
        return 1
    fi
    _a55_evidence_set systemctl_start_result ok || return 1
    _a55_evidence_set_bounded systemctl_start_output "${output}" || return 1
    _a55_manifest_update '.runtime.minecraft_started = true' || return 1

    rcon_started=${SECONDS}
    if _a55_wait_for_rcon 900 "${restart_baseline}"; then
        rcon_elapsed=$((SECONDS - rcon_started))
        _a55_evidence_set rcon_result ready || return 1
        _a55_evidence_set rcon_wait_seconds "${rcon_elapsed}" || return 1
    else
        rcon_elapsed=$((SECONDS - rcon_started))
        _a55_evidence_set rcon_wait_seconds "${rcon_elapsed}" || return 1
        return 1
    fi

    if [[ ${BEDROCK_ENABLED} == yes ]]; then
        output="$(configure_geyser_floodgate 2>&1)"
        rc=$?
        _a55_evidence_set geyser_floodgate_config "$([[ ${rc} -eq 0 ]] && printf ok || printf failed)" || return 1
        _a55_evidence_set_bounded geyser_floodgate_output "${output}" || return 1
        (( rc == 0 )) || return 1

        output="$(podman exec minecraft rcon-cli 'geyser version' 2>&1)"
        rc=$?
        _a55_evidence_set geyser_version_check "$([[ ${rc} -eq 0 ]] && printf ok || printf failed)" || return 1
        _a55_evidence_set_bounded geyser_version_output "${output}" || return 1
        (( rc == 0 )) || return 1
    fi

    output="$(/usr/libexec/justvoxel/mjust/verify-minecraft-stack "${MINECRAFT_VERSION}" 2>&1)"
    rc=$?
    _a55_evidence_set minecraft_version_check "$([[ ${rc} -eq 0 ]] && printf ok || printf failed)" || return 1
    _a55_evidence_set_bounded minecraft_version_output "${output}" || return 1
    (( rc == 0 )) || return 1

    validation_output="$(/usr/libexec/justvoxel/mjust/validate-backend --first-run 2>&1)"
    rc=$?
    _a55_evidence_set final_validation "$([[ ${rc} -eq 0 ]] && printf passed || printf failed)" || return 1
    _a55_evidence_set_bounded final_validation_output "${validation_output}" || return 1
    (( rc == 0 )) || return 1

    _a55_json true true runtime_verified '' "${A55_EVIDENCE}"
}

_a55_rollback_action() {
    _a55_load_values
    local failure=0 java_pre=false bedrock_pre=false
    java_pre="$(jq -r '.runtime.java_firewall_preexisting // false' "${A53_MANIFEST}")"
    bedrock_pre="$(jq -r '.runtime.bedrock_firewall_preexisting // false' "${A53_MANIFEST}")"

    # A running backup owns the maintenance lock. Never delete its source data.
    exec 9>"${JV_MAINTENANCE_LOCK}" || { _a55_json false false runtime_rollback 'Could not acquire Minecraft maintenance lock.'; return 0; }
    if ! flock -n 9; then
        _a55_json false false runtime_rollback 'A Minecraft maintenance operation is still running; setup data was preserved.'
        return 0
    fi

    systemctl disable --now minecraft-backup.timer >/dev/null 2>&1 || true
    if systemctl is-active --quiet minecraft-backup.timer 2>/dev/null; then failure=1; fi
    systemctl stop minecraft.service >/dev/null 2>&1 || failure=1
    if systemctl is-active --quiet minecraft.service 2>/dev/null; then
        failure=1
    elif (( failure == 0 )); then
        # Do not delete while the service is active or if container removal fails.
        _a55_cleanup_failed_data || failure=1
    fi

    rm -f -- "${JV_QUADLET}" "${JV_MC_ENV}" "${JV_BACKUP_ENV}" "${JV_BACKUP_SERVICE}" "${JV_BACKUP_TIMER}" "${JV_CONFIG}" || failure=1
    systemctl daemon-reload >/dev/null 2>&1 || failure=1

    if [[ ${java_pre} != true ]]; then
        firewall-cmd --permanent --remove-port="${JAVA_PORT}/tcp" >/dev/null 2>&1 || true
        firewall-cmd --permanent --query-port="${JAVA_PORT}/tcp" >/dev/null 2>&1 && failure=1
    fi
    if [[ ${BEDROCK_ENABLED} == yes && ${bedrock_pre} != true ]]; then
        firewall-cmd --permanent --remove-port="${BEDROCK_PORT}/udp" >/dev/null 2>&1 || true
        firewall-cmd --permanent --query-port="${BEDROCK_PORT}/udp" >/dev/null 2>&1 && failure=1
    fi
    firewall-cmd --reload >/dev/null 2>&1 || failure=1

    rm -f -- "${A55_SETUP_MARKER}" || failure=1
    if (( failure != 0 )); then
        _a55_json false false runtime_rollback 'Runtime rollback could not be completed safely.'
    else
        _a55_json true false runtime_rolled_back ''
    fi
}

_a55_commit_action() {
    _a55_load_values
    [[ -f ${JV_CONFIG} && -f ${JV_QUADLET} && -f ${A55_SETUP_MARKER} ]] || { _a55_json false false runtime_commit 'Runtime configuration is incomplete.'; return 0; }
    systemctl is-active --quiet minecraft.service || { _a55_json false false runtime_commit 'Minecraft is not active.'; return 0; }

    # The timer may immediately catch up on a missed run. Keep setup protected
    # by its marker and the existing maintenance lock until commit finishes.
    exec 9>"${JV_MAINTENANCE_LOCK}" || { _a55_json false false runtime_commit 'Could not acquire Minecraft maintenance lock.'; return 0; }
    if ! flock -n 9; then
        _a55_json false false runtime_commit 'Minecraft maintenance is running; setup cannot commit yet.'
        return 0
    fi

    local output rc
    if output="$(activate_backup_timer 2>&1)"; then
        rc=0
    else
        rc=$?
    fi
    _a55_evidence_set backup_timer_activation "$([[ ${rc} -eq 0 ]] && printf ok || printf failed)" || return 1
    _a55_evidence_set_bounded backup_timer_output "${output}" || return 1
    if (( rc != 0 )); then
        _a55_json false false runtime_commit 'Automatic backup timer could not be activated.' "${A55_EVIDENCE}"
        return 0
    fi
    _a55_manifest_update '.runtime.timer_activated = true' || { _a55_json false false runtime_commit 'Could not record backup timer activation.'; return 0; }

    rm -f -- "${A55_SETUP_MARKER}" || { _a55_json false false runtime_commit 'Could not finalize configured state.'; return 0; }
    _a55_json true true runtime_committed '' "${A55_EVIDENCE}"
}

action="${1:-validate}"
if ! _a55_parse_request; then
    _a55_json false false runtime_preflight 'Runtime transaction request is invalid or storage transaction evidence is missing.'
    exit 0
fi

case "${action}" in
    validate)
        if _a55_validate_runtime_inputs; then _a55_json true false runtime_preflight ''; else _a55_json false false runtime_preflight 'Runtime preflight failed or managed runtime files already exist.'; fi
        ;;
    apply)
        if _a55_validate_runtime_inputs && _a55_apply_action; then :; else _a55_json false false runtime_config 'Runtime configuration could not be applied safely.'; fi
        ;;
    verify)
        if _a55_verify_action; then :; else _a55_json false false runtime_verify 'Minecraft runtime verification failed.' "${A55_EVIDENCE}"; fi
        ;;
    rollback)
        _a55_rollback_action
        ;;
    commit)
        _a55_commit_action
        ;;
    *)
        _a55_json false false invalid_action 'Usage: admin-setup-runtime-transaction-json {validate|apply|verify|rollback|commit}'
        ;;
esac
