#!/usr/bin/bash
# Agent-only trusted storage arguments, following the runtime host-mount contract.
set -euo pipefail
[[ $# == 10 && ( $1 == inspect || $1 == remove || $1 == verify || $1 == absent ) ]] || exit 1
action=$1
shift
/usr/libexec/justvoxel/mjust/instance-runtime-prerequisites restore-validate "${@:1:8}"
exec python3 - "$action" "$@" <<'PY'
import json, os, re, shutil, stat, sys

def main():
    action, ident, root, data, mount, uuid, source, uid, gid, evidence = sys.argv[1:]
    if os.geteuid() != 0 or not re.fullmatch(r'jv-[a-z0-9]{6,12}', ident):
        raise ValueError()
    if data != root + '/minecraft-instances/' + ident + '/data':
        raise ValueError()
    # Open every component without following links. Retain the parent fd through
    # removal; container users cannot rename the root-private parent directory.
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    try:
        for component in os.path.dirname(data).split('/')[1:]:
            nxt = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = nxt
        parent = os.fstat(fd)
        if parent.st_uid != 0 or stat.S_IMODE(parent.st_mode) != 0o700:
            raise ValueError()
        try:
            st = os.stat('data', dir_fd=fd, follow_symlinks=False)
        except FileNotFoundError:
            if action in ('remove', 'verify', 'absent') and evidence != '-':
                os.fsync(fd)
                return
            raise
        if action == 'absent':
            raise ValueError()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != int(uid) or st.st_gid != int(gid):
            raise ValueError()
        token = str(st.st_dev) + ':' + str(st.st_ino)
        # Never cross mounts, including same-device bind mounts. Reject any
        # nested mount before erasing bytes; root-private parents pin the target.
        with open('/proc/self/mountinfo') as mounts:
            for line in mounts:
                target = line.split()[4]
                target = re.sub(r'\\([0-7]{3})', lambda m: chr(int(m[1], 8)), target)
                if target == data or target.startswith(data + '/'):
                    raise ValueError()
        for directory, dirs, files in os.walk(data, followlinks=False):
            if os.stat(directory, follow_symlinks=False).st_dev != st.st_dev:
                raise ValueError()
        if action == 'inspect':
            print(json.dumps({'identity': token}))
            return
        if token != evidence or not shutil.rmtree.avoids_symlink_attacks:
            raise ValueError()
        if action == 'verify':
            return
        shutil.rmtree('data', dir_fd=fd)
        os.fsync(fd)
        try:
            os.stat('data', dir_fd=fd, follow_symlinks=False)
        except FileNotFoundError:
            return
        raise ValueError()
    finally:
        os.close(fd)
try:
    main()
except Exception:
    print('Selected server data could not be safely removed. Retry Delete Server.', file=sys.stderr)
    sys.exit(1)
PY
