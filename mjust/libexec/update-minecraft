#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/update-policy.sh
require_root
instance_id=""
if [[ ${1:-} == --instance ]]; then
    [[ $# == 2 && $2 =~ ^jv-[a-z0-9]{6,12}$ ]] || exit 2
    instance_id=$2
elif (( $# != 0 )); then exit 2
fi
if [[ -z ${instance_id} ]]; then
    inventory="$(/usr/libexec/justvoxel/mjust/api-client GET /v1/minecraft/instances/runtime)" || exit 1
    instance_id="$(jq -er '.instances | select(length == 1) | .[0].id | select(test("^jv-[a-z0-9]{6,12}$"))' <<<"${inventory}")" || {
        echo 'ERROR: choose a Minecraft server with --instance jv-....' >&2; exit 1;
    }
fi
source /usr/libexec/justvoxel/mjust/instance-context.sh
jv_load_instance "${instance_id}" || exit 1

image="${JV_INSTANCE_IMAGE_REF}"
latest_mc=''
game_state='moving'

if [[ ${MINECRAFT_VERSION_MODE} == pinned ]]; then
    latest_mc="$(resolve_recommended_server_version || true)"
    game_state="$(jv_game_version_state "${MINECRAFT_VERSION_MODE}" "${MINECRAFT_VERSION}" "${latest_mc}")"
fi

remote_digest="$(jv_remote_platform_digest "$(minecraft_image_ref)" || true)"
if [[ ! ${remote_digest} =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo 'Minecraft update'
    echo '----------------'
    echo 'Update check: Unable to reach or verify the configured container image.'
    echo "Image: ${image}"
    exit 1
fi

local_digest="$(podman image inspect "${image}" --format '{{.Digest}}' 2>/dev/null || true)"
local_id="$(podman image inspect "${image}" --format '{{.Id}}' 2>/dev/null || true)"
running_id=''
was_active=no
if systemctl is-active --quiet "${JV_INSTANCE_UNIT}"; then
    was_active=yes
    running_id="$(podman inspect "${JV_INSTANCE_CONTAINER}" --format '{{.Image}}' 2>/dev/null || true)"
fi

if [[ -z ${local_id} ]]; then
    image_state=image_missing
elif [[ ! ${local_digest} =~ ^sha256:[0-9a-f]{64}$ ]]; then
    image_state=unknown
elif [[ ${remote_digest} != ${local_digest} ]]; then
    image_state=update_available
elif [[ ${was_active} == yes && ${running_id} != ${local_id} ]]; then
    image_state=restart_needed
else
    image_state=current
fi

echo 'Minecraft update'
echo '----------------'
case "${game_state}" in
    current) echo "Game version:      Current - $(server_software_display_name) ${MINECRAFT_VERSION}" ;;
    update_available) echo "Game version:      Update available - ${MINECRAFT_VERSION} -> ${latest_mc}" ;;
    moving) echo 'Game version:      LATEST policy - resolved when Minecraft starts' ;;
    *) echo "Game version:      Check unavailable - keeping ${MINECRAFT_VERSION}" ;;
esac

case "${image_state}" in
    current) echo 'Container image:   Current' ;;
    update_available) echo 'Container image:   Update available' ;;
    image_missing) echo 'Container image:   Download required' ;;
    restart_needed) echo 'Container image:   Current' ;;
    *) echo 'Container image:   Check unavailable' ;;
esac

if [[ ${was_active} != yes ]]; then
    echo 'Running container: Stopped'
elif [[ ${image_state} == restart_needed ]]; then
    echo 'Running container: Restart required to use the selected local image'
elif [[ ${image_state} == current ]]; then
    echo 'Running container: Current image'
else
    echo 'Running container: Running normally; maintenance may select a newer image'
fi

if [[ ${image_state} == current && ${game_state} != update_available ]]; then
    echo
    echo 'No update is needed.'
    exit 0
fi

echo
case "${image_state}" in
    update_available|image_missing) echo 'Container maintenance is available.' ;;
    restart_needed) echo 'A restart is required to use the already-selected local image.' ;;
esac
[[ ${game_state} == update_available ]] && echo 'A newer supported Minecraft version is available.'
echo

echo 'Opening maintenance details and safety checks...'
plan="$(/usr/libexec/justvoxel/mjust/api-client GET "/v1/minecraft/instances/${instance_id}/version/status")" || exit 1
jq -e --arg id "${instance_id}" '.instance_id == $id and .update_available and .stack_state == "updates_available" and (.plan_fingerprint | type == "string")' <<<"${plan}" >/dev/null || { echo 'No verified server update is available.'; exit 1; }
confirm 'Create a cold backup and apply the reviewed Minecraft update?' || { echo 'Update cancelled.'; exit 0; }
players=false
if [[ ${was_active} == yes ]]; then
    player_state="$(/usr/libexec/justvoxel/mjust/api-client GET "/v1/minecraft/instances/${instance_id}/players")" || exit 1
    jq -e --arg id "${instance_id}" '.id == $id and .state == "online"' <<<"${player_state}" >/dev/null || exit 1
    if (( $(jq '.online' <<<"${player_state}") > 0 )); then
        confirm 'Allow the update to interrupt online players with the safe shutdown countdown?' || exit 0
        players=true
    fi
fi
payload="$(jq -cn --arg fingerprint "$(jq -r '.plan_fingerprint' <<<"${plan}")" --argjson players "${players}" '{plan_fingerprint:$fingerprint,confirm_players:$players}')"
result="$(printf '%s' "${payload}" | /usr/libexec/justvoxel/mjust/api-client POST "/v1/minecraft/instances/${instance_id}/version/update" --data)" || exit 1
operation_id="$(jq -er --arg id "${instance_id}" '.operation | select(.instance_id == $id) | .operation_id' <<<"${result}")" || exit 1
while :; do
    result="$(/usr/libexec/justvoxel/mjust/api-client GET "/v1/minecraft/instances/${instance_id}/version/update/current?operation_id=${operation_id}")" || exit 1
    jq -e --arg id "${instance_id}" --arg op "${operation_id}" '.operation.instance_id == $id and .operation.operation_id == $op' <<<"${result}" >/dev/null || exit 1
    jq -r '.operation.status' <<<"${result}"
    case "$(jq -r '.operation.state' <<<"${result}")" in
        succeeded|resolved) exit 0 ;;
        failed|needs_attention) echo 'Server update needs attention. Use Version for this server to verify and keep the current runtime.' >&2; exit 1 ;;
    esac
    sleep 2
 done
