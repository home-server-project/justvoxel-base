#!/usr/bin/bash
set -euo pipefail

readonly state_dir=/var/lib/justvoxel/webui
readonly initialized_marker=${state_dir}/initialized
readonly enabled_marker=${state_dir}/enabled
readonly auth_mode_file=${state_dir}/auth-mode.json
readonly agent=/usr/libexec/justvoxel/management-agent
readonly web_service=justvoxel-webui.service
readonly agent_service=justvoxel-management.service
readonly monitor_service=justvoxel-glances.service
readonly firewall_service=justvoxel-web
readonly port=8099

require_root() {
    if [[ ${EUID} -ne 0 ]]; then
        echo 'ERROR: this operation must run as root.' >&2
        exit 1
    fi
}

current_auth_mode() {
    if [[ -r ${auth_mode_file} ]]; then
        jq -r '.mode // "system"' "${auth_mode_file}"
    else
        printf 'system\n'
    fi
}

firewall_open() {
    firewall-cmd --quiet --permanent --add-service="${firewall_service}"
    firewall-cmd --quiet --permanent --add-service=mdns
    firewall-cmd --quiet --reload
}

firewall_close() {
    firewall-cmd --quiet --permanent --remove-service="${firewall_service}" 2>/dev/null || true
    firewall-cmd --quiet --reload 2>/dev/null || true
}

primary_ipv4() {
    local ipv4
    ipv4="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}' || true)"
    if [[ -z ${ipv4} ]]; then
        ipv4="$(ip -o -4 addr show scope global up 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}' || true)"
    fi
    printf '%s' "${ipv4:-127.0.0.1}"
}

web_healthy() {
    systemctl is-active --quiet "${web_service}" && \
        curl -fsS --max-time 2 "http://127.0.0.1:${port}/healthz" >/dev/null
}

wait_for_web_healthy() {
    local attempt
    for attempt in {1..10}; do
        sleep 0.5
        if web_healthy; then
            return 0
        fi
    done
    return 1
}

enable_web() {
    install -d -m0700 "${state_dir}"
    "${agent}" bootstrap >/dev/null
    systemctl enable --now "${agent_service}" >/dev/null
    if ! systemctl enable --now "${web_service}" >/dev/null; then
        systemctl disable --now "${agent_service}" >/dev/null 2>&1 || true
        firewall_close
        rm -f "${enabled_marker}"
        return 1
    fi
    if ! wait_for_web_healthy; then
        systemctl disable --now "${web_service}" "${agent_service}" >/dev/null 2>&1 || true
        firewall_close
        rm -f "${enabled_marker}"
        echo 'ERROR: WebUI health check failed; listener was not exposed.' >&2
        return 1
    fi
    firewall_open
    touch "${enabled_marker}" "${initialized_marker}"
    chmod 0600 "${enabled_marker}" "${initialized_marker}"
}

disable_web() {
    firewall_close
    systemctl disable --now "${web_service}" "${agent_service}" >/dev/null 2>&1 || true
    rm -f "${enabled_marker}"
}

status_web() {
    local version='Unknown' source='Unknown' api='v1' address='Disabled'
    if [[ -r /usr/lib/justvoxel/webui-release.json ]]; then
        version="$(jq -r '.version // "Unknown"' /usr/lib/justvoxel/webui-release.json)"
        source="$(jq -r '.source_commit // "Unknown"' /usr/lib/justvoxel/webui-release.json)"
        api="$(jq -r '.management_api // "v1"' /usr/lib/justvoxel/webui-release.json)"
    fi
    if [[ -e ${enabled_marker} ]]; then
        if web_healthy; then
            address="http://$(primary_ipv4):${port}"
        else
            address='Enabled - service unavailable'
        fi
    fi
    printf 'JustVoxel Web management\n'
    printf '  Enabled:        %s\n' "$( [[ -e ${enabled_marker} ]] && echo yes || echo no )"
    printf '  Web service:    %s\n' "$(systemctl is-active "${web_service}" 2>/dev/null || true)"
    printf '  Agent service:  %s\n' "$(systemctl is-active "${agent_service}" 2>/dev/null || true)"
    printf '  System monitor: %s\n' "$(systemctl is-active "${monitor_service}" 2>/dev/null || true)"
    printf '  Address:        %s\n' "${address}"
    printf '  WebUI version:  %s\n' "${version}"
    printf '  Source commit:  %s\n' "${source}"
    printf '  Management API: %s\n' "${api}"
    printf '  Authentication: %s\n' "$(current_auth_mode)"
}

bootstrap_first_boot() {
    if [[ -e ${initialized_marker} ]]; then
        exit 0
    fi
    enable_web
}

reset_web_password() {
    local mode password
    mode="$(current_auth_mode)"
    case "${mode}" in
        system)
            echo 'Resetting the JustVoxel system administrator password for voxel.'
            passwd voxel
            systemctl try-restart "${agent_service}" >/dev/null 2>&1 || true
            echo 'Administrator password changed. Existing WebUI sessions were invalidated.'
            ;;
        separate)
            password="$(${agent} password-reset)"
            systemctl try-restart "${agent_service}" >/dev/null 2>&1 || true
            echo 'Separate WebUI administrator password reset.'
            echo '  Username: voxel'
            printf '  Password: %s\n' "${password}"
            ;;
        *)
            echo "ERROR: unsupported authentication mode: ${mode}" >&2
            exit 1
            ;;
    esac
}

require_root
case "${1:-status}" in
    status)
        status_web
        ;;
    enable)
        enable_web
        echo 'Web management enabled.'
        echo "Address: http://$(primary_ipv4):${port}"
        echo 'Administrator: voxel (system account)'
        ;;
    disable)
        disable_web
        echo 'Web management disabled.'
        ;;
    password-reset)
        reset_web_password
        ;;
    bootstrap)
        bootstrap_first_boot
        ;;
    *)
        echo 'Usage: mjust web <status|enable|disable|password-reset>' >&2
        exit 2
        ;;
esac
