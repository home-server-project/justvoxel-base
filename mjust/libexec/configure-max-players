#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/ui.sh
source /usr/libexec/justvoxel/mjust/player-guidance.sh
source /usr/libexec/justvoxel/mjust/configuration-api.sh

if (( EUID != 0 )); then
    echo 'ERROR: this operation must run as root.' >&2
    exit 1
fi

configuration="$(jv_config_get)"
status="$(jv_config_status)"
current="$(jq -r '.minecraft.max_players' <<<"${configuration}")"
java_memory="$(jq -r '.minecraft.java_memory' <<<"${configuration}")"
container_memory="$(jq -r '.minecraft.container_memory' <<<"${configuration}")"
ram_kib="$(jq -r '.extended.system.physical_ram_kib // 0' <<<"${status}")"
[[ ${ram_kib} =~ ^[0-9]+$ ]] || ram_kib=0
ram_gib=$(((ram_kib + 524288) / 1048576))

echo 'Maximum players'
echo
echo "Current limit: ${current}"
echo
echo 'This controls how many players can be connected to the server at the same time.'
echo
print_player_ram_guidance
echo
echo "Physical RAM: ${ram_gib} GiB"
echo "Current Java heap: ${java_memory}"
echo "Current maximum total Minecraft memory: ${container_memory}"
echo

new_max="$(jui_input 'Enter new maximum' "${current}")" || exit 0
if [[ ! ${new_max} =~ ^[1-9][0-9]*$ ]]; then
    echo 'ERROR: maximum players must be a positive integer.' >&2
    exit 1
fi

echo
print_player_ram_notice "${new_max}" "${ram_gib}"
echo

payload="$(jv_config_payload <<<"${configuration}" | jq -c --argjson maximum "${new_max}" '.max_players=$maximum')"
jv_config_apply_payload "${payload}"
