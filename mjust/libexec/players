#!/usr/bin/bash
set -euo pipefail

readonly api_client=/usr/libexec/justvoxel/mjust/api-client

if (( EUID != 0 )); then
    echo 'ERROR: this operation must run as root.' >&2
    exit 1
fi

instance_id=""
if [[ ${1:-} == --instance && $# == 2 ]]; then instance_id=$2
elif (( $# != 0 )); then echo 'Usage: players [--instance jv-...]' >&2; exit 2; fi
source /usr/libexec/justvoxel/mjust/instance-selection.sh
instance_id="$(jv_select_registered_instance "${instance_id}")" || exit 1

set +e
response="$("${api_client}" GET "/v1/minecraft/instances/${instance_id}/players")"
rc=$?
set -e

if (( rc != 0 )); then
    if jq -e 'type == "object" and (.error | type == "string")' <<<"${response}" >/dev/null 2>&1; then
        printf 'ERROR: %s\n' "$(jq -r '.error' <<<"${response}")" >&2
    else
        echo 'ERROR: player information is unavailable from the JustVoxel Management API.' >&2
    fi
    exit 1
fi

if ! jq -e --arg id "${instance_id}" '.id == $id and (.state | type == "string") and (.online | type == "number") and (.maximum | type == "number")' <<<"${response}" >/dev/null; then
    echo 'ERROR: selected player information could not be verified.' >&2; exit 1
fi
state="$(jq -r '.state' <<<"${response}")"
online="$(jq -r '.online' <<<"${response}")"
maximum="$(jq -r '.maximum' <<<"${response}")"

case "${state}" in
    offline)
        echo 'Minecraft is stopped.'
        echo 'Player information is unavailable until the server is running.'
        ;;
    unknown)
        echo 'Players: Unknown'
        jq -r '.error // "Player information is unavailable."' <<<"${response}"
        exit 1
        ;;
    online)
        echo "Players online: ${online} / ${maximum}"
        if (( online == 0 )); then
            echo 'No players are currently online.'
        else
            names="$(jq -r '(.names // []) | join(", ")' <<<"${response}")"
            if [[ -n ${names} ]]; then
                echo "Online: ${names}"
            else
                echo 'Online player names are unavailable.'
            fi
        fi
        ;;
    *)
        echo "ERROR: unsupported player state from JustVoxel Management API: ${state}" >&2
        exit 1
        ;;
esac
