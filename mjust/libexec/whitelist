#!/usr/bin/bash
set -euo pipefail

readonly api_client=/usr/libexec/justvoxel/mjust/api-client

if (( EUID != 0 )); then
    echo 'ERROR: this operation must run as root.' >&2
    exit 1
fi

instance_id=""
if [[ ${1:-} == --instance ]]; then
    [[ $# -ge 2 && $2 =~ ^jv-[a-z0-9]{6,12}$ ]] || exit 2
    instance_id=$2
    shift 2
fi

action="${1:-list}"
name="${2:-}"

api_get() {
    local path="$1" response rc
    set +e
    response="$("${api_client}" GET "${path}")"
    rc=$?
    set -e
    if (( rc != 0 )); then
        if jq -e 'type == "object" and (.error | type == "string")' <<<"${response}" >/dev/null 2>&1; then
            printf 'ERROR: %s\n' "$(jq -r '.error' <<<"${response}")" >&2
        else
            echo 'ERROR: whitelist information is unavailable from the JustVoxel Management API.' >&2
        fi
        return 1
    fi
    printf '%s' "${response}"
}

# Existing terminal menus may omit selection only for one actual registered server.
instances="$(api_get /v1/minecraft/instances/runtime)" || exit 1
jq -e '.instances | type == "array" and all(.[]; .id | test("^jv-[a-z0-9]{6,12}$"))' <<<"${instances}" >/dev/null || exit 1
if [[ -z ${instance_id} ]]; then
    [[ $(jq '.instances | length' <<<"${instances}") == 1 ]] || {
        echo 'ERROR: choose a Minecraft server with --instance jv-...; exactly one server is required for automatic selection.' >&2
        exit 1
    }
    instance_id="$(jq -r '.instances[0].id' <<<"${instances}")"
fi
jq -e --arg id "${instance_id}" 'any(.instances[]; .id == $id)' <<<"${instances}" >/dev/null || exit 1
whitelist_path="/v1/minecraft/instances/${instance_id}/whitelist"

whitelist_list() {
    local response output
    response="$(api_get "${whitelist_path}")" || return 1
    if ! jq -e 'type == "object" and (.output | type == "string")' <<<"${response}" >/dev/null 2>&1; then
        echo 'ERROR: JustVoxel Management API returned invalid whitelist information.' >&2
        return 1
    fi
    output="$(jq -r '.output' <<<"${response}")"
    [[ -n ${output} ]] && printf '%s\n' "${output}"
}

whitelist_change() {
    local platform="$1" verb="$2" player="$3" payload response rc message output
    payload="$(jq -cn --arg platform "${platform}" --arg action "${verb}" --arg name "${player}"         '{platform:$platform,action:$action,name:$name}')"

    set +e
    response="$(printf '%s\n' "${payload}" | "${api_client}" POST "${whitelist_path}" --data)"
    rc=$?
    set -e

    if (( rc != 0 )); then
        if jq -e 'type == "object"' <<<"${response}" >/dev/null 2>&1; then
            message="$(jq -r '.error // empty' <<<"${response}")"
            if [[ -n ${message} ]]; then
                printf 'ERROR: %s\n' "${message}" >&2
                return 1
            fi
        fi
        echo 'ERROR: whitelist change failed through the JustVoxel Management API.' >&2
        return 1
    fi

    if ! jq -e 'type == "object" and (.output | type == "string")' <<<"${response}" >/dev/null 2>&1; then
        echo 'ERROR: JustVoxel Management API returned invalid whitelist change information.' >&2
        return 1
    fi
    output="$(jq -r '.output' <<<"${response}")"
    [[ -n ${output} ]] && printf '%s\n' "${output}"
}

bedrock_enabled() {
    local response
    response="$(api_get "/v1/minecraft/instances/${instance_id}/configuration")" || return 1
    jq -e '.runtime.bedrock_enabled == true' <<<"${response}" >/dev/null 2>&1
}

case "${action}" in
    list)
        (( $# <= 1 )) || { echo 'Usage: whitelist list' >&2; exit 2; }
        whitelist_list
        ;;
    add-java|remove-java)
        (( $# == 2 )) || { echo "Usage: whitelist ${action} <name>" >&2; exit 2; }
        if [[ ${action} == add-java ]]; then verb=add; else verb=remove; fi
        whitelist_change java "${verb}" "${name}"
        ;;
    add-bedrock|remove-bedrock)
        (( $# == 2 )) || { echo "Usage: whitelist ${action} <gamertag-or-floodgate-uuid>" >&2; exit 2; }
        if [[ ${action} == add-bedrock ]]; then verb=add; else verb=remove; fi
        whitelist_change bedrock "${verb}" "${name}"
        ;;
    bedrock-enabled)
        (( $# == 1 )) || { echo 'Usage: whitelist bedrock-enabled' >&2; exit 2; }
        bedrock_enabled
        ;;
    *)
        echo 'Usage: whitelist {list|add-java|remove-java|add-bedrock|remove-bedrock|bedrock-enabled} [name]' >&2
        exit 2
        ;;
esac
