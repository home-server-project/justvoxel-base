#!/usr/bin/bash
set -u

source /usr/libexec/justvoxel/mjust/interrupt-safety.sh

state="$(systemctl is-system-running 2>/dev/null || true)"
if [[ ${state} != stopping ]]; then
    exit 0
fi

# Preserve the legacy path while independent checks share one bounded window.
jv_prepare_minecraft_for_host_shutdown &
legacy_guard=$!
/usr/libexec/justvoxel/mjust/instance-host-shutdown-prepare &
instance_guard=$!
wait "${legacy_guard}" || true
wait "${instance_guard}" || true
exit 0
