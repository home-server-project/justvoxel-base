[Unit]
Description=JustVoxel Minecraft Server
Wants=network-online.target
After=network-online.target
RequiresMountsFor=@@DATA_PATH@@

[Container]
Image=@@MINECRAFT_IMAGE@@
ContainerName=minecraft
PublishPort=@@JAVA_PORT@@:25565/tcp
@@BEDROCK_PUBLISH_PORT@@
Volume=@@DATA_PATH@@:/data:Z
EnvironmentFile=/etc/justvoxel/minecraft.env
Memory=@@CONTAINER_MEMORY@@
StopTimeout=180
LogDriver=journald

[Service]
ExecStartPre=/usr/libexec/justvoxel/mjust/validate-data-mount
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=240

[Install]
WantedBy=multi-user.target
