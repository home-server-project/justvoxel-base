# Runtime copy is administrator-owned; image updates do not overwrite it.
PLUS_DATA_ROOT=@@DATA_ROOT@@
PLUS_TIMEZONE=UTC
PLUS_BIND_ADDRESS=0.0.0.0
PANEL_URL=@@PANEL_URL@@
PANEL_HTTP_PORT=8081
PANEL_HTTPS_PORT=8443
WINGS_API_PORT=8080
WINGS_SFTP_PORT=2022
DRYDOCK_PORT=3000
DOCKER_GID=@@DOCKER_GID@@
COMPOSE_PROFILES=@@PROFILES@@
MARIADB_IMAGE=mariadb:11.4
REDIS_IMAGE=redis:7.4-alpine
PANEL_IMAGE=ghcr.io/pterodactyl/panel:v1.15.1
WINGS_IMAGE=ghcr.io/pterodactyl/wings:v1.13.3
DRYDOCK_IMAGE=ghcr.io/codeswhat/drydock:1.6.1
PLUS_HOST=@@PLUS_HOST@@
PANEL_HTTP_BIND_ADDRESS=@@PANEL_HTTP_BIND_ADDRESS@@
